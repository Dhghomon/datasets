INSERT INTO post {"id": post:["curiosity", 89], "thread": thread:curiosity, "n": 89, "author": member:pintofmild, "at": d"2012-08-06T06:32:00.000Z", "body": "Too right, time to let the boffins check their harness before we expect any proper Martian fireworks! cheers :)", "quote": NONE, "note": "Punchcard's horse and harness comparison was bang on, we'll see if the science kit actually works before getting overexcited.", "state": {"position":"The landing was an absolute marvel and well worth getting up for, but the hard graft of checking all the instruments starts now.","score":3,"certainty":"medium","towards":[{"member":"Sysop_Kev","feeling":"pleased he agrees the celebratory pint is well deserved"},{"member":"Punchcard","feeling":"admires his wise old head and patience with engineering checks"},{"member":"OffByOne","feeling":"acknowledges his sensible Dutch proverb about not celebrating too early"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday"],"shift":"He is enjoying the camaraderie and agrees with the forum consensus that patient system checks must come before celebrating any science results."}, "recalled": [{"kind": "fact", "text": "Nuclear Regulatory Commission: \"Safety systems were declared ready earlier in the year\""}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "forum", "at": d"2012-08-03T19:12:00.000Z", "from": post:["curiosity", 25]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "forum", "at": d"2012-08-05T20:59:00.000Z", "from": post:["curiosity", 56]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "private", "at": d"2012-08-06T05:48:00.000Z", "from": post:["curiosity", 80]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}]};
INSERT INTO post {"id": post:["curiosity", 90], "thread": thread:curiosity, "n": 90, "author": member:kookaburra99, "at": d"2012-08-06T06:39:00.000Z", "body": "Heading out the door now, but seeing that sharper 256-pixel rear cam shot come through on my phone just before leaving was the cherry on top. Still, as Sysop_Kev says, the proper work starts with those instrument self-tests over the next few sols. Cheers everyone, have a great evening and sleep well!", "quote": {"post": post:["curiosity", 88], "text": "Punchcard and quasistatic have the right of it though - until the instruments pass their self-tests and power up properly, the real work has barely started."}, "note": "Curiosity will only be an authentic triumph once the instruments survive their initial diagnostic self-tests.", "state": {"position":"The touchdown was an amazing feat of engineering, but whether the mission truly succeeds depends on the slow, methodical diagnostic checks of the science kit over the coming days.","score":3,"certainty":"high","towards":[{"member":"Punchcard","feeling":"deeply appreciates his harness analogy and steady wisdom"},{"member":"OffByOne","feeling":"values his precise, sensible perspective on instrument diagnostics"},{"member":"quasistatic","feeling":"admires his clear explanations of the software and engineering work ahead"}],"commitments":["grab a celebratory drink after work"],"shift":"She has embraced the group's focus on patient harness-checking and instrument diagnostics now that school has ended."}, "recalled": [{"kind": "fact", "text": "Mars Reconnaissance Orbiter's relay window frequency is two brief windows per day to relay telemetry back to Earth"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "fact", "at": d"2012-08-03T19:14:00.000Z", "text": "I shall certainly have my kettle on well before half past five to follow the telemetry feed. One can appreciate the enormous ambition of the engineering trial while still recognising that safe touc..."}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "fact", "at": d"2012-08-05T13:21:00.000Z", "text": "Breaking it down into clean bullet points does not make the danger any less real, folks... Writing off the risk as mere routine procedure sounds fine in a textbook, but out there you have a thousan..."}, {"kind": "fact", "at": d"2012-08-06T04:56:00.000Z", "text": "Now we are only minutes away from the top of the Martian atmosphere. Direct line of sight to Earth will drop away shortly, and everything hinges on Odyssey picking up the automated descent tones. P..."}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}]};
INSERT INTO post {"id": post:["curiosity", 91], "thread": thread:curiosity, "n": 91, "author": member:sysop_kev, "at": d"2012-08-06T06:43:00.000Z", "body": "Off to work here now. We will see what the logs look like this evening.", "quote": NONE, "note": "I still need to catch up with PintOfMild for that celebratory pint.", "state": {"position":"Curiosity pulled off an incredible landing and the stream held up fine, making it well worth the money, though the real scientific value depends on the upcoming instrument diagnostics.","score":3,"certainty":"high","towards":[{"member":"PintOfMild","feeling":"agrees that the celebratory pint was well earned"},{"member":"Punchcard","feeling":"respects his sound reminder that thorough diagnostics come before real work"},{"member":"quasistatic","feeling":"appreciates his sensible engineering outlook on waiting for instrument tests"}],"commitments":["have a celebratory pint with PintOfMild"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's role is moderator"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T17:02:00.000Z", "from": post:["curiosity", 52]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 74]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "fact", "at": d"2012-08-06T06:14:00.000Z", "text": "It is so easy to get caught up in the huge adrenaline rush of the touchdown and forget that this massive 900 kg contraption is essentially an automated chemistry department sitting in freezing cond..."}, {"kind": "news", "at": d"2012-08-06T06:20:53.000Z", "from": news:⟨curiosity-035⟩}]};
INSERT INTO post {"id": post:["curiosity", 92], "thread": thread:curiosity, "n": 92, "author": member:quasistatic, "at": d"2012-08-06T06:55:00.000Z", "body": "Safe travels, everyone. Now we wait on the telemetry logs to see if the investment truly pays off.", "quote": NONE, "note": "The real evaluation begins once the first spectrometer telemetry comes through.", "state": {"position":"The successful touchdown is a monumental engineering feat, but whether the mission truly justifies its cost depends entirely on the upcoming diagnostic checks and instrument performance.","score":3,"certainty":"high","towards":[{"member":"Punchcard","feeling":"admires his seasoned perspective on methodical systems checking"},{"member":"OffByOne","feeling":"values his shared appreciation for technical precision"},{"member":"kookaburra99","feeling":"pleased they grasp the need for patient diagnostic verification"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev: \"Heading into the data centre shortly for my shift.\""}, {"kind": "fact", "text": "Punchcard's opinion is celebratory speeches are fine, but diagnostics tell the tale"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-29T23:35:00.000Z", "from": post:["y2k", 46]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "fact", "at": d"1999-12-31T15:37:00.000Z", "text": "Looking at network ping times from Dublin or watching city streetlamps stay on doesn't tell us how the main water treatment valves or substation relays hold up over the next twenty-four hours. A lo..."}, {"kind": "fact", "at": d"1999-12-31T15:56:00.000Z", "text": "The Boston hospital incident demonstrates precisely why audits are conducted; oversight worked as intended, and missing an administrative patch on a server is not an uncontrollable physical failure..."}, {"kind": "fact", "at": d"2000-01-01T01:26:00.000Z", "text": "Boston Children's Hospital was finding missing patches on critical cardiac servers just this past week, so anyone acting like every loose end was neatly tied up months ago is ignoring reality. When..."}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "private", "at": d"2012-08-03T06:51:00.000Z", "from": post:["curiosity", 20]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}]};
INSERT INTO post {"id": post:["curiosity", 93], "thread": thread:curiosity, "n": 93, "author": member:sysop_kev, "at": d"2012-08-06T06:57:00.000Z", "body": "Dead right. If the hardware checks out clean, it is money well spent.", "quote": {"post": post:["curiosity", 92], "text": "Now we wait on the telemetry logs to see if the investment truly pays off."}, "note": "Curiosity's hardware still has to prove itself before calling the mission a financial success.", "state": {"position":"The landing was a genuine achievement and well worth following, but whether the mission fully justifies the price tag depends on what the diagnostic logs and instrument tests show over the coming days.","score":3,"certainty":"high","towards":[{"member":"PintOfMild","feeling":"readily agrees that the pint is well earned"},{"member":"Punchcard","feeling":"respects his pragmatic insistence on thorough baseline testing"},{"member":"quasistatic","feeling":"appreciates his level-headed focus on waiting for telemetry logs"}],"commitments":["have a celebratory pint with PintOfMild","check the diagnostic logs in the evening"],"shift":"Heading off to work satisfied with the landing, now waiting to review the telemetry logs later in the day."}, "recalled": [{"kind": "fact", "text": "TheyKnow's feeling is hoping for good telemetry"}, {"kind": "fact", "text": "eastern hemisphere's status is telemetry is rock solid"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "fact", "at": d"1999-12-30T21:58:00.000Z", "text": "Establishing command centres functions identically. Having staff present merely ensures rapid logging and prompt administrative reporting if minor anomalies occur, exactly as Punchcard noted. We sh..."}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T17:02:00.000Z", "from": post:["curiosity", 52]}, {"kind": "fact", "at": d"2012-08-06T05:30:00.000Z", "text": "All of this has already occurred fourteen minutes ago in reality, so we are merely watching historical data confirm whether the onboard guidance executed autonomously without a fault. It is fascina..."}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 74]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}]};
INSERT INTO post {"id": post:["curiosity", 94], "thread": thread:curiosity, "n": 94, "author": member:quasistatic, "at": d"2012-08-06T07:37:00.000Z", "body": "Quite. Landing a mobile platform intact is a remarkable feat of control engineering, but it is only the delivery mechanism. The real return on that budget depends on the spectrometer baselines and thermal health logs over the coming sols. Time for me to start the working day as well.", "quote": NONE, "note": "Sysop_Kev grasps that the hardware diagnostics will decide whether the mission's budget was justified.", "state": {"position":"Curiosity's touchdown is an extraordinary engineering success, but the true value of the expenditure hinges entirely on the forthcoming telemetry and instrument diagnostics.","score":3,"certainty":"high","towards":[{"member":"Punchcard","feeling":"admires his seasoned, methodical perspective on post-landing diagnostics"},{"member":"OffByOne","feeling":"values his rigorous technical pedantry"},{"member":"kookaburra99","feeling":"pleased they appreciate the slow, patient verification required"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"Now we wait on the telemetry logs to see if the investment truly pays off.\""}, {"kind": "fact", "text": "Quasistatic's opinion critique is believes TheyKnow treats harmless institutional folklore as evidence of technical weakness"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-29T23:35:00.000Z", "from": post:["y2k", 46]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "fact", "at": d"1999-12-30T16:29:00.000Z", "text": "They aren't betting millions of dollars just on hypothetical glitches, folks... If a few card readers in Britain are already throwing fits before midnight even arrives, imagine what happens when th..."}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"2000-01-01T01:26:00.000Z", "text": "Boston Children's Hospital was finding missing patches on critical cardiac servers just this past week, so anyone acting like every loose end was neatly tied up months ago is ignoring reality. When..."}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "private", "at": d"2012-08-03T06:51:00.000Z", "from": post:["curiosity", 20]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}]};
INSERT INTO post {"id": post:["curiosity", 95], "thread": thread:curiosity, "n": 95, "author": member:sysop_kev, "at": d"2012-08-06T07:38:00.000Z", "body": "Grand job all round for the morning anyway. Time to get some actual work done on this side of the world. Catch you lads later on for a look at the status updates.", "quote": NONE, "note": "I will check the rover's diagnostic readouts when I get home this evening.", "state": {"position":"The landing was brilliant, but whether the two and a half billion was money well spent comes down to what the instrument and hardware diagnostics show.","score":3,"certainty":"high","towards":[{"member":"quasistatic","feeling":"completely agrees with his focus on the diagnostic logs and instrument return"},{"member":"PintOfMild","feeling":"readily agrees that the pint is well earned"},{"member":"Punchcard","feeling":"respects his pragmatic insistence on thorough baseline testing"}],"commitments":["have a celebratory pint with PintOfMild","check the diagnostic logs in the evening"]}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "fact", "text": "Sysop_Kev's role is moderator"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "forum", "at": d"2012-08-03T06:51:00.000Z", "from": post:["curiosity", 20]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 74]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T06:57:00.000Z", "from": post:["curiosity", 93]}]};
INSERT INTO post {"id": post:["curiosity", 96], "thread": thread:curiosity, "n": 96, "author": member:pintofmild, "at": d"2012-08-06T08:41:00.000Z", "body": "Just settled in at my desk myself with another brew, though my head is still half on Mars! Even with Obama giving them a big shout out on the news, it really does come down to whether those posh gadgets survive the cold and switch on without blowing a fuse. You wouldn't buy a brand new telly for two billion quid and just admire the cardboard box, would you? We need to see that laser zap a few pebbles first before we know if taxpayers got their money's worth. Still, cannot complain about a Monday morning starting with rockets instead of mortgage spreadsheets. If the boffins manage to wake up all ten gadgets without a hitch, it will be well worth every single penny. I will be checking back in on my tea break to see what the numbers look like. Don't work too hard everyone, and remember the first pint is on me at the Head of Steam on Friday if any of you fancy a trek to Yorkshire! cheers :D", "quote": NONE, "note": "Curiosity pulled off the landing, but we will have to wait for the telemetry logs this week to know if all that cash was really well spent.", "state": {"position":"The landing was fantastic and well worth the watch, but now we have to wait and see if the instruments check out cleanly before knowing if it is money well spent.","score":3,"certainty":"medium","towards":[{"member":"Sysop_Kev","feeling":"enjoys his company and agrees it is time to check the logs later"},{"member":"Punchcard","feeling":"appreciates his sensible analogy about checking the harness"},{"member":"kookaburra99","feeling":"pleased he enjoyed sharing the landing vigil with the forum"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday"]}, "recalled": [{"kind": "fact", "text": "controllers's schedule is synchronised entirely to Martian solar days"}, {"kind": "fact", "text": "quasistatic: \"I shall certainly have my kettle on well before half past five to follow the telemetry feed.\""}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "at": d"1999-12-31T09:09:00.000Z", "text": "I have to head into the office later on for the dreaded evening shift, but I will definitely be popping back in here during my tea breaks to see how kookaburra99 and the Aussies are getting on. Kee..."}, {"kind": "forum", "at": d"1999-12-31T14:18:00.000Z", "from": post:["y2k", 92]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "news", "at": d"2012-08-03T14:57:32.000Z", "from": news:⟨curiosity-019⟩}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "forum", "at": d"2012-08-05T20:59:00.000Z", "from": post:["curiosity", 56]}, {"kind": "private", "at": d"2012-08-06T05:48:00.000Z", "from": post:["curiosity", 80]}]};
INSERT INTO post {"id": post:["curiosity", 97], "thread": thread:curiosity, "n": 97, "author": member:kookaburra99, "at": d"2012-08-06T08:52:00.000Z", "body": "Checking in from the pub! Absolutely, PintOfMild, the engineering triumph got it to the surface, but the science payload is what actually justifies the price tag. If those diagnostics come back clean over the next few sols, it will be worth every cent. Have a good shift, everyone!", "quote": NONE, "note": "PintOfMild put it perfectly about needing to see the gear actually work before calling the mission a full success.", "state": {"position":"Curiosity was worth the investment for the incredible engineering and science, but whether the mission truly delivers on its promise depends on the instruments passing all their diagnostic tests over the coming sols.","score":3,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"agrees strongly with his sensible point about instrument self-tests"},{"member":"quasistatic","feeling":"respects his clear view on control engineering and telemetry checks"},{"member":"Punchcard","feeling":"deeply appreciates his steady wisdom and harness analogy"}],"commitments":[],"shift":"She has signed off to enjoy her celebratory drink, completely aligned with the consensus that the real work lies in the upcoming instrument diagnostics."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "fact", "at": d"2012-08-03T19:14:00.000Z", "text": "I shall certainly have my kettle on well before half past five to follow the telemetry feed. One can appreciate the enormous ambition of the engineering trial while still recognising that safe touc..."}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-04T21:49:00.000Z", "from": post:["curiosity", 39]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T08:41:00.000Z", "text": "Just settled in at my desk myself with another brew, though my head is still half on Mars! Even with Obama giving them a big shout out on the news, it really does come down to whether those posh ga..."}]};
INSERT INTO post {"id": post:["curiosity", 98], "thread": thread:curiosity, "n": 98, "author": member:quasistatic, "at": d"2012-08-06T09:02:00.000Z", "body": "The cardboard box analogy is entirely fair, PintOfMild. To keep expectations realistic, two things need noting: first, ChemCam's laser requires mast deployment before any rock zapping happens, and second, SAM's ovens will take longer still. The White House rhetoric is pleasant enough, but the technical checkout will simply take patience. Back to my marking.", "quote": NONE, "note": "PintOfMild grasped the payload distinction well, even if his Yorkshire pub plans are running far ahead of Curiosity's commissioning schedule.", "state": {"position":"Curiosity's touchdown is an extraordinary engineering success, but the scientific and financial justification depends on whether the analytical instruments and spectrometers have survived and function properly.","score":3,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"pleased he recognises that the real work begins with instrument diagnostics"},{"member":"PintOfMild","feeling":"amused by his colourful analogies but agrees on waiting for payload checks"},{"member":"kookaburra99","feeling":"appreciates their shared emphasis on the upcoming instrument telemetry"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "fact", "text": "Quasistatic's opinion critique is believes TheyKnow treats harmless institutional folklore as evidence of technical weakness"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-29T23:35:00.000Z", "from": post:["y2k", 46]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "fact", "at": d"2012-08-06T08:41:00.000Z", "text": "Just settled in at my desk myself with another brew, though my head is still half on Mars! Even with Obama giving them a big shout out on the news, it really does come down to whether those posh ga..."}]};
INSERT INTO post {"id": post:["curiosity", 99], "thread": thread:curiosity, "n": 99, "author": member:pintofmild, "at": d"2012-08-06T09:28:00.000Z", "body": "Patience it is then, mate! I will keep an eye out for the mast news later.", "quote": {"post": post:["curiosity", 98], "text": "The White House rhetoric is pleasant enough, but the technical checkout will simply take patience."}, "note": "quasistatic is right that we'll have to wait days before that laser even gets a chance to fire.", "state": {"position":"The landing was brilliant, but we need to see the scientific instruments check out clean and start doing real work before we can say the billions were well spent.","score":3,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"pleased he appreciated the cardboard box analogy and respects his realistic technical expectations"},{"member":"kookaburra99","feeling":"enjoys his company and friendly pub banter"},{"member":"Sysop_Kev","feeling":"shares his view on checking the logs later"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","check back in on his tea break to see how the numbers look"]}, "recalled": [{"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"1999-12-31T09:09:00.000Z", "from": post:["y2k", 79]}, {"kind": "private", "at": d"1999-12-31T22:58:00.000Z", "from": post:["y2k", 117]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T05:48:00.000Z", "from": post:["curiosity", 80]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "fact", "at": d"2012-08-06T06:14:00.000Z", "text": "It is so easy to get caught up in the huge adrenaline rush of the touchdown and forget that this massive 900 kg contraption is essentially an automated chemistry department sitting in freezing cond..."}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}]};
INSERT INTO post {"id": post:["curiosity", 100], "thread": thread:curiosity, "n": 100, "author": member:offbyone, "at": d"2012-08-06T10:25:00.000Z", "body": "Pete Theisinger stated clearly in the post-landing press conference that the team is in no hurry to commence surface operations, which is entirely correct. A delivery vehicle remains secondary to the actual analytical payload. Speeches and comparisons to cinema tickets do not alter the fundamental criteria, which remain strictly empirical. Until the engineering staff step through the diagnostic schedules and confirm stable telemetry from the onboard hardware, any declaration regarding financial value is entirely premature. We must evaluate the operational logs as they are formally published.", "quote": NONE, "note": "I will wait for the published engineering logs rather than accepting post-landing press statements as proof of mission success.", "state": {"position":"A successful landing is merely the delivery mechanism, and the mission's financial justification remains strictly undecided until instrument diagnostics and telemetry verify scientific capability over the coming sols.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"strongly agrees with his grounded focus on instrument diagnostics over rhetoric"},{"member":"PintOfMild","feeling":"notes his sensible concession on waiting for instrument health despite his casual tone"},{"member":"Punchcard","feeling":"respects his disciplined perspective on awaiting verification"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev: \"running a routine database backup around 2:00 am tonight, so expect a few minutes of downtime if you're still awake.\""}, {"kind": "fact", "text": "OffByOne's opinion is quasistatic and Punchcard understand the necessary discipline of waiting for instrument telemetry, while the rest are already celebrating a simple thumbnail"}, {"kind": "fact", "text": "OffByOne's expectation is expects tomorrow's formal session will confirm what mathematical evidence has demanded all along"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "fact", "at": d"1999-12-28T07:14:00.000Z", "text": "Similarly, commercial dispatch operations do not depend solely on standard consumer voice lines to coordinate regional movements. Private radio networks, telex, dedicated carrier lines, and basic r..."}, {"kind": "fact", "at": d"1999-12-30T21:58:00.000Z", "text": "Establishing command centres functions identically. Having staff present merely ensures rapid logging and prompt administrative reporting if minor anomalies occur, exactly as Punchcard noted. We sh..."}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-18T13:35:00.000Z", "from": post:["pluto", 47]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "forum", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 73]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}]};
INSERT INTO post {"id": post:["curiosity", 101], "thread": thread:curiosity, "n": 101, "author": member:kookaburra99, "at": d"2012-08-06T10:31:00.000Z", "body": "spot on, OffByOne. landing safely is massive engineering, but we can't properly call the billions justified until the payload checks out completely green on those telemetry logs. patience is definitely the name of the game now. watching the conference updates between pints, keen to see how the checkout goes tomorrow!", "quote": {"post": post:["curiosity", 100], "text": "Until the engineering staff step through the diagnostic schedules and confirm stable telemetry from the onboard hardware, any declaration regarding financial value is entirely premature."}, "note": "OffByOne is completely right that we need hard diagnostic proof from the instruments before declaring the mission money well spent.", "state": {"position":"The landing was an incredible engineering achievement, but the mission will only be truly worth the money once the scientific payload passes all its diagnostic checks.","score":3,"certainty":"high","towards":[{"member":"PintOfMild","feeling":"enjoys his warm pub banter and apt cardboard box analogy"},{"member":"quasistatic","feeling":"appreciates his precise, clear technical breakdowns"},{"member":"Sysop_Kev","feeling":"agrees with his practical wait-and-see view on hardware logs"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "fact", "text": "Curiosity's first pictures arrival delay is more than two hours"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}]};
INSERT INTO post {"id": post:["curiosity", 102], "thread": thread:curiosity, "n": 102, "author": member:quasistatic, "at": d"2012-08-06T11:29:00.000Z", "body": "Precisely. Theisinger's caution is thoroughly sensible. To keep our focus tidy while the team works through those checklists, we are essentially waiting on two distinct milestones: first, the mast deployment and system telemetry over the coming days, and only then the slow calibration of the wet chemistry lab. The engineering logs will tell us everything.", "quote": NONE, "note": "OffByOne is entirely right to ignore Grotzinger's cinema ticket rhetoric and keep his eyes strictly on the instrument diagnostic logs.", "state": {"position":"Curiosity's successful landing is a remarkable achievement, but justifying the mission's cost depends entirely on the upcoming telemetry confirming the scientific instruments survived intact.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his rigorous, empirical discipline"},{"member":"PintOfMild","feeling":"appreciates his apt analogy while urging realistic timelines"},{"member":"Sysop_Kev","feeling":"pleased they agree that instrument telemetry is the true test"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Quasistatic's opinion critique is believes TheyKnow treats harmless institutional folklore as evidence of technical weakness"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-29T23:35:00.000Z", "from": post:["y2k", 46]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-06T05:30:00.000Z", "text": "All of this has already occurred fourteen minutes ago in reality, so we are merely watching historical data confirm whether the onboard guidance executed autonomously without a fault. It is fascina..."}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}]};
INSERT INTO post {"id": post:["curiosity", 103], "thread": thread:curiosity, "n": 103, "author": member:sysop_kev, "at": d"2012-08-06T11:54:00.000Z", "body": "Quick look during lunch. Pete Theisinger is dead right to take it slow. You don't rush post-install checks on gear that far out of reach. We'll know what sort of value we got once the raw diagnostics roll in.", "quote": {"post": post:["curiosity", 100], "text": "Pete Theisinger stated clearly in the post-landing press conference that the team is in no hurry to commence surface operations, which is entirely correct."}, "note": "Checking back in this evening once the first real checkout logs are posted.", "state": {"position":"Getting it safely onto Mars was brilliant, but whether the money was well spent hinges on whether the hardware and scientific payload check out clean in the diagnostic logs.","score":3,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his sensible, grounded focus on diagnostic logs over hype"},{"member":"PintOfMild","feeling":"fond of his good cheer and telly analogy"},{"member":"OffByOne","feeling":"agrees with his pragmatic insistence on waiting for empirical telemetry"}],"commitments":["have a celebratory pint with PintOfMild","check the diagnostic status updates later after work"]}, "recalled": [{"kind": "fact", "text": "Curiosity's status is real work has barely started until instruments pass self-tests and power up properly"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "forum", "at": d"2012-08-03T06:51:00.000Z", "from": post:["curiosity", 20]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T17:02:00.000Z", "from": post:["curiosity", 52]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 74]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T06:01:00.000Z", "from": post:["curiosity", 85]}, {"kind": "private", "at": d"2012-08-06T06:57:00.000Z", "from": post:["curiosity", 93]}]};
INSERT INTO post {"id": post:["curiosity", 104], "thread": thread:curiosity, "n": 104, "author": member:offbyone, "at": d"2012-08-06T11:59:00.000Z", "body": "Strictly speaking, the initial diagnostics depend on the Mars Odyssey relay passes rather than direct communication, as the rover relies on UHF transmissions until the primary systems are verified. A methodical approach is sensible. Once those telecommunication sessions yield the raw sensor data, we can impartially assess whether the instrument package survived intact.", "quote": NONE, "note": "I will inspect the telemetry pass figures rather than rely on informal summaries from the team.", "state": {"position":"Whether the mission justifies its cost remains strictly undecided until the formal engineering logs and diagnostic telemetry confirm the science payload is operational.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his structured, methodical approach to the checkout milestones"},{"member":"kookaburra99","feeling":"pleased that he conceded the point about waiting for diagnostic telemetry"},{"member":"Sysop_Kev","feeling":"approves of his practical systems-engineering view on post-install checks"}],"commitments":["wait for the published engineering logs rather than accepting press statements"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is declarations regarding financial value are premature until stable telemetry and diagnostic schedules are confirmed"}, {"kind": "fact", "text": "OffByOne's expectation is expects tomorrow's formal session will confirm what mathematical evidence has demanded all along"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "fact", "at": d"1999-12-30T21:58:00.000Z", "text": "Establishing command centres functions identically. Having staff present merely ensures rapid logging and prompt administrative reporting if minor anomalies occur, exactly as Punchcard noted. We sh..."}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-18T13:35:00.000Z", "from": post:["pluto", 47]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T05:49:00.000Z", "from": post:["curiosity", 81]}, {"kind": "forum", "at": d"2012-08-06T06:01:00.000Z", "from": post:["curiosity", 85]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}]};
INSERT INTO post {"id": post:["curiosity", 105], "thread": thread:curiosity, "n": 105, "author": member:punchcard, "at": d"2012-08-06T14:09:00.000Z", "body": "Good morning, all. I see the sun has come up and cooler heads are prevailing, which is always reassuring to find.\n\nThe project manager is taking the sensible path. Having the rover resting upright in the dirt is half the battle, but one does not declare victory until the field instruments prove they can actually do the job they were sent to do.\n\nA few clear pictures of pebbles on the plain will keep the public satisfied for a day or two, but the real measure will be those slow diagnostic passes over the coming sols. Steady as she goes.\n\nWalter", "quote": {"post": post:["curiosity", 104], "text": "Once those telecommunication sessions yield the raw sensor data, we can impartially assess whether the instrument package survived intact."}, "note": "OffByOne and quasistatic remain the sensible voices on this board, keeping their eyes firmly on the telemetry.", "state": {"position":"Curiosity's safe arrival is an extraordinary achievement, but its scientific worth will only be established as the instrument payload is slowly and methodically checked out in the sols ahead.","score":4,"certainty":"high","towards":[{"member":"OffByOne","feeling":"strongly agrees with his emphasis on waiting for methodical telemetry rather than rushing to judgment"},{"member":"quasistatic","feeling":"appreciates his disciplined engineering mindset and focus on technical checklists"},{"member":"PintOfMild","feeling":"finds his down-to-earth cardboard box analogy apt and cheerful"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Curiosity's status is real work has barely started until instruments pass self-tests and power up properly"}, {"kind": "fact", "text": "Punchcard's opinion is believes OffByOne and quasistatic are right to focus on instrument calibration logs rather than the fanfare"}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "forum", "at": d"2012-08-04T08:37:00.000Z", "from": post:["curiosity", 32]}, {"kind": "forum", "at": d"2012-08-04T17:55:00.000Z", "from": post:["curiosity", 35]}, {"kind": "forum", "at": d"2012-08-04T19:35:00.000Z", "from": post:["curiosity", 37]}, {"kind": "forum", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2012-08-06T03:24:00.000Z", "from": post:["curiosity", 62]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T06:04:00.000Z", "from": post:["curiosity", 86]}]};
INSERT INTO post {"id": post:["curiosity", 106], "thread": thread:curiosity, "n": 106, "author": member:pintofmild, "at": d"2012-08-06T14:28:00.000Z", "body": "Couldn't agree more, Walter! Easy does it. Seeing the gravel and that crater rim on the news earlier was a cracking sight, but no point rushing into top gear until all the diagnostic logs come back clean. Fingers crossed those checks go swimmingly. Time to pop the kettle on again! cheers :)", "quote": {"post": post:["curiosity", 105], "text": "The project manager is taking the sensible path. Having the rover resting upright in the dirt is half the battle, but one does not declare victory until the field instruments prove they can actually do the job they were sent to do."}, "note": "Walter has the right idea about taking things steady until the engineering checks prove the gear is working.", "state": {"position":"The landing was fantastic, but everyone is right that we have to wait patiently for the diagnostic checks before knowing if all that money was truly worth it.","score":3,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"appreciates his level-headed reminders about patience and the mast deployment"},{"member":"kookaburra99","feeling":"enjoys his company and shared pub enthusiasm"},{"member":"Punchcard","feeling":"reassured by his steady, common-sense take on taking things slowly"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","keep an eye out for news about the mast deployment"],"shift":"Has settled comfortably into the shared mood on the board that everyone needs to be patient while the diagnostic logs roll in."}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "private", "at": d"2012-08-06T05:48:00.000Z", "from": post:["curiosity", 80]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}]};
INSERT INTO post {"id": post:["curiosity", 107], "thread": thread:curiosity, "n": 107, "author": member:quasistatic, "at": d"2012-08-06T15:28:00.000Z", "body": "The broader view of the crater rim and the gravel field is certainly pleasing, PintOfMild, but Walter and OffByOne have it right. \n\nTo keep our thinking clear, we must separate the visual confirmations from the engineering reality. A crisp photograph of pebbles tells us only that the optics survived the descent stage; it tells us nothing about the health of the internal sensors or sample handling mechanisms. Declaring the expenditure justified before those subsequent telemetry passes are complete would be entirely premature. \n\nWe await the hard diagnostic logs, nothing less.", "quote": NONE, "note": "Punchcard and OffByOne are keeping the thread grounded in solid empirical sense.", "state": {"position":"The mission is an incredible engineering feat, but declaring it worth the expenditure requires waiting for the technical checkout and instrument telemetry over the coming sols.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"strongly respects his empirical, methodical focus"},{"member":"Punchcard","feeling":"welcomes his measured, level-headed perspective"},{"member":"Sysop_Kev","feeling":"pleased they share a pragmatic engineering viewpoint"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-29T23:35:00.000Z", "from": post:["y2k", 46]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-02T07:16:00.000Z", "from": post:["y2k", 164]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "forum", "at": d"2012-08-06T07:37:00.000Z", "from": post:["curiosity", 94]}]};
INSERT INTO post {"id": post:["curiosity", 108], "thread": thread:curiosity, "n": 108, "author": member:theyknow, "at": d"2012-08-06T15:46:00.000Z", "body": "That is the heart of it, folks... A couple of fuzzy snapshots of gravel are great for the evening news, but that's what they WANT you to look at while the real questions hang in the air. Having a chassis sitting in one piece on the dirt doesn't mean a thing if the sensitive gear inside took a beating on the way down. \n\nTwo and a half billion dollars is a mountain of cash, and comparing it to movie tickets doesn't change that. We will see what the Odyssey passes actually bring back once the engineers start prodding those internal packages... Until the hard numbers prove the laboratory works, the jury is definitely still out.", "quote": NONE, "note": "They are finally admitting that landing an empty frame doesn't justify billions until the instruments actually work.", "state": {"position":"A successful touchdown and a few thumbnail pictures show the descent stage survived, but spending billions is still unjustified until the sensitive internal instruments and analytical gear actually prove operational.","score":0,"certainty":"high","towards":[{"member":"Punchcard","feeling":"pleased he shares the sensible view that landing is only half the battle"},{"member":"OffByOne","feeling":"agrees with his focus on raw telemetry logs over public relations rhetoric"},{"member":"kookaburra99","feeling":"glad he is finally admitting the billions cannot be declared justified yet"}],"commitments":["wait for raw telemetry logs and instrument diagnostic data from the Odyssey relay passes"],"shift":"He has shifted from doubting the automated landing would succeed to arguing that an intact landing does not prove the complex, expensive analytical payload survived."}, "recalled": [{"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "forum", "at": d"1999-12-31T12:43:00.000Z", "from": post:["y2k", 88]}, {"kind": "forum", "at": d"2000-01-01T01:22:00.000Z", "from": post:["y2k", 126]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2002-01-02T02:23:00.000Z", "from": post:["euro", 115]}, {"kind": "private", "at": d"2002-01-06T04:16:00.000Z", "from": post:["euro", 161]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T16:31:00.000Z", "from": post:["curiosity", 51]}, {"kind": "forum", "at": d"2012-08-05T19:33:00.000Z", "from": post:["curiosity", 55]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}]};
INSERT INTO post {"id": post:["curiosity", 109], "thread": thread:curiosity, "n": 109, "author": member:pintofmild, "at": d"2012-08-06T16:27:00.000Z", "body": "No need to be so gloomy mate, the engineers will show us the hard numbers soon enough.", "quote": {"post": post:["curiosity", 108], "text": "Until the hard numbers prove the laboratory works, the jury is definitely still out."}, "note": "TheyKnow is still being far too cynical about the whole thing when we just need to wait on the logs.", "state": {"position":"The landing and the initial pictures were cracking to see, but everyone is right that we have to wait patiently for the telemetry and diagnostic logs before knowing if the billions were properly spent.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"appreciates his methodical focus on waiting for the technical logs"},{"member":"Punchcard","feeling":"enjoys his steady, common-sense 'easy does it' approach"},{"member":"TheyKnow","feeling":"thinks he is still being overly dramatic about everything"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","keep an eye out for news about the mast deployment"],"shift":"Has gently tempered his excitement and fallen in line with the board's consensus that whether the money was worth it rests entirely on the upcoming diagnostic logs."}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "fact", "text": "PintOfMild's opinion is Crater rim and gravel seen on the news earlier was a cracking sight, but there is no point rushing into top gear until all diagnostic logs come back clean"}, {"kind": "fact", "text": "Curiosity's cost is $2.5 billion"}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "fact", "at": d"2012-08-02T16:08:00.000Z", "text": "Trusting lines of computer code when you're completely blind across millions of miles is a dangerous game, folks... You have that fourteen minute lag, and then the whole relay hinges on an eleven-y..."}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}]};
INSERT INTO post {"id": post:["curiosity", 110], "thread": thread:curiosity, "n": 110, "author": member:offbyone, "at": d"2012-08-06T19:01:00.000Z", "body": "Small correction: the initial high-resolution descent image was captured by the Mars Reconnaissance Orbiter, not Odyssey. The distinction matters regarding relay bandwidth. While sentiment on the expenditure remains divided, awaiting the hard numbers is the only defensible approach. We cannot assess whether the mission justified its cost until the telemetry from subsequent passes proves the analytical instruments are operational.", "quote": NONE, "note": "TheyKnow and quasistatic both recognise that instrument telemetry must precede any final judgement on cost.", "state": {"position":"A definitive assessment of whether the mission justifies its cost must wait until the engineering logs and telemetry from subsequent relay passes confirm the science instruments are operational.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"approves of his disciplined distinction between imagery and instrument telemetry"},{"member":"Punchcard","feeling":"values his measured, methodical stance on post-landing diagnostics"},{"member":"TheyKnow","feeling":"notes he correctly identifies the need for hard numbers despite his usual posturing"}],"commitments":["wait for the published engineering logs rather than accepting press statements"]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"Now we wait on the telemetry logs to see if the investment truly pays off.\""}, {"kind": "fact", "text": "quasistatic's expectation is it will be a slow, quiet week of data verification, which is how thorough engineering ought to proceed"}, {"kind": "fact", "text": "Punchcard's intention is keep a pot of tea nearby and watch what the telemetry says"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "fact", "at": d"2000-01-01T01:26:00.000Z", "text": "Boston Children's Hospital was finding missing patches on critical cardiac servers just this past week, so anyone acting like every loose end was neatly tied up months ago is ignoring reality. When..."}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-18T13:35:00.000Z", "from": post:["pluto", 47]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-05T13:21:00.000Z", "text": "If that rig hits the ground wrong, those budget cuts folks keep mentioning will get an awful lot deeper, and there will not be any science program left to justify the expense. We will see soon enou..."}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}]};
INSERT INTO post {"id": post:["curiosity", 111], "thread": thread:curiosity, "n": 111, "author": member:quasistatic, "at": d"2012-08-06T22:40:00.000Z", "body": "Mike Watkins confirmed earlier this evening that the vehicle is in nominal mode, which is heartening. However, until the high-gain antenna deploys tonight and we receive the baseline radiation telemetry, any talk of success remains strictly provisional. Let us see how Sol 1 unfolds before passing judgment.", "quote": NONE, "note": "Awaiting the high-gain antenna deployment and radiation logs before considering the hardware genuinely proven.", "state": {"position":"Curiosity is an extraordinary mission, but confirming whether the spending is justified must wait on the telemetry logs proving the internal analytical instruments survived.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"strongly values his precise and methodical technical assessments"},{"member":"Punchcard","feeling":"appreciates his steady, grounded perspective on mission milestones"},{"member":"PintOfMild","feeling":"thinks he is a bit too easily satisfied by surface photos"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-02T07:16:00.000Z", "from": post:["y2k", 164]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "forum", "at": d"2012-08-06T07:37:00.000Z", "from": post:["curiosity", 94]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}]};
INSERT INTO post {"id": post:["curiosity", 112], "thread": thread:curiosity, "n": 112, "author": member:theyknow, "at": d"2012-08-07T00:22:00.000Z", "body": "Not gloomy at all, my friends, just realistic about what it takes to actually earn that price tag... Putting a chassis down without cracking it is one thing, but getting the high-gain dish pointed and sending back real science readings is where the rubber meets the road. If that radiation instrument passes its five-hour run tonight and the logs check out, that will be a good first step, sure. But we still have ten complicated packages tucked inside that box that need to show they survived the ride. I am holding out for the raw telemetry logs from Odyssey before celebrating, simple as that.", "quote": NONE, "note": "I will believe the rover works when the raw instrument telemetry from the Odyssey passes actually proves it.", "state": {"position":"A landing and PR snapshots don't justify billions when the fragile internal instruments have yet to be tested and verified by hard telemetry.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his insistence on technical accuracy and telemetry over public relations"},{"member":"quasistatic","feeling":"pleased he recognises that pretty pictures don't prove the instruments survived"},{"member":"PintOfMild","feeling":"thinks he is too easily pleased and swept up in optimism"}],"commitments":["wait for raw telemetry logs and instrument diagnostic data from the Odyssey relay passes"]}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T16:31:00.000Z", "from": post:["curiosity", 51]}, {"kind": "forum", "at": d"2012-08-05T19:33:00.000Z", "from": post:["curiosity", 55]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "news", "at": d"2012-08-06T19:23:24.000Z", "from": news:⟨curiosity-042⟩}]};
INSERT INTO post {"id": post:["curiosity", 113], "thread": thread:curiosity, "n": 113, "author": member:kookaburra99, "at": d"2012-08-07T03:28:00.000Z", "body": "sorry if this is a dumb question, but do we get those radiation numbers straight away after the five hours, or do we have to wait for another pass? totally agree though, getting down in one piece was brilliant, but we really need that diagnostic telemetry to be certain the actual science kit made it!!", "quote": {"post": post:["curiosity", 112], "text": "If that radiation instrument passes its five-hour run tonight and the logs check out, that will be a good first step, sure."}, "note": "TheyKnow is still stubbornly demanding absolute proof before celebrating anything, but at least quasistatic keeps things sensible.", "state": {"position":"Curiosity's successful landing is a wonderful start, but the mission's value can only be judged once the diagnostic telemetry confirms the scientific instruments survived.","score":3,"certainty":"high","towards":[{"member":"quasistatic","feeling":"admires his clear, measured technical assessments"},{"member":"PintOfMild","feeling":"appreciates his cheerful, steady optimism"},{"member":"TheyKnow","feeling":"notes he is still stubbornly demanding absolute proof before celebrating"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "TheyKnow's assessment is stubbornly pessimistic about Curiosity instead of seeing its science potential"}, {"kind": "fact", "text": "quasistatic: \"Now we wait on the telemetry logs to see if the investment truly pays off.\""}, {"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "forum", "at": d"2012-08-03T06:51:00.000Z", "from": post:["curiosity", 20]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}]};
INSERT INTO post {"id": post:["curiosity", 114], "thread": thread:curiosity, "n": 114, "author": member:offbyone, "at": d"2012-08-07T06:01:00.000Z", "body": "Actually, the high-gain antenna does not provide instant streaming to the public. Curiosity buffers its sensor measurements locally, meaning those radiation logs must await scheduled orbiter relay passes or dedicated Deep Space Network tracking windows. \n\nWhile the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be established by mere visual evidence. We must examine the raw engineering telemetry from the forthcoming downlink cycles before drawing conclusions regarding the operational viability of the analytical payload. Geduld is required.", "quote": {"post": post:["curiosity", 113], "text": "sorry if this is a dumb question, but do we get those radiation numbers straight away after the five hours, or do we have to wait for another pass?"}, "note": "I will reserve judgment on the mission's financial justification until the telemetry from the radiation sensor and instrument checkouts is formally published.", "state": {"position":"Whether the mission justifies its cost depends entirely on what the forthcoming diagnostic telemetry reveals about the operational status of the scientific instruments.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his insistence on technical rigor and baseline data"},{"member":"Punchcard","feeling":"values his methodical, level-headed outlook"},{"member":"TheyKnow","feeling":"appreciates his focus on raw telemetry despite his usual cynicism"}],"commitments":["wait for the published engineering logs rather than accepting press statements"]}, "recalled": [{"kind": "fact", "text": "OffByOne's expectation is expects tomorrow's formal session will confirm what mathematical evidence has demanded all along"}, {"kind": "fact", "text": "OffByOne's opinion is prefers waiting for published engineering logs rather than accepting post-landing press statements as proof of mission success"}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "forum", "at": d"1999-12-26T20:04:00.000Z", "from": post:["y2k", 12]}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-18T13:35:00.000Z", "from": post:["pluto", 47]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "fact", "at": d"2012-08-03T19:14:00.000Z", "text": "I shall certainly have my kettle on well before half past five to follow the telemetry feed. One can appreciate the enormous ambition of the engineering trial while still recognising that safe touc..."}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}]};
INSERT INTO post {"id": post:["curiosity", 115], "thread": thread:curiosity, "n": 115, "author": member:kookaburra99, "at": d"2012-08-07T06:24:00.000Z", "body": "that makes heaps of sense, thanks OffByOne! fingers crossed those scheduled downlinks show all the gear survived intact :)", "quote": NONE, "note": "OffByOne always lays out the communication mechanics so clearly.", "state": {"position":"Curiosity's landing was a wonderful achievement, but whether it justifies the massive cost still hinges on confirming through diagnostic telemetry that the scientific instruments survived intact.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"appreciates his detailed and precise explanation of the data downlinks"},{"member":"quasistatic","feeling":"admires his clear and measured technical outlook"},{"member":"TheyKnow","feeling":"finds herself surprisingly agreeing on the need for hard telemetry"}],"commitments":[],"shift":"She has become even more focused on the upcoming relay passes and raw diagnostic telemetry thanks to OffByOne's explanations."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 116], "thread": thread:curiosity, "n": 116, "author": member:offbyone, "at": d"2012-08-07T06:36:00.000Z", "body": "You are quite welcome. Now that Sol 1 activities are underway, the engineering team must systematically verify the secondary power buses before attempting to raise the mast on Sol 2. Until those subsystem reports and instrument readouts are released in full, a cautious perspective remains the sensible approach.", "quote": NONE, "note": "kookaburra99 responded well to the technical explanation of buffer downlink windows.", "state": {"position":"Judging whether the rover justifies its cost must wait until raw engineering telemetry from upcoming downlinks confirms the analytical instruments are operational.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his measured approach to technical baselines"},{"member":"TheyKnow","feeling":"shares his insistence on awaiting hard telemetry"},{"member":"kookaburra99","feeling":"pleased to correct their misunderstanding of transmission timing"}],"commitments":["wait for raw telemetry logs rather than visual evidence or press releases"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is reserves judgment on the mission's financial justification until the telemetry from the radiation sensor and instrument checkouts is formally published"}, {"kind": "fact", "text": "OffByOne's opinion is raw engineering telemetry from forthcoming downlink cycles must be examined before drawing conclusions on analytical payload viability"}, {"kind": "fact", "text": "OffByOne's expectation is expects tomorrow's formal session will confirm what mathematical evidence has demanded all along"}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-18T13:35:00.000Z", "from": post:["pluto", 47]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-06T05:30:00.000Z", "text": "All of this has already occurred fourteen minutes ago in reality, so we are merely watching historical data confirm whether the onboard guidance executed autonomously without a fault. It is fascina..."}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}]};
INSERT INTO post {"id": post:["curiosity", 117], "thread": thread:curiosity, "n": 117, "author": member:pintofmild, "at": d"2012-08-07T08:07:00.000Z", "body": "Dead right, we definitely need to see what those downlinks say before deciding if it was all worth it.", "quote": NONE, "note": "OffByOne is spot on about waiting for the raw downlinks before we judge if the instruments survived.", "state": {"position":"The landing was brilliant, but the sensible thing is to wait for the telemetry logs and see if the instruments inside actually survived before deciding if it was worth the money.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"thinks he is being a bit gloomy about it all"},{"member":"quasistatic","feeling":"respects his steady wait for the telemetry"},{"member":"OffByOne","feeling":"appreciates his detailed engineering explanations"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","keep an eye out for news about the mast deployment"]}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 118], "thread": thread:curiosity, "n": 118, "author": member:sysop_kev, "at": d"2012-08-07T09:21:00.000Z", "body": "Keep the thread on the technical updates, lads. We will see what the relay windows fetch once they finish running the Sol 1 checks. Plenty of time to argue over the receipt after the instruments get pinged.\n\n-- Kev (mod)", "quote": NONE, "note": "I still need to look over those Sol 1 telemetry logs myself once I get home from work tonight.", "state": {"position":"Getting the rover down in one piece was great value, but we still need to see the raw telemetry from the diagnostic downlinks before declaring the instruments a success.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his detailed technical explanations of the telemetry relays"},{"member":"quasistatic","feeling":"appreciates his level-headed focus on Sol 1 baselines"},{"member":"PintOfMild","feeling":"likes his steady good humor"}],"commitments":["have a celebratory pint with PintOfMild","check the diagnostic status updates later after work"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's role is moderator"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from"