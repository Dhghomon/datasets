INSERT INTO post {"id": post:["curiosity", 119], "thread": thread:curiosity, "n": 119, "author": member:theyknow, "at": d"2012-08-07T11:36:00.000Z", "body": "Spot on with that technical rundown, Walter... buffer queues and orbiter timing are everything in radio work, so folks just have to be patient. Pretty videos of the heat shield are nice, but checking those power buses and seeing clean instrument readouts on the downlink is what really counts.", "quote": {"post": post:["curiosity", 114], "text": "Actually, the high-gain antenna does not provide instant streaming to the public. Curiosity buffers its sensor measurements locally, meaning those radiation logs must await scheduled orbiter relay passes or dedicated Deep Space Network tracking windows."}, "note": "Walter explained the telemetry buffer well, so I will watch for those downlink windows.", "state": {"position":"A landing and PR snapshots don't justify billions when the fragile internal instruments have yet to be tested and verified by hard telemetry.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his technical explanations and focus on raw telemetry"},{"member":"kookaburra99","feeling":"glad he gets the importance of awaiting the instrument diagnostics"},{"member":"PintOfMild","feeling":"glad he is finally seeing sense about waiting for the downlinks"}],"commitments":["wait for raw telemetry logs and instrument diagnostic data from the Odyssey relay passes"]}, "recalled": [{"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "fact", "text": "TheyKnow's attitude is skeptical that the rover works until raw instrument telemetry from Odyssey passes proves it"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-03T20:38:00.000Z", "from": post:["curiosity", 28]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T16:31:00.000Z", "from": post:["curiosity", 51]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}]};
INSERT INTO post {"id": post:["curiosity", 120], "thread": thread:curiosity, "n": 120, "author": member:punchcard, "at": d"2012-08-07T12:36:00.000Z", "body": "OffByOne deserves the credit for that explanation, my friend, though the principle is just like batch processing.", "quote": NONE, "note": "TheyKnow credited me with OffByOne's post, but at least he is finally learning to wait for the data.", "state": {"position":"Curiosity's landing is a magnificent feat, but whether the mission truly proves its worth depends on seeing the instrument telemetry and calibration baselines run cleanly over the coming sols.","score":4,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his methodical, data-first patience"},{"member":"quasistatic","feeling":"appreciates his disciplined engineering perspective"},{"member":"TheyKnow","feeling":"amused by his sudden conversion to engineering patience"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "TheyKnow: \"Sitting here watching the dials right along with you, my friend... let us see what actually comes down the pipe.\""}, {"kind": "fact", "text": "Punchcard's opinion is OffByOne and quasistatic remain the sensible voices on this board, keeping their eyes firmly on the telemetry"}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "fact", "at": d"2012-08-02T16:08:00.000Z", "text": "Trusting lines of computer code when you're completely blind across millions of miles is a dangerous game, folks... You have that fourteen minute lag, and then the whole relay hinges on an eleven-y..."}, {"kind": "forum", "at": d"2012-08-04T08:37:00.000Z", "from": post:["curiosity", 32]}, {"kind": "forum", "at": d"2012-08-04T17:55:00.000Z", "from": post:["curiosity", 35]}, {"kind": "forum", "at": d"2012-08-04T19:35:00.000Z", "from": post:["curiosity", 37]}, {"kind": "forum", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2012-08-06T03:24:00.000Z", "from": post:["curiosity", 62]}, {"kind": "fact", "at": d"2012-08-06T04:56:00.000Z", "text": "Now we are only minutes away from the top of the Martian atmosphere. Direct line of sight to Earth will drop away shortly, and everything hinges on Odyssey picking up the automated descent tones. P..."}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}, {"kind": "private", "at": d"2012-08-06T06:04:00.000Z", "from": post:["curiosity", 86]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 121], "thread": thread:curiosity, "n": 121, "author": member:offbyone, "at": d"2012-08-07T14:14:00.000Z", "body": "The comparison to mainframe batch cycles is entirely valid. Planetary exploration networks rely strictly on deterministic store-and-forward protocols. The radio packages accumulated during the radiation experiment cannot be reviewed until the Deep Space Network confirms complete frame ingestion without parity drops. The primary task remains waiting for the uncorrupted hex telemetry from the command computers before anyone can objectively state whether the science package is truly intact.", "quote": {"post": post:["curiosity", 120], "text": "OffByOne deserves the credit for that explanation, my friend, though the principle is just like batch processing."}, "note": "Punchcard understands the necessity of batch transmission discipline better than most.", "state": {"position":"A determination on the rover's value must await complete verification of instrument telemetry and subsystem readouts from the scheduled downlink cycles.","score":2,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"pleased they accepted the technical explanation of downlink buffering"},{"member":"TheyKnow","feeling":"pleased they grasp the buffer queue mechanics"},{"member":"Punchcard","feeling":"appreciates the acknowledgement of batch processing principles"}],"commitments":["wait for raw telemetry logs rather than visual evidence or press releases"]}, "recalled": [{"kind": "fact", "text": "OffByOne: \"offbyone and quasistatic explained it so clearly\""}, {"kind": "fact", "text": "OffByOne's opinion is raw engineering telemetry from forthcoming downlink cycles must be examined before drawing conclusions on analytical payload viability"}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "OffByOne's expectation is expects tomorrow's formal session will confirm what mathematical evidence has demanded all along"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "forum", "at": d"2002-01-02T12:19:00.000Z", "from": post:["euro", 121]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "private", "at": d"2012-08-07T06:36:00.000Z", "from": post:["curiosity", 116]}]};
INSERT INTO post {"id": post:["curiosity", 122], "thread": thread:curiosity, "n": 122, "author": member:quasistatic, "at": d"2012-08-07T14:19:00.000Z", "body": "Batch processing is a very neat analogy, Punchcard.\n\nTo keep our minds focused on the actual technical milestones rather than the public relations footage, the situation comes down to two points. First, the descending MARDI video and Mount Sharp vistas are remarkable control demonstrations, but visual telemetry tells us nothing about instrument tolerances. Second, until the Deep Space Network ingests the full frame packets from that initial five-hour radiation run and confirms the internal electronics survived the deceleration loads without thermal or mechanical fault, declaring the project a sound investment is entirely premature. \n\nWe must wait for the raw diagnostic numbers to be verified.", "quote": NONE, "note": "It is reassuring to see OffByOne and TheyKnow both focusing on the store-and-forward telemetry rather than getting swept up by the video clips.", "state": {"position":"Curiosity is a worthy scientific undertaking, but declaring the investment justified requires waiting for the raw engineering telemetry to confirm the internal analytical payload survived.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his precise, rigorous technical breakdown of downlink protocols"},{"member":"Punchcard","feeling":"appreciates his sensible historical parallels"},{"member":"TheyKnow","feeling":"notices he is finally acknowledging the need for raw telemetry logs"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Mars Reconnaissance Orbiter's relay window frequency is two brief windows per day to relay telemetry back to Earth"}, {"kind": "fact", "text": "quasistatic: \"Now we wait on the telemetry logs to see if the investment truly pays off.\""}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-05T21:17:00.000Z", "from": post:["curiosity", 57]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "forum", "at": d"2012-08-06T07:37:00.000Z", "from": post:["curiosity", 94]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2012-08-06T22:40:00.000Z", "from": post:["curiosity", 111]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 123], "thread": thread:curiosity, "n": 123, "author": member:pintofmild, "at": d"2012-08-07T15:56:00.000Z", "body": "Too right, mate. Pretty snaps are brilliant to look at, but they don't tell you if the sensitive sensors inside got knocked about on the way down. Better to hang back and let the tech team crunch all the raw sensor readings properly before making up our minds.", "quote": {"post": post:["curiosity", 122], "text": "Second, until the Deep Space Network ingests the full frame packets from that initial five-hour radiation run and confirms the internal electronics survived the deceleration loads without thermal or mechanical fault, declaring the project a sound investment is entirely premature."}, "note": "I will wait for the full instrument readouts before judging whether the rover was worth the massive price tag.", "state": {"position":"We have to wait for the telemetry downlinks and instrument readouts before knowing if the rover was actually worth all that money.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his thorough technical breakdowns"},{"member":"quasistatic","feeling":"agrees with his cautious call to wait for the data"},{"member":"Punchcard","feeling":"likes his practical computer comparisons"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","keep an eye out for news about the mast deployment"]}, "recalled": [{"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"1999-12-31T09:09:00.000Z", "from": post:["y2k", 79]}, {"kind": "private", "at": d"1999-12-31T22:58:00.000Z", "from": post:["y2k", 117]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 124], "thread": thread:curiosity, "n": 124, "author": member:sysop_kev, "at": d"2012-08-07T19:42:00.000Z", "body": "Sure look, store-and-forward batching is just standard networking when you're working across millions of miles. Fancy colour snaps from the arm are grand, but until the raw telemetry packets come down clean off those scheduled passes, we won't know if the internal kit actually survived the thud.", "quote": NONE, "note": "Still waiting on the clean Sol 1 radiation telemetry before I buy PintOfMild that celebratory pint.", "state": {"position":"Curiosity was worth doing and beats typical government waste, but we need to see the raw diagnostic telemetry before confirming the instruments survived intact.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"appreciates his solid technical breakdowns of downlink schedules"},{"member":"quasistatic","feeling":"respects his steady focus on engineering verification"},{"member":"PintOfMild","feeling":"owes him a pint and appreciates his sensible attitude"}],"commitments":["have a celebratory pint with PintOfMild","monitor the Sol 1 and Sol 2 telemetry updates"]}, "recalled": [{"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 74]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T06:57:00.000Z", "from": post:["curiosity", 93]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "forum", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 125], "thread": thread:curiosity, "n": 125, "author": member:quasistatic, "at": d"2012-08-07T20:17:00.000Z", "body": "Precisely. The hazy arm shot released this afternoon is a case in point - lovely to see, but purely optical. The genuine benchmark remains the health checks on the internal payload. We simply must allow the operations staff the necessary sols to process the instrument logs before evaluating whether the design has actually paid off.", "quote": NONE, "note": "TheyKnow is being uncharacteristically reasonable about radio packet queues today.", "state": {"position":"Curiosity is a worthy scientific undertaking, but declaring the investment justified requires waiting for the raw engineering telemetry to confirm the internal analytical payload survived.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his precise, rigorous technical breakdown of downlink protocols"},{"member":"Punchcard","feeling":"appreciates his apt comparison to batch processing"},{"member":"TheyKnow","feeling":"notices he is finally acknowledging the need for raw telemetry logs"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "forum", "at": d"2012-08-06T07:37:00.000Z", "from": post:["curiosity", 94]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2012-08-06T22:40:00.000Z", "from": post:["curiosity", 111]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 126], "thread": thread:curiosity, "n": 126, "author": member:kookaburra99, "at": d"2012-08-08T01:36:00.000Z", "body": "exactly, the colour shots are exciting for the public, but they really don't prove anything about whether the actual science payload made it through landing intact. the batch processing comparison makes total sense. until the deep space network receives all those clean diagnostic packets from the radiation run and verifies the internal health logs properly, we just can't say whether the massive spend was worth it yet. definitely staying tuned for the engineering telemetry from the upcoming passes.", "quote": NONE, "note": "It is amazing that even TheyKnow is agreeing to wait for the telemetry instead of making up conspiracies.", "state": {"position":"The mission is an incredible achievement, but deciding if the cost is justified requires waiting for the Deep Space Network to confirm the raw diagnostic data and instrument health.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his clear and thorough explanation of network telemetry and protocols"},{"member":"quasistatic","feeling":"deeply respects his calm, structured technical perspective"},{"member":"TheyKnow","feeling":"finds it remarkable that even he agrees on waiting for the technical data"}],"commitments":[],"shift":"She feels reinforced in her view that raw telemetry packets matter far more than early public photos after reading the technical discussion."}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "forum", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}]};
INSERT INTO post {"id": post:["curiosity", 127], "thread": thread:curiosity, "n": 127, "author": member:theyknow, "at": d"2012-08-08T03:38:00.000Z", "body": "Batching or not, that is the sensible way to look at it... A dusty lens on the arm camera doesn't tell us how the internal circuit boards held up under all those Gs. Once the DSN grabs those radiation frames and gets into the Sol 2 mast deployment checks, we will finally have some real figures to chew on.", "quote": NONE, "note": "I will keep watching the DSN passes to see if the radiation logs and mast checks actually come back clean.", "state": {"position":"Flashy landing videos and arm photos don't justify billions when the internal science instruments still have to be proved operational by raw telemetry downlinks.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his clear technical explanations of store-and-forward telemetry"},{"member":"Punchcard","feeling":"appreciates his practical batch processing comparison"},{"member":"quasistatic","feeling":"pleased he agrees optical PR pictures don't prove the instruments survived"}],"commitments":["wait for raw telemetry logs and instrument diagnostic data from the Odyssey relay passes"]}, "recalled": [{"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "fact", "text": "TheyKnow: \"Post #72 by TheyKnow in the thread \"Y2K - is it going to be bad??\" on the Night Owls forum, Fri Dec 31, 1999 3:16 am GMT, replying to Punchcard (post #70)\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "forum", "at": d"2000-01-01T16:53:00.000Z", "from": post:["y2k", 150]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}]};
INSERT INTO post {"id": post:["curiosity", 128], "thread": thread:curiosity, "n": 128, "author": member:pintofmild, "at": d"2012-08-08T09:48:00.000Z", "body": "Dead right. That mast deployment on Sol 2 is going to be the big one to watch out for. It is all well and good the computer saying hello, but seeing that main camera neck unfold properly without any hitches will tell us a lot more about how the mechanics actually took the landing. If those servos and hinges took a proper wallop, we will find out soon enough from the diagnostic logs. Until the team gets all those health checks back safe and sound, you just can't say whether it was money well spent. Fingers crossed for the updates.", "quote": NONE, "note": "I'm keeping my eyes peeled for any news on whether Curiosity's mast deployment went smoothly.", "state": {"position":"We need to wait for the technical staff to crunch the raw telemetry and instrument checks before deciding if the rover was worth all that money.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"strongly agrees with his sensible stance on waiting for the diagnostic data"},{"member":"OffByOne","feeling":"values his detailed technical breakdowns of the downlinks"},{"member":"Punchcard","feeling":"appreciates his handy computing analogies"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","keep an eye out for news about the mast deployment"]}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's opinion is believes waiting for raw downlinks is necessary before judging if instruments survived"}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-03T00:36:00.000Z", "from": post:["curiosity", 17]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T05:48:00.000Z", "from": post:["curiosity", 80]}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}]};
INSERT INTO post {"id": post:["curiosity", 129], "thread": thread:curiosity, "n": 129, "author": member:theyknow, "at": d"2012-08-08T13:39:00.000Z", "body": "Well, we are already seeing some hiccups on Sol 2... the news wires say their weather station calibration failed on Sol 1, and the high-gain dish isn't even aimed straight enough at Earth yet to talk directly. Small mechanical snags add up fast out there, so let's see how that mast actually fares.", "quote": {"post": post:["curiosity", 128], "text": "That mast deployment on Sol 2 is going to be the big one to watch out for. It is all well and good the computer saying hello, but seeing that main camera neck unfold properly without any hitches will tell us a lot more about how the mechanics actually took the landing."}, "note": "They are already running into calibration failures on the weather station and antenna alignment issues just like I expected.", "state": {"position":"Pretty pictures don't prove the landing was worth billions, and we need the raw telemetry data and diagnostic logs to see if the delicate science gear actually works.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his deep technical understanding of data buffers and telemetry"},{"member":"quasistatic","feeling":"pleased they both recognise PR pictures are no substitute for raw instrument data"},{"member":"PintOfMild","feeling":"glad he is also watching for real diagnostic proof from the mast deployment"}],"commitments":["wait for DSN to ingest raw telemetry frames and Sol 2 mast deployment checks"]}, "recalled": [{"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T16:31:00.000Z", "from": post:["curiosity", 51]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "forum", "at": d"2012-08-07T06:36:00.000Z", "from": post:["curiosity", 116]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "news", "at": d"2012-08-08T10:45:38.000Z", "from": news:⟨curiosity-049⟩}]};
INSERT INTO post {"id": post:["curiosity", 130], "thread": thread:curiosity, "n": 130, "author": member:offbyone, "at": d"2012-08-08T14:19:00.000Z", "body": "Small correction: the weather station sensor check did not experience a mechanical failure, but rather an initial calibration routine that did not function as intended, which the JPL team expects to rectify.\n\nFurthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definitive assessment of the mission's worth must wait until the engineering staff verify raw telemetry, sensor calibrations, and mechanical deployments such as the camera mast and high-gain antenna. Precision is essential here; minor commissioning anomalies are not structural defects.", "quote": {"post": post:["curiosity", 129], "text": "the news wires say their weather station calibration failed on Sol 1, and the high-gain dish isn't even aimed straight enough at Earth yet to talk directly. Small mechanical snags add up fast out there, so let's see how that mast actually fares."}, "note": "TheyKnow continues to fixate on minor calibration hiccups instead of waiting for systematic engineering telemetry.", "state": {"position":"A definitive assessment of the mission's worth must wait until the engineering staff verify raw telemetry, sensor calibrations, and mechanical deployments such as the camera mast and high-gain antenna.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects their methodical focus on raw diagnostic telemetry over public relations imagery"},{"member":"Punchcard","feeling":"appreciates their sound grasp of batch processing and transmission discipline"},{"member":"TheyKnow","feeling":"notes their tendency to fixate on minor calibration hiccups"}],"commitments":["wait for raw telemetry logs rather than visual evidence or press releases"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "news", "at": d"2012-08-08T10:45:38.000Z", "from": news:⟨curiosity-049⟩}]};
INSERT INTO post {"id": post:["curiosity", 131], "thread": thread:curiosity, "n": 131, "author": member:pintofmild, "at": d"2012-08-08T16:21:00.000Z", "body": "Good to have that cleared up. Easy to jump at shadows when you see words like 'glitch' in the news, but like you say, an antenna pointing a fraction off target while it sorts itself out isn't the end of the world, especially with the orbiters doing the heavy lifting.\n\nStill, it just goes to show why we can't rush to conclusions about whether the rover was worth the huge pile of cash. We have got to wait until the team actually finishes adjusting that antenna, works through the weather sensor calibrations, and gets the raw verification figures back from the mast movement. Steady as she goes.", "quote": {"post": post:["curiosity", 130], "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case."}, "note": "OffByOne is always great at calming things down when TheyKnow starts panicking over standard calibration snags.", "state": {"position":"We cannot judge whether the rover was worth the money until the engineers verify the raw telemetry, mechanical deployments, and instrument calibrations.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"values his measured stance on waiting for diagnostic verification"},{"member":"OffByOne","feeling":"relies on his reassuring technical corrections on the minor glitches"},{"member":"TheyKnow","feeling":"wary of his tendency to make mountains out of molehills"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","keep an eye out for news about the mast deployment"]}, "recalled": [{"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"1999-12-31T09:09:00.000Z", "from": post:["y2k", 79]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "private", "at": d"2012-08-08T09:48:00.000Z", "from": post:["curiosity", 128]}, {"kind": "news", "at": d"2012-08-08T10:45:38.000Z", "from": news:⟨curiosity-049⟩}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 132], "thread": thread:curiosity, "n": 132, "author": member:sysop_kev, "at": d"2012-08-09T01:33:00.000Z", "body": "Standard commissioning niggles, really. We will see where we stand once the mast deployment logs finish syncing down.", "quote": {"post": post:["curiosity", 130], "text": "Precision is essential here; minor commissioning anomalies are not structural defects."}, "note": "TheyKnow is predictably jumping on normal commissioning hiccups before the Sol 2 logs even land.", "state": {"position":"Curiosity was worth doing and beats typical government waste, but we need to see the raw diagnostic telemetry and deployment logs before calling the hardware a complete success.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his level-headed corrections on routine operational glitches"},{"member":"TheyKnow","feeling":"expects him to jump on every minor snag"},{"member":"PintOfMild","feeling":"owes him a pint and appreciates his sensible attitude"}],"commitments":["have a celebratory pint with PintOfMild","monitor the Sol 1 and Sol 2 telemetry updates"]}, "recalled": [{"kind": "fact", "text": "TheyKnow's opinion is a dusty lens on the arm camera doesn't indicate how the internal circuit boards held up under landing Gs, and real figures will come from DSN radiation frames and Sol 2 mast d..."}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T17:02:00.000Z", "from": post:["curiosity", 52]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 74]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "private", "at": d"2012-08-06T06:57:00.000Z", "from": post:["curiosity", 93]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "news", "at": d"2012-08-08T10:45:38.000Z", "from": news:⟨curiosity-049⟩}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 133], "thread": thread:curiosity, "n": 133, "author": member:theyknow, "at": d"2012-08-09T02:42:00.000Z", "body": "Fair enough, my friend... let's see how those raw mast deployment numbers look once they finally come through.", "quote": {"post": post:["curiosity", 132], "text": "We will see where we stand once the mast deployment logs finish syncing down."}, "note": "I will wait for the confirmed telemetry on the mast deployment before buying into the official confidence.", "state": {"position":"A multi-billion dollar mission cannot be justified by PR pictures, especially with early calibration snags and antenna aiming issues already surfacing before the raw diagnostic logs are in.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his technical precision even if he downplays the glitches as routine"},{"member":"PintOfMild","feeling":"pleased they both recognise the need to wait for mast and sensor diagnostics"},{"member":"Sysop_Kev","feeling":"appreciates his focus on waiting for the deployment logs"}],"commitments":["watch the incoming diagnostic telemetry from the mast deployment and sensor calibrations"],"shift":"He feels vindicated by the emerging reports of antenna pointing issues and weather sensor calibration snags on Sol 1 and 2."}, "recalled": [{"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "fact", "text": "TheyKnow's attitude is skeptical that the rover works until raw instrument telemetry from Odyssey passes proves it"}, {"kind": "fact", "text": "TheyKnow's attitude is realistic about what it takes to actually earn that price tag, holding out for raw telemetry logs before celebrating"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "fact", "at": d"1999-12-30T21:58:00.000Z", "text": "Establishing command centres functions identically. Having staff present merely ensures rapid logging and prompt administrative reporting if minor anomalies occur, exactly as Punchcard noted. We sh..."}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 134], "thread": thread:curiosity, "n": 134, "author": member:kookaburra99, "at": d"2012-08-09T04:13:00.000Z", "body": "sorry if this sounds like a silly question, but do we know how long it usually takes for the logs to come down after they move the mast?? totally makes sense that those early antenna things are just commissioning stuff though lol, OffByOne explained that so well! dying to see what the telemetry says about the hinges!!", "quote": {"post": post:["curiosity", 132], "text": "Standard commissioning niggles, really. We will see where we stand once the mast deployment logs finish syncing down."}, "note": "OffByOne is always so reassuring when people start stressing over normal commissioning stuff.", "state": {"position":"The mission is an incredible achievement, but judging if the cost was justified requires waiting for the engineering telemetry and logs on calibrations and the mast deployment.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his clear and precise corrections of early anomaly reports"},{"member":"quasistatic","feeling":"respects his steady emphasis on waiting for diagnostic payload logs"},{"member":"TheyKnow","feeling":"pleased to see him following the sensible consensus on waiting for raw data"}],"commitments":[],"shift":"She feels confirmed by OffByOne's clear explanations that early snags are just routine commissioning anomalies rather than structural failures."}, "recalled": [{"kind": "fact", "text": "quasistatic: \"Now we wait on the telemetry logs to see if the investment truly pays off.\""}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "fact", "at": d"1999-12-30T21:58:00.000Z", "text": "Establishing command centres functions identically. Having staff present merely ensures rapid logging and prompt administrative reporting if minor anomalies occur, exactly as Punchcard noted. We sh..."}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:49:00.000Z", "text": "That minor detail aside, the subsequent operational phases will require an enormous amount of patience. Transmitting a single 64 by 64 pixel thumbnail through a UHF link on Mars Odyssey merely conf..."}, {"kind": "forum", "at": d"2012-08-06T09:28:00.000Z", "from": post:["curiosity", 99]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2012-08-07T06:36:00.000Z", "from": post:["curiosity", 116]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 135], "thread": thread:curiosity, "n": 135, "author": member:theyknow, "at": d"2012-08-09T04:46:00.000Z", "body": "It all hinges on orbiter timing, young lady... literally! Odyssey only sweeps overhead on set windows, so if an actuator binds or throws an over-current trip, they have to wait for that pass to dump the packet to the DSN before anyone down here knows the story. They always put out the cheerful PR first, but the raw mechanical readouts will show if that hard landing jarred the pins. When you spend billions of taxpayer DOLLARS, you want proof those motors didn't take a beating... so we will keep our eyes on the downlinks.", "quote": NONE, "note": "I want to see the actual actuator current logs before buying into the clean bill of health.", "state": {"position":"The billions spent cannot be justified until the raw deployment and sensor telemetry proves the rover's delicate mechanics survived intact despite early glitches.","score":0,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"agrees with his call to wait for the mast deployment logs"},{"member":"OffByOne","feeling":"respects his technical insights though he tends to brush off early anomalies"},{"member":"PintOfMild","feeling":"shares common ground on waiting for the mechanical verification"}],"commitments":["watch for the raw mast deployment numbers and telemetry logs to come through"]}, "recalled": [{"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "fact", "text": "TheyKnow's opinion is expected calibration failures on the weather station and antenna alignment issues"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:30:00.000Z", "text": "All of this has already occurred fourteen minutes ago in reality, so we are merely watching historical data confirm whether the onboard guidance executed autonomously without a fault. It is fascina..."}, {"kind": "forum", "at": d"2012-08-06T06:01:00.000Z", "from": post:["curiosity", 85]}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "forum", "at": d"2012-08-07T06:01:00.000Z", "from": post:["curiosity", 114]}, {"kind": "forum", "at": d"2012-08-07T06:36:00.000Z", "from": post:["curiosity", 116]}, {"kind": "forum", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}]};
INSERT INTO post {"id": post:["curiosity", 136], "thread": thread:curiosity, "n": 136, "author": member:offbyone, "at": d"2012-08-09T06:43:00.000Z", "body": "Actually, the Mastcam assembly does not employ simple hinges or pins, but multi-axis motorized deployment actuators with dedicated resolvers to verify angular position. \n\nRegarding the timing, downlink latency depends heavily on Mars Odyssey and Mars Reconnaissance Orbiter overflights, which occur only a few times per Martian sol. News reports indicate the mast was indeed raised successfully during Sol 2, providing a 360-degree navigation mosaic. However, photographs alone remain insufficient. A sound technical judgment still requires the raw voltage, current, and temperature telemetry from those actuators to prove the mechanism operates strictly within design tolerances.", "quote": NONE, "note": "TheyKnow continues to invent mechanical catastrophic scenarios despite standard orbital pass geometry explaining transmission delays.", "state": {"position":"A definitive assessment of the mission's worth must wait until the engineering staff verify raw telemetry, sensor calibrations, and mechanical deployments such as the camera mast and high-gain antenna.","score":2,"certainty":"high","towards":[{"member":"TheyKnow","feeling":"notes their persistent habit of misconstruing early commissioning routines as structural failures"},{"member":"Sysop_Kev","feeling":"appreciates their sensible recognition of standard commissioning procedures"},{"member":"kookaburra99","feeling":"pleased they accepted the factual clarification on antenna orientation"}],"commitments":["wait for raw telemetry logs rather than visual evidence or press releases"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is TheyKnow continues to fixate on minor calibration hiccups instead of waiting for systematic engineering telemetry"}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "fact", "at": d"2012-08-02T16:08:00.000Z", "text": "Trusting lines of computer code when you're completely blind across millions of miles is a dangerous game, folks... You have that fourteen minute lag, and then the whole relay hinges on an eleven-y..."}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "forum", "at": d"2012-08-06T11:59:00.000Z", "from": post:["curiosity", 104]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 137], "thread": thread:curiosity, "n": 137, "author": member:kookaburra99, "at": d"2012-08-09T06:48:00.000Z", "body": "The mosaic looks brilliant, but you are totally right that pictures alone do not prove anything yet. Until the actuator voltage and current logs come through to show the motors stayed well within tolerance, we cannot honestly say those billions were justified.", "quote": {"post": post:["curiosity", 136], "text": "A sound technical judgment still requires the raw voltage, current, and temperature telemetry from those actuators to prove the mechanism operates strictly within design tolerances."}, "note": "OffByOne explains the actuator mechanics so clearly compared to TheyKnow's constant talk about pins.", "state": {"position":"Curiosity is an incredible scientific achievement, but deciding if the billions were justified means reviewing the technical telemetry and actuator logs from the mast deployment.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"deeply admires how clearly and precisely he explains the mechanics and downlink process"},{"member":"TheyKnow","feeling":"mildly amused by his drama over pins and orbiter passes"},{"member":"Sysop_Kev","feeling":"appreciates his calm perspective on standard commissioning issues"}],"commitments":[],"shift":"She is thrilled the mast raised successfully to take photos, but is persuaded by OffByOne that actuator logs and technical tolerances are what really prove the rover's health."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "news", "at": d"2012-08-08T10:45:38.000Z", "from": news:⟨curiosity-049⟩}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 138], "thread": thread:curiosity, "n": 138, "author": member:quasistatic, "at": d"2012-08-09T08:38:00.000Z", "body": "Quite right. The new 360-degree panorama confirms that the mast is physically upright, but an optical view cannot substitute for internal engineering metrics. What matters for the rover's long-term science return is how smoothly those actuators drew current during the elevation sequence, and whether the mechanical load remained within standard margins. We know the sky crane blasted the surface quite violently nearby - even exposing what Grotzinger suspects is bedrock - so checking the raw current draw and resolver readings is basic diligence, not pessimism. Once the operations team confirms those motor profiles through the next orbiter passes, we will have a far firmer grasp of where the hardware stands.", "quote": NONE, "note": "Pleased to see kookaburra99 taking a methodical approach to the actuator data rather than being swept along by the photographs.", "state": {"position":"Curiosity remains a sound scientific investment, but verifying its full value requires checking the raw engineering and actuator telemetry rather than relying on initial photographs.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his precise, disciplined technical corrections"},{"member":"TheyKnow","feeling":"notes his persistent tendency to dramatise routine commissioning checks"},{"member":"kookaburra99","feeling":"pleased to see her adopting a methodical, evidence-based outlook"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "SAM's status is awaiting slow calibration following mast deployment and system telemetry"}, {"kind": "fact", "text": "JPL: \"again greeted with loud celebration at JPL.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T05:37:00.000Z", "text": "At the same time, we must maintain perspective as the celebration unfolds on the stream. A rover intact on the regolith merely provides the mobile chassis. The substantial scientific justification ..."}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "forum", "at": d"2012-08-06T07:37:00.000Z", "from": post:["curiosity", 94]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2012-08-06T22:40:00.000Z", "from": post:["curiosity", 111]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 139], "thread": thread:curiosity, "n": 139, "author": member:offbyone, "at": d"2012-08-09T12:59:00.000Z", "body": "Strictly speaking, the descent stage engines did not blast the surface 'nearby' in a random fashion, but directly beneath their fixed cant angles during the final descent deceleration. The resulting scours merely reflect localized regolith displacement.\n\nquasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw peaks, resolver transition counts, and thermal dissipation logs across the elevation sequence will determine whether the drive train suffered any binding or excess friction. Until those hex packets are parsed from the Deep Space Network feeds, patience is mandatory.", "quote": {"post": post:["curiosity", 138], "text": "What matters for the rover's long-term science return is how smoothly those actuators drew current during the elevation sequence, and whether the mechanical load remained within standard margins."}, "note": "quasistatic correctly grasps that resolver transition counts and current logs matter far more than visual panoramas.", "state": {"position":"Assessing the mission's value requires raw actuator current, voltage, and temperature logs to confirm mechanical systems operated within design margins, as photographs alone do not demonstrate operational integrity.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects their rigorous grasp of engineering metrics over optical imagery"},{"member":"kookaburra99","feeling":"pleased they adopted the correct technical criteria regarding actuator telemetry"},{"member":"TheyKnow","feeling":"impatient with their sloppy oversimplifications about hinges and pins"}],"commitments":["wait for raw telemetry logs rather than visual evidence or press releases"],"shift":"Reaffirmed the necessity of examining raw actuator telemetry over mosaic photos following the Sol 2 mast deployment."}, "recalled": [{"kind": "fact", "text": "Curiosity's opinion is astonishing piece of software and systems engineering if all the stages execute properly"}, {"kind": "fact", "text": "OffByOne's opinion is photographs alone remain insufficient and a sound technical judgment requires raw voltage, current, and temperature telemetry from the actuators to prove the mechanism operate..."}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "forum", "at": d"2012-08-07T06:36:00.000Z", "from": post:["curiosity", 116]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}]};
INSERT INTO post {"id": post:["curiosity", 140], "thread": thread:curiosity, "n": 140, "author": member:theyknow, "at": d"2012-08-09T13:01:00.000Z", "body": "Hit the nail on the head there, OffByOne... those rockets kicked up a terrible amount of grit, and you can see the blasted ground right in the deck shots. An upright mast looks fine on the news, but thermal dissipation and current peaks will tell us if any fine dust got into those gears.", "quote": {"post": post:["curiosity", 139], "text": "Motor draw peaks, resolver transition counts, and thermal dissipation logs across the elevation sequence will determine whether the drive train suffered any binding or excess friction."}, "note": "OffByOne is right that we need those thermal and current logs before deciding the drive train came through clean.", "state": {"position":"A pretty photograph does not justify billions of dollars until the raw telemetry proves the mast actuators and mechanisms survived without damage or excessive strain.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"pleased he agrees photos alone mean nothing without raw actuator telemetry"},{"member":"quasistatic","feeling":"appreciates his focus on internal motor current and mechanical strain"},{"member":"kookaburra99","feeling":"glad she is learning to look past PR pictures to the hard data"}],"commitments":["watch for the raw mast actuator telemetry and motor current packets from the orbiter downlinks"],"shift":"He feels vindicated that other posters now agree PR photographs mean nothing without the raw motor logs to back them up."}, "recalled": [{"kind": "fact", "text": "quasistatic: \"offbyone and quasistatic explained it so clearly\""}, {"kind": "fact", "text": "Curiosity's assessment is too heavy for airbags, and legs would make it unstable"}, {"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "fact", "text": "TheyKnow's attitude is waiting to see how raw mast deployment numbers look once they come through"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "forum", "at": d"2000-01-01T01:22:00.000Z", "from": post:["y2k", 126]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 141], "thread": thread:curiosity, "n": 141, "author": member:pintofmild, "at": d"2012-08-09T23:46:00.000Z", "body": "Crack on, patience is the word! It looks the business standing tall, but you cannot judge a book by its cover. I'll feel a lot better about the bill once those actuator packets confirm the gears moved with zero friction. Anyone fancying a pint to toast the telemetry, I'll be in the Head of Steam in Leeds next Friday! Cheers :)", "quote": NONE, "note": "OffByOne and quasistatic are dead right that we need to see the actual actuator telemetry before declaring the rover money well spent.", "state": {"position":"We can't say whether the rover was worth the huge cost until the raw telemetry proves the mast actuators and mechanisms are working within proper tolerances without any strain.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his technical precision on the telemetry and mechanisms"},{"member":"quasistatic","feeling":"appreciates his sensible insistence on waiting for actuator and load data"},{"member":"TheyKnow","feeling":"notes he is focusing heavily on potential damage from rocket grit"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","keep an eye out for news about the mast deployment"]}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "forum", "at": d"2012-08-08T09:48:00.000Z", "from": post:["curiosity", 128]}, {"kind": "private", "at": d"2012-08-08T09:48:00.000Z", "from": post:["curiosity", 128]}, {"kind": "forum", "at": d"2012-08-08T13:39:00.000Z", "from": post:["curiosity", 129]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 142], "thread": thread:curiosity, "n": 142, "author": member:kookaburra99, "at": d"2012-08-10T01:21:00.000Z", "body": "Checking those resolver transition counts and thermal dissipation logs will definitely prove if the sweep was truly clean.", "quote": NONE, "note": "OffByOne and quasistatic explain the engineering requirements so much better than TheyKnow's constant drama about grit.", "state": {"position":"The mission is an incredible achievement, but justifying the billions spent requires parsing the Deep Space Network feeds for the actuator voltage, current, and thermal dissipation logs.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"deeply respects his rigorous and precise technical explanations"},{"member":"quasistatic","feeling":"appreciates his solid grasp of the engineering requirements"},{"member":"TheyKnow","feeling":"sees him as overly dramatizing grit and blast damage"}],"commitments":[],"shift":"She has become even more focused on specific telemetry like resolver transition counts and thermal dissipation to verify the mast mechanism."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "forum", "at": d"2012-08-01T13:56:00.000Z", "from": post:["curiosity", 2]}, {"kind": "private", "at": d"2012-08-02T03:52:00.000Z", "from": post:["curiosity", 9]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T01:40:00.000Z", "from": post:["curiosity", 41]}, {"kind": "private", "at": d"2012-08-06T05:27:00.000Z", "from": post:["curiosity", 70]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 75]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "fact", "at": d"2012-08-06T08:41:00.000Z", "text": "Just settled in at my desk myself with another brew, though my head is still half on Mars! Even with Obama giving them a big shout out on the news, it really does come down to whether those posh ga..."}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2012-08-08T09:48:00.000Z", "from": post:["curiosity", 128]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 143], "thread": thread:curiosity, "n": 143, "author": member:theyknow, "at": d"2012-08-10T04:03:00.000Z", "body": "Patience is indeed the name of the game, PintOfMild... a good brew might be just the ticket while we wait on that DSN queue! We have that big four-day software transition coming up starting Saturday too, so the window to pull down those engineering dumps before the computer gets flashed is getting tight. The color mosaics they put out look sharp enough, but the proof is in the raw hex. Once those resolver sweeps and drive traces show clean current under load, we will know for certain if the gear train held up to the dust. Keeping an ear to the wire on this end.", "quote": NONE, "note": "I will keep watching the DSN feed schedule to see if the raw motor current packets get dumped before the Saturday software update.", "state": {"position":"Pretty pictures mean nothing until the raw thermal logs and motor current packets prove the mast actuators didn't bind from landing grit.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his insistence on parsing raw thermal and current logs"},{"member":"quasistatic","feeling":"agrees the rocket blast could have compromised internal components"},{"member":"PintOfMild","feeling":"amused by his enthusiasm but agrees patience for telemetry is required"}],"commitments":["watch for raw thermal dissipation and actuator current hex packets from the DSN feeds"]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"Now we wait on the telemetry logs to see if the investment truly pays off.\""}, {"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2000-01-01T06:34:00.000Z", "from": post:["y2k", 142]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "private", "at": d"2012-08-09T04:46:00.000Z", "from": post:["curiosity", 135]}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}, {"kind": "private", "at": d"2012-08-09T13:01:00.000Z", "from": post:["curiosity", 140]}]};
INSERT INTO post {"id": post:["curiosity", 144], "thread": thread:curiosity, "n": 144, "author": member:pintofmild, "at": d"2012-08-10T11:03:00.000Z", "body": "A pint makes any wait go down smoother, mate! It is a bit squeaky bum time with that four-day software update kicking off tomorrow, mind. You would hope they get the full actuator readouts down before messing about with the brain! Pretty colour pictures of Gale Crater are lovely for the papers, but like you say, you can't properly weigh up if the taxpayer got value for money until those resolver traces prove the motors didn't bind up against any grit. Hope they don't leave us hanging too long, cheers :)", "quote": {"post": post:["curiosity", 143], "text": "Patience is indeed the name of the game, PintOfMild... a good brew might be just the ticket while we wait on that DSN queue!"}, "note": "TheyKnow and I are on the exact same page waiting for those actuator and resolver logs before the software changeover.", "state": {"position":"The mast standing upright looks great, but we can only judge whether the rover was worth the huge cost once the raw actuator and resolver telemetry proves the mechanisms moved without binding or friction.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his thorough technical standards for verifying mechanism telemetry"},{"member":"quasistatic","feeling":"shares his view that raw motor draw and resolver logs are essential before celebrating"},{"member":"TheyKnow","feeling":"chummy with him over sharing a drink while waiting on downlink packets"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","wait for actuator telemetry and resolver logs before judging if the money was well spent"]}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is OffByOne and quasistatic are dead right that we need to see the actual actuator telemetry before declaring the rover money well spent"}, {"kind": "fact", "text": "PintOfMild's desire is keeping eyes peeled for news on whether Curiosity's mast deployment went smoothly"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for full instrument readouts before judging whether the rover was worth the massive price tag"}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "forum", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "private", "at": d"2012-08-08T09:48:00.000Z", "from": post:["curiosity", 128]}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 145], "thread": thread:curiosity, "n": 145, "author": member:offbyone, "at": d"2012-08-10T13:21:00.000Z", "body": "The software transition merely switches flight software to surface operations, which will not impede processing the downlink backlog.", "quote": NONE, "note": "TheyKnow and PintOfMild seem to misunderstand how scheduled flight software updates affect the DSN telemetry queue.", "state": {"position":"A definitive assessment of Curiosity's worth cannot be made until raw telemetry logs, including motor draw peaks, resolver transition counts, and thermal dissipation data, confirm the mechanisms operated without binding or strain.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects their precise technical understanding of actuator metrics"},{"member":"TheyKnow","feeling":"tolerates their agreement while noting their tendency toward dramatic phrasing"},{"member":"PintOfMild","feeling":"mildly amused by his colloquial habit of measuring engineering milestones by pints of beer"}],"commitments":["wait for parsed hex packets and raw actuator telemetry logs from the DSN feeds before judging the mission's value"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "Resolution 6B's opinion is merely an administrative delay according to OffByOne"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "forum", "at": d"2002-01-03T06:37:00.000Z", "from": post:["euro", 134]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 146], "thread": thread:curiosity, "n": 146, "author": member:pintofmild, "at": d"2012-08-10T14:15:00.000Z", "body": "That puts my mind at rest a bit! Had visions of everything getting stalled in a massive digital logjam while they messed with the computer. If the backlog keeps trundling through fine, we shouldn't have too long to wait to see if the hardware took the strain.", "quote": {"post": post:["curiosity", 145], "text": "The software transition merely switches flight software to surface operations, which will not impede processing the downlink backlog."}, "note": "Relieved that OffByOne says the software switch won't block the engineering logs.", "state": {"position":"The photos look lovely, but whether the rover is worth the billions depends on whether the upcoming actuator and resolver telemetry shows the motors moved cleanly without grit binding the gears.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"enjoys the chummy banter and sharing a brew over the downlink wait"},{"member":"OffByOne","feeling":"respects his steady technical reassurances about software and telemetry"},{"member":"quasistatic","feeling":"agrees with his standard for checking motor current and resolver data"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","wait for actuator telemetry and resolver logs before judging if the money was well spent"],"shift":"He is feeling a bit nervous about the four-day software update holding up the engineering readouts, though enjoying chatting over a brew with TheyKnow."}, "recalled": [{"kind": "fact", "text": "FAA: \"The FAA says no interruption occurred in any critical operations\""}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2012-08-06T05:30:00.000Z", "text": "All of this has already occurred fourteen minutes ago in reality, so we are merely watching historical data confirm whether the onboard guidance executed autonomously without a fault. It is fascina..."}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "forum", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "private", "at": d"2012-08-08T09:48:00.000Z", "from": post:["curiosity", 128]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 147], "thread": thread:curiosity, "n": 147, "author": member:theyknow, "at": d"2012-08-10T14:41:00.000Z", "body": "Good to know the transition won't lock up the backlog, OffByOne... that takes a bit of the pressure off the clock. I'll still feel a lot better once we actually see those raw motor logs clear the queue, but at least the ground stations can keep grinding through the packets over the weekend.", "quote": NONE, "note": "I'm relieved the software switch won't dump the engineering telemetry, but I'll hold my breath until those motor logs are verified.", "state": {"position":"Flashy pictures are just public relations; only the raw resolver traces and engineering logs before the software flash will prove whether landing grit ruined the mechanisms.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his precise grasp of the telemetry and software transition"},{"member":"PintOfMild","feeling":"enjoys his company and shared caution over a brew"},{"member":"kookaburra99","feeling":"pleased she is paying attention to real telemetry over pictures"}],"commitments":["keep listening for raw DSN downlink feeds before the software transition"]}, "recalled": [{"kind": "fact", "text": "wire queues's status is clear"}, {"kind": "fact", "text": "Sysop_Kev: \"Heading into the data centre shortly for my shift.\""}, {"kind": "fact", "text": "OffByOne's opinion is thermal and current logs are needed before deciding the drive train came through clean"}, {"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "fact", "text": "TheyKnow's opinion is agrees with OffByOne that thermal and current logs are needed before deciding the drive train came through clean"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-03T00:36:00.000Z", "text": "Like Punchcard says, error queues are just daily bread in an office. When a computer spits out a dodgy record or a wonky statement date, the system does not explode into flames. It just leaves a li..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2012-08-09T04:46:00.000Z", "from": post:["curiosity", 135]}]};
INSERT INTO post {"id": post:["curiosity", 148], "thread": thread:curiosity, "n": 148, "author": member:offbyone, "at": d"2012-08-10T18:35:00.000Z", "body": "The telemetry dumps will arrive systematically as scheduled DSN relay windows open. There is no cause to treat normal buffer processing as a race against the clock. When the engineering team extracts and publishes the actuator current traces and resolver steps, we will have an empirical record of whether the mechanical deployment experienced any binding. Until those verified packets are made public, speculation regarding dust contamination or gear strain remains premature.", "quote": NONE, "note": "I will inspect the published actuator telemetry before passing judgment on the mechanical health of the rover.", "state": {"position":"A definitive assessment of Curiosity's value cannot be made until parsed hex packets and raw actuator telemetry logs confirm the mechanical deployments operated without binding or strain.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects their precise technical understanding of actuator metrics"},{"member":"TheyKnow","feeling":"tolerates their agreement while noting their persistent anxiety"},{"member":"PintOfMild","feeling":"glad to correct his misconceptions about the software transition"}],"commitments":["wait for parsed hex packets and raw actuator telemetry logs from the DSN feeds before judging the mission's value"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "Resolution 6B's opinion is merely an administrative delay according to OffByOne"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 149], "thread": thread:curiosity, "n": 149, "author": member:quasistatic, "at": d"2012-08-10T22:01:00.000Z", "body": "OffByOne is quite correct, and there is certainly no need to manufacture drama around standard operational sequencing.\n\nTo keep our thinking grounded, we should separate two distinct matters. First, updating from the cruise and descent flight code (R9) to the surface operations build (R10) is a deliberate, pre-planned maintenance cycle. It is not an emergency patch or a bottleneck that threatens existing logs. Second, ground teams routinely process and parse historical downlink buffers whilst science activities pause on the spacecraft. \n\nWaiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them, and not a moment before.", "quote": {"post": post:["curiosity", 148], "text": "There is no cause to treat normal buffer processing as a race against the clock."}, "note": "TheyKnow will always find an imaginary countdown to panic over, no matter how routine the engineering schedule is.", "state": {"position":"Curiosity remains worth the investment, but verifying its operational success requires awaiting parsed engineering telemetry on motor loads and actuator sweeps rather than relying on surface photos or ungrounded speculation.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"appreciates his continued rigorous discipline against premature speculation"},{"member":"TheyKnow","feeling":"notes his chronic habit of manufacturing artificial urgency"},{"member":"PintOfMild","feeling":"amused by his casual good cheer and patience"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic's opinion is awaiting high-gain antenna deployment and radiation logs before considering hardware genuinely proven"}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "forum", "at": d"2012-08-06T07:37:00.000Z", "from": post:["curiosity", 94]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2012-08-06T22:40:00.000Z", "from": post:["curiosity", 111]}, {"kind": "fact", "at": d"2012-08-07T06:01:00.000Z", "text": "While the release of the descent imager footage and the hazard camera views of Mount Sharp is certainly encouraging, pictures do not verify calibration baselines. The mission value cannot be establ..."}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}]};
INSERT INTO post {"id": post:["curiosity", 150], "thread": thread:curiosity, "n": 150, "author": member:offbyone, "at": d"2012-08-11T05:32:00.000Z", "body": "Precisely so. The distinction quasistatic draws between the spacecraft execution cycle and the ground segment processing pipeline is fundamental. A four-sol pause in science tasks simply reflects sound operating discipline while the R10 build is committed to non-volatile memory. It has no bearing on ground station throughput. We need only wait for the verified packets to be processed and made public. Until those telemetry streams confirm nominal current draws across the deployments, declaring the rover fully sound remains unverified conjecture.", "quote": NONE, "note": "quasistatic understands the operational separation between ground pipelines and onboard software builds far better than the rest of the board.", "state": {"position":"Curiosity's value can only be determined once the published telemetry packets verify the actuator current traces and mechanical deployments without speculation.","score":2,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects their precise grasp of systems sequencing"},{"member":"TheyKnow","feeling":"tolerates their agreement while noting their needless anxiety"},{"member":"PintOfMild","feeling":"glad to clear up his confusion over the software transition"}],"commitments":["wait for verified telemetry packets and actuator current draw profiles to be published before evaluating the mission"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is treating normal buffer processing as a race against the clock is unwarranted, and speculation regarding dust contamination or gear strain remains premature until verified tele..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-02T05:00:00.000Z", "from": post:["curiosity", 10]}, {"kind": "fact", "at": d"2012-08-03T20:45:00.000Z", "text": "A prolonged task always brings operational friction. Narrow transmission passes and finicky mechanical parts are the bread and butter of working with remote machinery. One expects things to go slig..."}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "forum", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 76]}, {"kind": "private", "at": d"2012-08-06T10:25:00.000Z", "from": post:["curiosity", 100]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "news", "at": d"2012-08-10T20:51:54.000Z", "from": news:⟨curiosity-055⟩}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}]};
INSERT INTO post {"id": post:["curiosity", 151], "thread": thread:curiosity, "n": 151, "author": member:pintofmild, "at": d"2012-08-11T09:13:00.000Z", "body": "Makes complete sense when you break it down like that. No point sweating the four sols if ground control are just chewing through the backlog in their own time. As long as those raw engineering numbers show up eventually to prove the mechanisms didn't suffer any binding, I can happily sit on my hands.", "quote": NONE, "note": "quasistatic and OffByOne make total sense about letting ground control work through the logs at their own pace.", "state": {"position":"We cannot say whether Curiosity is worth the money until the actuator telemetry and resolver logs are released to prove the gears deployed cleanly without binding.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"reassured by his sensible technical explanations about the downlink queue"},{"member":"quasistatic","feeling":"agrees with his steady standard of waiting patiently for raw actuator metrics"},{"member":"TheyKnow","feeling":"friendly banter companion while waiting out the telemetry"}],"commitments":["buy the first round at the Head of Steam in Leeds next Friday","wait for actuator telemetry and resolver logs before judging if the money was well spent"],"shift":"His worry about the four-day software update causing a logjam has eased thanks to explanations from the board's technical regulars."}, "recalled": [{"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's opinion is OffByOne and quasistatic are dead right that we need to see the actual actuator telemetry before declaring the rover money well spent"}, {"kind": "fact", "text": "PintOfMild's opinion is you cannot properly weigh up taxpayer value until resolver traces prove motors did not bind up against grit"}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "forum", "at": d"2012-08-04T12:28:00.000Z", "from": post:["curiosity", 33]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "forum", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "private", "at": d"2012-08-06T08:41:00.000Z", "from": post:["curiosity", 96]}, {"kind": "forum", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "private", "at": d"2012-08-08T09:48:00.000Z", "from": post:["curiosity", 128]}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}]};
INSERT INTO post {"id": post:["curiosity", 152], "thread": thread:curiosity, "n": 152, "author": member:theyknow, "at": d"2012-08-11T15:37:00.000Z", "body": "Fair points all around, folks. Separating the spacecraft update from the ground station work puts it in perspective, and that definitely takes the edge off any rush... If the DSN antennas are just methodically chewing through those historical packets while the rover rests its processors, then giving it four sols makes good operational sense. I am quite content to sit back, let the telemetry trickle in, and see what the raw current draws show once the team publishes the full breakdown. No sense getting ahead of the data.", "quote": NONE, "note": "I will wait out the four sols of software update and see what the motor current dumps reveal once the ground team finishes parsing them.", "state": {"position":"Flashy photographs mean nothing until the raw motor current draw and resolver traces clear the ground backlog to prove the mechanisms weren't damaged by landing grit.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"appreciates his technical explanation of the downlink queue"},{"member":"PintOfMild","feeling":"enjoys his company and shared caution over a brew"},{"member":"quasistatic","feeling":"agrees with his insistence on waiting for raw mechanical logs"}],"commitments":["watch for the raw motor logs and resolver traces to clear the ground processing queue"],"shift":"He feels less rushed about the upcoming software update now that he knows the downlink backlog will keep processing on Earth."}, "recalled": [{"kind": "private", "text": "TheyKnow: \"TheyKnow's private note to self, Thu Aug 24, 2006 3:30 pm GMT\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-28T12:15:00.000Z", "from": post:["euro", 18]}, {"kind": "private", "at": d"2002-01-06T04:16:00.000Z", "from": post:["euro", 161]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "forum", "at": d"2012-08-02T16:08:00.000Z", "from": post:["curiosity", 15]}, {"kind": "forum", "at": d"2012-08-05T13:21:00.000Z", "from": post:["curiosity", 47]}, {"kind": "forum", "at": d"2012-08-05T22:38:00.000Z", "from": post:["curiosity", 58]}, {"kind": "forum", "at": d"2012-08-06T04:11:00.000Z", "from": post:["curiosity", 65]}, {"kind": "forum", "at": d"2012-08-06T11:29:00.000Z", "from": post:["curiosity", 102]}, {"kind": "private", "at": d"2012-08-06T15:46:00.000Z", "from": post:["curiosity", 108]}, {"kind": "private", "at": d"2012-08-07T00:22:00.000Z", "from": post:["curiosity", 112]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2012-08-08T14:19:00.000Z", "text": "Furthermore, pointing inaccuracies on the high-gain antenna are routine during early surface orientation. The rover currently relies on UHF relay passes through the orbiters in any case. A definiti..."}, {"kind": "forum", "at": d"2012-08-09T04:46:00.000Z", "from": post:["curiosity", 135]}, {"kind": "fact", "at": d"2012-08-09T12:59:00.000Z", "text": "quasistatic outlines the exact engineering requirement. An upright mast and pleasant photographs show only the final geometric state, not the mechanical strain incurred during the sweep. Motor draw..."}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}]};
INSERT INTO post {"id": post:["curiosity", 153], "thread": thread:curiosity, "n": 153, "author": member:quasistatic, "at": d"2012-08-12T08:49:00.000Z", "body": "It is encouraging to see that perspective shared. Now that the primary computer is undergoing the R10 install over the weekend, the operational tempo on Mars is appropriately quiet. The team has already designated the landing quad Yellowknife - a neat nod to Canadian geology - but actual driving remains at least a couple of weeks off. That deliberate pacing gives the flight engineers ample space to complete the flash cycles and verify memory integrity on both computers before any mechanical exploration begins. Provided we remain patient for the validated telemetry to filter through the Deep Space Network pipelines, we will soon have our proper, objective baseline on the hardware.", "quote": NONE, "note": "TheyKnow has finally settled down into a disciplined, evidence-first mindset rather than looking for digital phantoms.", "state": {"position":"Curiosity's scientific mission remains well worth the investment, but assessing the rover's true operational health requires waiting patiently for the release of verified telemetry on actuator currents and mechanical deployments.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his shared commitment to operational discipline and technical precision"},{"member":"TheyKnow","feeling":"pleased to see him finally accept reasoned explanations rather than catastrophise"},{"member":"PintOfMild","feeling":"appreciates his willingness to listen to technical sense"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Pete Theisinger: \"Pete Theisinger stated clearly in the post-landing press conference that the team is in no hurry to commence surface operations\""}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-01T10:20:00.000Z", "from": post:["curiosity", 1]}, {"kind": "forum", "at": d"2012-08-05T12:00:00.000Z", "from": post:["curiosity", 46]}, {"kind": "private", "at": d"2012-08-06T05:30:00.000Z", "from": post:["curiosity", 72]}, {"kind": "private", "at": d"2012-08-06T05:37:00.000Z", "from": post:["curiosity", 78]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "forum", "at": d"2012-08-06T07:37:00.000Z", "from": post:["curiosity", 94]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2012-08-06T22:40:00.000Z", "from": post:["curiosity", 111]}, {"kind": "forum", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2012-08-08T16:21:00.000Z", "from": post:["curiosity", 131]}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}]};
INSERT INTO post {"id": post:["curiosity", 154], "thread": thread:curiosity, "n": 154, "author": member:sysop_kev, "at": d"2012-08-12T16:01:00.000Z", "body": "Grand. Let them flash the flash and we'll see what the logs say when they get round to it.", "quote": NONE, "note": "Waiting to see the actuator logs with my own eyes before calling the hardware sound.", "state": {"position":"Curiosity is good value compared to typical government waste, but confirming the hardware is fully operational requires waiting for the raw engineering logs and actuator telemetry.","score":3,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his solid systems perspective and patience"},{"member":"quasistatic","feeling":"appreciates his level-headed operational explanations"},{"member":"PintOfMild","feeling":"owes him a pint and enjoys his sensible attitude"}],"commitments":["have a celebratory pint with PintOfMild","wait for raw telemetry and actuator data before judging mechanical health"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2000-01-01T22:00:00.000Z", "from": post:["y2k", 159]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2012-08-01T20:40:00.000Z", "from": post:["curiosity", 4]}, {"kind": "private", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-01T21:10:00.000Z", "from": post:["curiosity", 5]}, {"kind": "forum", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "forum", "at": d"2012-08-04T05:19:00.000Z", "from": post:["curiosity", 31]}, {"kind": "private", "at": d"2012-08-06T05:31:00.000Z", "from": post:["curiosity", 74]}, {"kind": "fact", "at": d"2012-08-06T05:33:00.000Z", "text": "Now begins the systematic verification of the platform. We must see whether the hazard avoidance cameras transmit their initial telemetry through Odyssey, whether the power bus remains nominal, and..."}, {"kind": "private", "at": d"2012-08-06T06:57:00.000Z", "from": post:["curiosity", 93]}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}]};
INSERT INTO post {"id": post:["curiosity", 155], "thread": thread:curiosity, "n": 155, "author": member:punchcard, "at": d"2012-08-12T20:33:00.000Z", "body": "Never mind the rush; back in '83 an operating system reload meant half a shift drinking lukewarm instant coffee.", "quote": {"post": post:["curiosity", 154], "text": "Grand. Let them flash the flash and we'll see what the logs say when they get round to it."}, "note": "It is remarkable to see TheyKnow finally learning the virtues of a clean systems window.", "state": {"position":"Curiosity's safe touchdown was an outstanding achievement, but its long-term value will only be demonstrated as the planned software transition finishes and the instrument telemetry confirms everything is sound.","score":4,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his methodical, data-first patience"},{"member":"quasistatic","feeling":"appreciates his calm engineering perspective and Canadian nod"},{"member":"TheyKnow","feeling":"pleased to see him finally adopting some patience"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's intention is check what the logs look like this evening"}, {"kind": "fact", "text": "quasistatic: \"Now we wait on the telemetry logs to see if the investment truly pays off.\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "fact", "at": d"1999-12-31T15:37:00.000Z", "text": "Looking at network ping times from Dublin or watching city streetlamps stay on doesn't tell us how the main water treatment valves or substation relays hold up over the next twenty-four hours. A lo..."}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "forum", "at": d"2012-08-04T08:37:00.000Z", "from": post:["curiosity", 32]}, {"kind": "forum", "at": d"2012-08-04T17:55:00.000Z", "from": post:["curiosity", 35]}, {"kind": "private", "at": d"2012-08-04T17:55:00.000Z", "from": post:["curiosity", 35]}, {"kind": "forum", "at": d"2012-08-04T19:35:00.000Z", "from": post:["curiosity", 37]}, {"kind": "forum", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2012-08-06T03:24:00.000Z", "from": post:["curiosity", 62]}, {"kind": "private", "at": d"2012-08-06T05:33:00.000Z", "from": post:["curiosity", 77]}, {"kind": "private", "at": d"2012-08-06T06:04:00.000Z", "from": post:["curiosity", 86]}, {"kind": "forum", "at": d"2012-08-07T19:42:00.000Z", "from": post:["curiosity", 124]}]};
INSERT INTO thread {"id": thread:endgame, "year": 2019, "title": "Avengers: Endgame - NO SPOILERS please", "about": "The 22nd film in Marvel's superhero series opened around the world over a few days, with talk of breaking every box-office record.", "question": "Will Endgame become the highest-grossing film of all time?"};
INSERT INTO news {"id": news:⟨endgame-001⟩, "thread": thread:endgame, "published": d"2018-06-12T16:43:19.000Z", "headline": "Avengers: Infinity War passes $2 billion worldwide", "text": "Avengers: Infinity War, released in the US on 27 April 2018, has passed $2 billion at the global box office in 48 days. It is only the fourth film to do so, after Avatar ($2.79 billion), Titanic ($2.19 billion) and Star Wars: The Force Awakens ($2.07 billion). It holds the records for the biggest US opening weekend ($257.7 million) and the biggest worldwide debut ($640.5 million). In China it opened two weeks after the rest of the world.", "place": "Worldwide", "source": "https://variety.com/2018/film/news/avengers-infinity-war-2-billion-box-office-1202842669/"};
INSERT INTO news {"id": news:⟨endgame-002⟩, "thread": thread:endgame, "published": d"2018-12-08T19:02:01.000Z", "headline": "First Avengers: Endgame trailer sets a 24-hour viewing record", "text": "Marvel says the first trailer for Avengers: Endgame, released around 5 a.m. Pacific time on Friday 7 December, was viewed 289 million times in its first 24 hours across YouTube, Facebook, Twitter and other platforms. That beats the previous record of 230 million, set by the Avengers: Infinity War trailer. The trailer also revealed the film's title, which Marvel had kept secret.", "place": "Worldwide", "source": "https://variety.com/2018/digital/news/avengers-endgame-record-trailer-worldwide-24-hour-views-1203085074/"};
INSERT INTO news {"id": news:⟨endgame-003⟩, "thread": thread:endgame, "published": d"2019-01-30T12:21:00.000Z", "headline": "UK gets Avengers: Endgame a day earlier, on Thursday 25 April", "text": "According to Comscore's UK arm, Avengers: Endgame now opens in the UK on Thursday 25 April instead of Friday 26 April, one day before the US. Australia, France, Italy and the Netherlands get it even earlier, on Wednesday 24 April.", "place": "United Kingdom", "source": "https://www.empireonline.com/movies/news/avengers-endgame-uk-release-date-moves-forward-one-day/"};
INSERT INTO news {"id": news:⟨endgame-004⟩, "thread": thread:endgame, "published": d"2019-03-27T15:58:31.000Z", "headline": "Avengers: Endgame will run about three hours, the longest Marvel film yet", "text": "Late on Tuesday, AMC Theatres and Fandango suggested on social media that Avengers: Endgame runs three hours and two minutes, then removed the posts. Disney has not confirmed the time and declined to comment, but sources say it is close. A film that long usually loses one showing a day per screen, so analysts expect cinemas to put it in as many auditoriums as possible.", "place": "United States", "source": "https://www.hollywoodreporter.com/heat-vision/avengers-endgame-clocks-at-3-hours-longest-marvel-movie-1197113"};
INSERT INTO news {"id": news:⟨endgame-005⟩, "thread": thread:endgame, "published": d"2019-04-02T22:09:48.000Z", "headline": "Endgame pre-sales crash ticket sites and set first-day records", "text": "Advance tickets for Avengers: Endgame went on sale in the US at 5 a.m. Pacific time. AMC's site returned 503 errors and some Atom and Fandango users had trouble buying. Fandango says Endgame beat Star Wars: The Force Awakens's first-day sales record in only six hours. Atom calls it its best first day ever, four times Aquaman's, and Regal says Endgame sold more tickets in eight hours than Avengers: Infinity War did in its whole first week.", "place": "United States", "source": "https://deadline.com/2019/04/avengers-endgame-presales-record-atom-fandango-amc-website-crash-1202586799/"};
INSERT INTO news {"id": news:⟨endgame-006⟩, "thread": thread:endgame, "published": d"2019-04-04T17:30:59.000Z", "headline": "Tracking points to the biggest US opening ever", "text": "After the record pre-sales, box-office tracking puts Avengers: Endgame's US opening weekend at $200-250 million on conservative estimates, with some analysts now saying $260 million and some talk of nearly $300 million. The current record is Avengers: Infinity War's $257.6 million.", "place": "United States", "source": "https://www.slashfilm.com/565485/avengers-endgame-box-office-projections"};
INSERT INTO news {"id": news:⟨endgame-007⟩, "thread": thread:endgame, "published": d"2019-04-05T15:05:22.000Z", "headline": "AMC plans a 59-hour marathon of all 22 Marvel films", "text": "Three AMC cinemas, in New York, Chicago and San Francisco, will show all 22 Marvel Cinematic Universe films back to back, 59 hours and 7 minutes in all. The marathon starts at 10 a.m. local time on Tuesday 23 April and ends with Avengers: Endgame at 5 p.m. on Thursday 25 April, an hour before regular previews.", "place": "New York, Chicago and San Francisco, United States", "source": "https://abc11.com/post/amc-to-host-59-hour-22-film-marvel-movie-marathon/5235317/"};
INSERT INTO news {"id": news:⟨endgame-008⟩, "thread": thread:endgame, "published": d"2019-04-08T16:07:15.000Z", "headline": "Opening-night tickets offered for thousands on eBay", "text": "Two tickets for an Avengers: Endgame opening-night screening at a New Jersey cinema have sold for $15,000 on eBay, and a pack of nine tickets is listed at around $25,000. The resale prices follow last week's rush, when the AMC and Fandango websites crashed.", "place": "United States", "source": "https://www.fox7austin.com/news/fans-paying-thousands-for-avengers-opening-night-tickets"};
INSERT INTO news {"id": news:⟨endgame-009⟩, "thread": thread:endgame, "published": d"2019-04-12T18:31:51.000Z", "headline": "China pre-sales open with record demand", "text": "Avengers: Endgame sold more than 1 million tickets in China in the first six hours after pre-sales opened on Friday, according to the Maoyan ticketing platform, a record for any film there. In its first hour it outsold Avengers: Infinity War's first 24 hours. By 9 p.m. Beijing time it had RMB 88 million ($13.1 million) in sales. China gets the film on 24 April, two days before the US.", "place": "China", "source": "https://deadline.com/2019/04/avengers-endgame-china-presales-record-1202594805/"};
INSERT INTO news {"id": news:⟨endgame-010⟩, "thread": thread:endgame, "published": d"2019-04-15T20:10:00.000Z", "headline": "Cinemas add extra Endgame showtimes", "text": "Fandango's managing editor Erik Davis says theatres are adding new showtimes for Avengers: Endgame and calls it possibly one of the biggest films of our lifetime. Last week Endgame also became Atom Tickets' all-time pre-sale record holder after 10 days, beating Aquaman, which took 32 days.", "place": "United States", "source": "https://comicbook.com/marvel/2019/04/15/avengers-endgame-theaters-adding-showtimes/"};
INSERT INTO news {"id": news:⟨endgame-011⟩, "thread": thread:endgame, "published": d"2019-04-16T15:54:38.000Z", "headline": "How to block Endgame spoilers on Twitter, Reddit and Facebook", "text": "With a clip, detailed posts and screenshots from Avengers: Endgame spreading on Twitter and Reddit 10 days before release, guides are explaining how to avoid them. Twitter's muted words setting hides tweets with chosen words, and Facebook lets users limit what appears in the news feed. Disney is reported not to have screened the film for critics yet.", "place": "Worldwide", "source": "https://fortune.com/2019/04/16/avengers-endgame-leaked-spoilers-how-to-block-them"};
INSERT INTO news {"id": news:⟨endgame-012⟩, "thread": thread:endgame, "published": d"2019-04-16T21:00:56.000Z", "headline": "Endgame footage leaks; Russo brothers ask fans not to spoil the film", "text": "On Monday night, footage apparently filmed with a phone at an early Avengers: Endgame screening began to appear on YouTube and other sites, and some users are posting spoilers on purpose. The directors, Anthony and Joe Russo, have published a letter asking fans not to spoil the film for others, under the hashtag #DontSpoilTheEndgame. The letter does not mention the leak; they wrote a similar one before Infinity War.", "place": "Worldwide", "source": "https://www.slashfilm.com/565775/endgame-spoilers/"};
INSERT INTO news {"id": news:⟨endgame-013⟩, "thread": thread:endgame, "published": d"2019-04-18T12:00:00.000Z", "headline": "Endgame cast at a fan event in Shanghai", "text": "Chris Evans, Chris Hemsworth, Paul Rudd and Jeremy Renner, with Marvel Studios' Kevin Feige and directors Anthony and Joe Russo, appeared at an Avengers: Endgame fan event in Shanghai. The world tour has already visited London on 10 April and Seoul on 15 April.", "place": "Shanghai, China", "source": "https://d23.com/the-avengers-endgame-cast-circles-the-globe/"};
INSERT INTO news {"id": news:⟨endgame-014⟩, "thread": thread:endgame, "published": d"2019-04-20T02:00:00.000Z", "headline": "China pre-sales pass $60 million; regulator caps ticket prices", "text": "Pre-sales for Avengers: Endgame in China passed RMB 400 million ($60 million) on 19 April, and midnight-screening sales passed RMB 100 million, a record, according to Maoyan. Many cinemas sold out their midnight shows. After a cinema in Nanning charged RMB 360 for a premiere 3D IMAX ticket, the China Film Administration said cinemas may charge only 10% above normal prices, or 30% for VIP seats.", "place": "China", "source": "https://yicaiglobal.com/news/avengers-endgame-pre-sales-in-china-hit-usd60-million"};
INSERT INTO news {"id": news:⟨endgame-015⟩, "thread": thread:endgame, "published": d"2019-04-21T16:06:54.000Z", "headline": "Quiet Easter weekend at the box office before Endgame", "text": "The Curse of La Llorona leads the US Easter weekend with about $26.5 million, ahead of Shazam! and Breakthrough. Captain Marvel returns to the top five with $9 million, up 6% on last weekend, and passes $400 million in the US, which reporters call the 'Endgame effect'. Avengers: Endgame opens next weekend.", "place": "United States", "source": "https://wach.com/news/entertainment/weekend-box-office-la-llorona-rises-as-endgame-looms"};
INSERT INTO news {"id": news:⟨endgame-016⟩, "thread": thread:endgame, "published": d"2019-04-22T14:30:00.000Z", "headline": "India: 1 million Endgame tickets sold in just over a day", "text": "BookMyShow says it has sold 1 million advance tickets for Avengers: Endgame in just over a day, peaking at 18 tickets a second. The film opens in India on 26 April in English, Hindi, Tamil and Telugu. Disney India calls it the end of a journey across 22 films.", "place": "India", "source": "https://www.thenewsminute.com/amp/story/flix/bookmyshow-sells-1-million-tickets-just-over-day-avengers-endgame-india-100532"};
INSERT INTO news {"id": news:⟨endgame-017⟩, "thread": thread:endgame, "published": d"2019-04-22T21:11:50.000Z", "headline": "Can Endgame open to $1 billion worldwide? Estimates near $950 million", "text": "Deadline reports that more cautious forecasts expect a global opening of $940-950 million: about $680 million abroad and $260-270 million in the US and Canada, both records. Disney says Endgame will play in a record 4,600 North American cinemas, with shows from 6 p.m. Thursday, and US pre-sales are estimated above $120 million. In London, the BFI IMAX has only a few seats left in its 4 a.m. and 8 a.m. shows, and at least 175 UK midnight shows for Wednesday night are sold out.", "place": "Worldwide", "source": "https://deadline.com/2019/04/avengers-endgame-global-box-office-opening-projection-1-billion-1202599885/"};
INSERT INTO news {"id": news:⟨endgame-018⟩, "thread": thread:endgame, "published": d"2019-04-22T23:31:20.000Z", "headline": "AMC to keep cinemas open all night, some for 72 hours", "text": "AMC says it has already sold more Avengers: Endgame tickets than for any film before release. 29 of its cinemas will run around the clock from Thursday into Friday, 18 of those through Saturday, and 17 more will stay open for more than 72 hours, from Thursday evening previews to Sunday night. Other chains are also adding overnight shows to fit the three-hour film.", "place": "United States", "source": "https://www.thewrap.com/avengers-endgame-theaters-open-24-hours"};
INSERT INTO news {"id": news:⟨endgame-019⟩, "thread": thread:endgame, "published": d"2019-04-23T05:30:00.000Z", "headline": "World premiere in Los Angeles; first reactions are very positive", "text": "Avengers: Endgame had its world premiere on Monday at the Los Angeles Convention Center, where Disney turned Hall K into a cinema with a 70-foot screen and seats for more than 2,000 guests. After the screening, the first reactions from guests appeared on social media, and they are overwhelmingly positive. Full reviews are due on Tuesday.", "place": "Los Angeles, United States", "source": "https://comicbook.com/marvel/2019/04/22/first-avengers-endgame-reactions/"};
INSERT INTO news {"id": news:⟨endgame-020⟩, "thread": thread:endgame, "published": d"2019-04-23T07:36:26.000Z", "headline": "Report: Russia's release pushed to 29 April to help a Russian film", "text": "Russian newspaper Vedomosti reports, citing two sources, that Endgame's Russian release was moved to 29 April, four days after most of the world, at the Culture Ministry's request, to help ticket sales of the Russian film Billion. The ministry says the distributor itself applied for 29 April. Several cinema chains asked to show it on 25 April at least in premium formats.", "place": "Russia", "source": "https://zona.media/news/2019/04/23/avengers"};
INSERT INTO news {"id": news:⟨endgame-021⟩, "thread": thread:endgame, "published": d"2019-04-23T13:40:00.000Z", "headline": "Box office preview: record $850-900 million global opening expected", "text": "The Hollywood Reporter expects Avengers: Endgame to open to $850-900 million worldwide, possibly more, including $270-300 million in North America from about 4,600 cinemas, the widest release ever. The running time of three hours means fewer showtimes, but cinemas are adding screens and Fandango says 4,000 shows are sold out. US box-office revenue for 2019 is running 17% behind last year.", "place": "United States", "source": "https://www.hollywoodreporter.com/heat-vision/avengers-endgame-box-office-preps-record-850m-900m-global-bow-1203880"};
INSERT INTO news {"id": news:⟨endgame-022⟩, "thread": thread:endgame, "published": d"2019-04-23T14:00:00.000Z", "headline": "22-film Marvel marathon begins", "text": "AMC's 59-hour marathon of all 22 Marvel Cinematic Universe films starts at 10 a.m. local time in New York, Chicago and San Francisco, ending with Avengers: Endgame on Thursday at 5 p.m.", "place": "New York, Chicago and San Francisco, United States", "source": "https://abc11.com/post/amc-to-host-59-hour-22-film-marvel-movie-marathon/5235317/"};
INSERT INTO news {"id": news:⟨endgame-023⟩, "thread": thread:endgame, "published": d"2019-04-24T00:13:00.000Z", "headline": "Reviews are in: Endgame at 98% on Rotten Tomatoes", "text": "The review embargo lifted on Tuesday afternoon. Avengers: Endgame entered Rotten Tomatoes at 98% positive from 51 reviews, one point above Black Panther's score. The score may fall as more reviews come in.", "place": "United States", "source": "https://comicbook.com/marvel/news/avengers-endgame-rotten-tomatoes-score/"};
INSERT INTO news {"id": news:⟨endgame-024⟩, "thread": thread:endgame, "published": d"2019-04-24T14:02:38.000Z", "headline": "Record $107 million opening day in China", "text": "Avengers: Endgame opened in China on Wednesday with an estimated RMB 719 million ($107 million) including midnight shows, an all-time record for China. The midnight, 3 a.m. and 6 a.m. screenings alone took RMB 189 million ($28.2 million), also a record. Audience scores are high (9.1 on Douban, 9.3 on Maoyan), and forecasts for the five-day opening have risen from $250-280 million to above $300 million.", "place": "China", "source": "https://deadline.com/2019/04/avengers-endgame-china-midnights-record-opening-weekend-international-box-office-1202600409/"};
INSERT INTO news {"id": news:⟨endgame-025⟩, "thread": thread:endgame, "published": d"2019-04-24T19:11:46.000Z", "headline": "Three-hour film is a test for bathroom-break app RunPee", "text": "With Avengers: Endgame running 181 minutes, the RunPee app, which tells viewers when they can leave the screen without missing anything important, expects its biggest film yet. Founder Dan Gardner, who had the idea during the three-hour King Kong in 2005, says the app has just over 100,000 registered users.", "place": "United States", "source": "https://edition.cnn.com/2019/04/24/entertainment/avengers-runpee/index.html"};
INSERT INTO news {"id": news:⟨endgame-026⟩, "thread": thread:endgame, "published": d"2019-04-25T13:30:31.000Z", "headline": "Pirated copy of Endgame recorded in a Chinese cinema appears online", "text": "TorrentFreak reports that a 1.2-gigabyte copy of Avengers: Endgame, filmed illegally in a Chinese cinema, began to spread on piracy networks between 4 and 5 p.m. China time on Wednesday and has reached English-language sites. The picture is rotated and partly covered by a gambling site's watermarks, and the sound is poor. A second, better copy is also circulating. Fans are again advised to mute spoiler terms.", "place": "China, worldwide", "source": "https://www.cnbc.com/2019/04/25/full-avengers-endgame-film-leaks-online-ahead-of-us-opening.html"};
INSERT INTO news {"id": news:⟨endgame-027⟩, "thread": thread:endgame, "published": d"2019-04-25T15:01:00.000Z", "headline": "India: 2.5 million advance tickets; some cinemas plan round-the-clock shows", "text": "BookMyShow says 2.5 million advance tickets for Avengers: Endgame have been sold by 25 April, with most interest in big cities such as Delhi and Mumbai. Demand is so high that some Indian cinemas plan round-the-clock screenings, and Endgame may challenge the advance-sales record of the Indian film Baahubali 2.", "place": "India", "source": "https://www.malaymail.com/news/showbiz/2019/04/25/avengers-endgame-breaks-india-booking-records/1747017"};
INSERT INTO news {"id": news:⟨endgame-028⟩, "thread": thread:endgame, "published": d"2019-04-25T17:58:43.000Z", "headline": "Endgame is Fandango's biggest pre-seller ever, with 8,000 sold-out shows", "text": "Hours before US previews start at 6 p.m., Fandango says Avengers: Endgame is its biggest advance seller of all time, beating Star Wars: The Force Awakens, with more than 8,000 sold-out showtimes. Industry estimates put US advance sales at $120-140 million. The film runs 3 hours 1 minute.", "place": "United States", "source": "https://deadline.com/2019/04/avengers-endgame-fandango-biggest-preseller-of-all-time-1202602025/"};
INSERT INTO news {"id": news:⟨endgame-029⟩, "thread": thread:endgame, "published": d"2019-04-25T18:00:00.000Z", "headline": "$169 million on the first day abroad; Korea and Australia set records", "text": "With China and 24 other markets open on Wednesday, Avengers: Endgame took $169 million on its first day outside the US, ahead of Infinity War in every market. Korea took $8.4 million, its best non-holiday opening day, and Australia $7 million. Eight markets, including Hong Kong, Taiwan, Thailand and the Philippines, had their biggest single day ever. The UK and Brazil open on Thursday, Japan and Mexico on Friday.", "place": "Asia, Europe, Australia", "source": "https://deadline.com/2019/04/avengers-endgame-opening-weekend-record-global-china-international-box-office-1202601752/"};
INSERT INTO news {"id": news:⟨endgame-030⟩, "thread": thread:endgame, "published": d"2019-04-26T14:49:03.000Z", "headline": "Record $60 million from Thursday night previews in the US", "text": "Avengers: Endgame made $60 million from Thursday night previews in the US and Canada, the highest ever, beating Star Wars: The Force Awakens's $57 million. IMAX previews took a record $4.8 million on 412 screens. The film has made $305 million in its first two days abroad. Forecasts for the US weekend are $260-285 million.", "place": "United States", "source": "https://www.cnbc.com/2019/04/26/avengers-endgame-smashes-thursday-night-record-with-60-million-haul.html"};
INSERT INTO news {"id": news:⟨endgame-031⟩, "thread": thread:endgame, "published": d"2019-04-26T17:18:00.000Z", "headline": "$305 million abroad in two days; UK single-day record", "text": "Now playing in 46 markets outside the US, Avengers: Endgame has taken $305 million in its first two days. On Thursday, its first day in the UK, it took $15.3 million, the biggest single day ever there, and it set the same kind of record in all the Latin American markets that opened, including Brazil ($7 million). Australia and New Zealand dropped only slightly on the Anzac Day holiday.", "place": "United Kingdom, Latin America, worldwide", "source": "https://deadline.com/2019/04/avengers-endgame-opening-weekend-record-global-china-international-box-office-1202601752/"};
INSERT INTO news {"id": news:⟨endgame-032⟩, "thread": thread:endgame, "published": d"2019-04-26T23:59:13.000Z", "headline": "Google adds an Endgame Easter egg to searches for 'Thanos'", "text": "Searching Google for 'Thanos' now shows a small Infinity Gauntlet icon. Clicking it makes about half of the search results fade away, a nod to the previous film, and clicking again brings them back.", "place": "Worldwide", "source": "https://thenextweb.com/insider/2019/04/26/googles-nifty-endgame-easter-egg-wipes-out-half-your-search-results-with-a-snap-of-thanos-fingers/"};
INSERT INTO news {"id": news:⟨endgame-033⟩, "thread": thread:endgame, "published": d"2019-04-27T13:19:00.000Z", "headline": "Audiences give Endgame an A+ CinemaScore", "text": "Audiences polled by CinemaScore give Avengers: Endgame an A+, only the third Marvel Cinematic Universe film to get one, after The Avengers and Black Panther. PostTrak exit polls give it five stars, with 85% definitely recommending it. 62% of this weekend's audience bought tickets online in advance, and there are many reports of people taking Friday off work.", "place": "United States", "source": "https://deadline.com/2019/04/avengers-endgame-opening-weekend-box-office-record-1202602445/"};
INSERT INTO news {"id": news:⟨endgame-034⟩, "thread": thread:endgame, "published": d"2019-04-27T15:30:45.000Z", "headline": "Biggest opening day ever: $156.7 million on Friday", "text": "Avengers: Endgame took an estimated $156.7 million in the US and Canada on Friday, including Thursday previews, the biggest day in box-office history, beating The Force Awakens's $119 million. The weekend is now estimated at about $345 million from 4,662 cinemas. With $487 million abroad, the worldwide total is already $643.7 million.", "place": "United States", "source": "https://www.variety.com/2019/film/box-office/avengers-endgame-box-office-debut-weekend-1203199485"};
INSERT INTO news {"id": news:⟨endgame-035⟩, "thread": thread:endgame, "published": d"2019-04-27T17:42:54.000Z", "headline": "Endgame may cover its costs within its opening weekend", "text": "Film finance experts tell Deadline that with a global opening heading for $1.1 billion, Avengers: Endgame should come close to cash breakeven on Sunday, which is almost unheard of for a big studio film in its opening weekend. Avengers: Infinity War became profitable after ten days.", "place": "United States", "source": "https://deadline.com/2019/04/avengers-endgame-breakeven-profit-after-opening-weekend-box-office-marvel-1202603237/"};
INSERT INTO news {"id": news:⟨endgame-036⟩, "thread": thread:endgame, "published": d"2019-04-28T16:00:00.000Z", "headline": "Disney calls the US opening at $350 million, a new record", "text": "Disney estimates the US and Canada opening weekend of Avengers: Endgame at $350 million, about $100 million above Avengers: Infinity War's record of $257.6 million; rival studios estimate it higher, at $354 million. It also set records for Saturday ($109 million) and Sunday. All films together made close to $400 million this weekend, the biggest weekend ever for US cinemas.", "place": "United States", "source": "https://deadline.com/2019/04/avengers-endgame-opening-weekend-box-office-record-1202602445/"};
INSERT INTO news {"id": news:⟨endgame-037⟩, "thread": thread:endgame, "published": d"2019-04-28T16:56:33.000Z", "headline": "$1.2 billion worldwide: the first opening ever above $1 billion", "text": "Avengers: Endgame opened to an estimated $1.209 billion worldwide, the first film to pass $1 billion in its opening, in five days, and nearly double Infinity War's $640.5 million record. Overseas it took $859 million, with record openings in 44 markets: China $330.5 million over five days, the UK $53.8 million (beating Spectre), Korea, Mexico, Australia, Brazil and Spain. It is already the 18th highest-grossing film ever.", "place": "Worldwide", "source": "https://www.hollywoodreporter.com/movies/movie-news/avengers-endgame-box-office-all-records-broken-12b-bow-1205398/"};
INSERT INTO news {"id": news:⟨endgame-038⟩, "thread": thread:endgame, "published": d"2019-04-29T12:47:55.000Z", "headline": "Endgame finally opens in Russia; complaint over the delay", "text": "Avengers: Endgame opens in Russia today, four days after most of the world. Unconfirmed reports say the Culture Ministry wanted to protect the Russian film Billion, and cinema owners are angry. The Federal Antimonopoly Service confirms a formal complaint was filed on 26 April and must respond within 30 days.", "place": "Russia", "source": "https://meduza.io/en/news/2019/04/29/russia-s-federal-antimonopoly-service-will-review-complaints-about-the-delayed-release-of-avengers-endgame"};
INSERT INTO news {"id": news:⟨endgame-039⟩, "thread": thread:endgame, "published": d"2019-04-29T18:10:22.000Z", "headline": "Actual figures raise the global opening to $1.222 billion", "text": "With Sunday's actual figures, Avengers: Endgame's overseas opening rises to $866 million and its global opening to $1.222 billion. The UK came in at $56 million, above Sunday's estimate. Top markets: China $330.5 million, UK $56 million, Korea $46.9 million, Mexico $31.9 million, Australia $31.2 million.", "place": "Worldwide", "source": "https://deadline.com/2019/04/avengers-endgame-opening-weekend-record-global-china-international-box-office-1202601752/"};
INSERT INTO news {"id": news:⟨endgame-040⟩, "thread": thread:endgame, "published": d"2019-04-30T01:32:53.000Z", "headline": "US opening weekend confirmed at $357.1 million", "text": "Final figures put Avengers: Endgame's US and Canada opening weekend at $357.1 million, above Disney's Sunday estimate of $350 million. IMAX screens took $26.5 million. All films together made a record $401 million this weekend. Endgame is expected to take $33-35 million on Monday.", "place": "United States", "source": "https://deadline.com/2019/04/avengers-endgame-opening-weekend-box-office-record-1202602445/"};
INSERT INTO news {"id": news:⟨endgame-041⟩, "thread": thread:endgame, "published": d"2019-04-30T16:53:55.000Z", "headline": "$36.7 million Monday; Endgame now the 10th highest-grossing film ever", "text": "Avengers: Endgame took $36.7 million in the US on Monday, the third-best Monday ever and the best for a film that did not open on a holiday weekend. Its worldwide total is $1.34 billion after six days, passing Frozen and Star Wars: The Last Jedi. Overseas it has $948.7 million, including $349.1 million from China.", "place": "United States, worldwide", "source": "https://www.hollywoodreporter.com/heat-vision/avengers-endgame-scores-367-million-monday-at-box-office-1205794"};
INSERT INTO news {"id": news:⟨endgame-042⟩, "thread": thread:endgame, "published": d"2019-05-01T12:00:00.000Z", "headline": "Endgame becomes the highest-grossing foreign film in China", "text": "On 1 May, Avengers: Endgame passed RMB 3 billion ($445 million) in China, the first foreign film to do so, overtaking The Fate of the Furious as the highest-grossing foreign film there. It has broken 22 Chinese box-office records, including pre-sales, midnight screenings, single day and week.", "place": "China", "source": "http://chinafilminsider.com/headlines-from-china-avengers-endgame-is-now-the-highest-grossing-foreign-film-in-china/"};
INSERT INTO news {"id": news:⟨endgame-043⟩, "thread": thread:endgame, "published": d"2019-05-01T14:23:10.000Z", "headline": "Record Tuesday for a Marvel film; US total $427 million", "text": "Avengers: Endgame took an estimated $33.4 million in the US on Tuesday, the best Tuesday for any Marvel Cinematic Universe film and the third best overall. Its US total is $427.38 million after five days. It is expected to pass $500 million faster than The Force Awakens's 10 days, and analysts expect it to reach $2 billion worldwide.", "place": "United States", "source": "https://deadline.com/2019/05/avengers-endgame-tuesday-box-office-marvel-record-1202605214/"};
INSERT INTO news {"id": news:⟨endgame-044⟩, "thread": thread:endgame, "published": d"2019-05-02T12:00:00.000Z", "headline": "Twitter: Endgame is the most-tweeted film ever", "text": "Twitter says Avengers: Endgame is the most-tweeted-about film ever, with more than 50 million tweets since the start of 2019, nearly half of them in the past week. Fans are using #ThankYouAvengers, and the cast and directors continue the #DontSpoilTheEndgame campaign.", "place": "Worldwide", "source": "https://vietnamnews.vn/media-outreach/519352/avengers-endgame-is-most-tweeted-about-movie-ever-with-more-than-50-million-tweets-since-the-start-of-the-year.html"};
INSERT INTO news {"id": news:⟨endgame-045⟩, "thread": thread:endgame, "published": d"2019-05-03T07:56:24.000Z", "headline": "Endgame becomes the top Hollywood release ever in India", "text": "By Wednesday, its sixth day, Avengers: Endgame had made $40.9 million in India, passing The Jungle Book ($38.83 million) as the highest-grossing Hollywood film ever there; by Thursday it had $43.7 million. Its $25.7 million opening weekend was the best ever for a Hollywood film in India.", "place": "India", "source": "https://www.hollywoodreporter.com/news/avengers-endgame-becomes-top-hollywood-release-india-1207188"};
INSERT INTO news {"id": news:⟨endgame-046⟩, "thread": thread:endgame, "published": d"2019-05-03T18:03:35.000Z", "headline": "$1.78 billion worldwide; $2 billion expected on Saturday", "text": "Avengers: Endgame has reached $1.786 billion worldwide, $1.312 billion of it outside the US, and is now the fifth highest-grossing film ever, passing Jurassic World. It should pass $2 billion by Saturday, which only four films have done. In China, Maoyan has raised its forecast for the final total to RMB 4.14 billion ($615 million).", "place": "Worldwide", "source": "https://deadline.com/2019/05/avengers-endgame-first-week-china-global-international-box-office-results-records-1202604612/"};
INSERT INTO news {"id": news:⟨endgame-047⟩, "thread": thread:endgame, "published": d"2019-05-05T15:07:05.000Z", "headline": "Endgame passes $2 billion in 11 days, the fastest ever", "text": "Avengers: Endgame passed $2 billion worldwide in its second weekend, in 11 days; Avatar, the previous fastest, took 47. It is the fifth film above $2 billion, after Avatar, Titanic, The Force Awakens and Infinity War. With $2.188 billion it is now second of all time, and it has $620 million in North America and $1.56 billion abroad.", "place": "Worldwide", "source": "https://variety.com/2019/film/news/avengers-endgame-2-billion-record-time-1203205293/"};
INSERT INTO news {"id": news:⟨endgame-048⟩, "thread": thread:endgame, "published": d"2019-05-05T15:12:40.000Z", "headline": "Second weekend: $145.8 million and $600 million in 10 days", "text": "Disney estimates Avengers: Endgame's second US weekend at $145.8 million, the second-best second weekend ever after The Force Awakens's $149.2 million. Its US total reaches $619.7 million in 10 days, the fastest film to $600 million. New releases Long Shot, The Intruder and UglyDolls opened against it.", "place": "United States", "source": "https://deadline.com/2019/05/avengers-endgame-box-office-second-weekend-uglydolls-charlize-theron-seth-rogen-long-shot-1202606827/"};
INSERT INTO news {"id": news:⟨endgame-049⟩, "thread": thread:endgame, "published": d"2019-05-05T18:40:39.000Z", "headline": "Endgame passes Titanic; only Avatar is bigger", "text": "With an estimated $2.1887 billion worldwide, Avengers: Endgame has passed Titanic to become the second highest-grossing film ever, and it is also second overseas with $1.569 billion. About $600 million worldwide, and $459 million overseas, still separates it from Avatar's record.", "place": "Worldwide", "source": "https://deadline.com/2019/05/avengers-endgame-second-weekend-china-global-international-box-office-1202607401/"};
INSERT INTO news {"id": news:⟨endgame-050⟩, "thread": thread:endgame, "published": d"2019-05-06T13:25:05.000Z", "headline": "New Spider-Man: Far From Home trailer carries Endgame spoilers", "text": "Sony has released the second trailer for Spider-Man: Far From Home, which is set after Avengers: Endgame, with a warning that it contains Endgame spoilers. The film opens in North America on 2 July and in the UK on 3 July.", "place": "Worldwide", "source": "https://getyourcomicon.co.uk/blog/2019/05/06/sony-drops-new-spider-man-far-from-home-trailer/"};
INSERT INTO news {"id": news:⟨endgame-051⟩, "thread": thread:endgame, "published": d"2019-05-06T14:55:02.000Z", "headline": "Russo brothers: the spoiler ban ends today", "text": "Directors Joe and Anthony Russo said Monday 6 May is the end of their request not to spoil Avengers: Endgame. They tweeted 'The spoiler ban lifts on Monday!' on Thursday, and told Good Morning America that part of why they make these films is for conversation.", "place": "United States", "source": "https://x96.com/?p=104253"};
INSERT INTO post {"id": post:["endgame", 1], "thread": thread:endgame, "n": 1, "author": member:pintofmild, "at": d"2019-04-18T19:25:00.000Z", "body": "Right then, only one week to go! I have bagged tickets for the very first UK showings on Thursday 25th and I honestly cannot wait. Looking at the pre-sales crashing websites everywhere and the numbers coming out of China, this thing is going to absolutely smash every box office record going. I reckon even Avatar's crown is in serious danger. Who else has managed to grab tickets, and when are you all seeing it? Just a gentle reminder to please keep this thread totally spoiler-free, especially with those nasty leaks floating around online. Let us know your plans! :)", "quote": NONE, "note": "I have told everyone I think Endgame will beat Avatar's box office record.", "state": {"position":"Endgame is going to smash every box office record, including Avatar's.","score":4,"certainty":"high","towards":[],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint"]}, "recalled": []};
INSERT INTO post {"id": post:["endgame", 2], "thread": thread:endgame, "n": 2, "author": member:punchcard, "at": d"2019-04-18T23:29:00.000Z", "body": "My grandson has bought tickets for us to go on Saturday the 27th. He gave me strict orders to avoid reading anything about it beforehand.\n\nAs for overtaking Avatar, that seems rather premature. Advance ticket demand is one thing, but we will simply have to wait for the actual box office returns.", "quote": NONE, "note": "PintOfMild is getting ahead of himself with the box office predictions before a single screening has opened.", "state": {"position":"It is far too early to tell if it can pass Avatar, and we will simply have to wait for the actual box office figures once it opens.","score":2,"certainty":"low","towards":[{"member":"PintOfMild","feeling":"finds his excitement premature"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers"]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is OffByOne and quasistatic remain the sensible voices on this board, keeping their eyes firmly on the telemetry"}, {"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"1999-12-30T21:58:00.000Z", "text": "Establishing command centres functions identically. Having staff present merely ensures rapid logging and prompt administrative reporting if minor anomalies occur, exactly as Punchcard noted. We sh..."}, {"kind": "private", "at": d"1999-12-31T18:20:00.000Z", "from": post:["y2k", 105]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T19:55:00.000Z", "from": post:["y2k", 156]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T16:28:00.000Z", "from": post:["euro", 58]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "news", "at": d"2019-04-02T22:09:48.000Z", "from": news:⟨endgame-005⟩}, {"kind": "news", "at": d"2019-04-12T18:31:51.000Z", "from": news:⟨endgame-009⟩}, {"kind": "news", "at": d"2019-04-15T20:10:00.000Z", "from": news:⟨endgame-010⟩}, {"kind": "news", "at": d"2019-04-16T15:54:38.000Z", "from": news:⟨endgame-011⟩}]};
INSERT INTO post {"id": post:["endgame", 3], "thread": thread:endgame, "n": 3, "author": member:sysop_kev, "at": d"2019-04-19T00:29:00.000Z", "body": "Dead right. Pre-sales are mostly just the diehards rushing the turnstiles on day one. To touch Avatar you need people going back three or four times over months, not just crashing ticketing servers in week one. We will see what the actual figures look like once it opens.", "quote": {"post": post:["endgame", 2], "text": "As for overtaking Avatar, that seems rather premature. Advance ticket demand is one thing, but we will simply have to wait for the actual box office returns."}, "note": "Punchcard has the right idea not getting carried away before a single dollar is actually counted.", "state": {"position":"It is far too early to tell if Endgame can beat Avatar until actual box office numbers come in.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"agrees with his sensible wait-and-see attitude"},{"member":"PintOfMild","feeling":"finds his excitement premature"}],"commitments":["enforce a strict no-spoilers rule on the thread"],"shift":"Has entered the thread taking a measured wait-and-see stance on whether the box office record will actually fall."}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's intention is waiting to see the actuator logs with his own eyes before calling the hardware sound"}, {"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2000-01-01T22:00:00.000Z", "from": post:["y2k", 159]}, {"kind": "private", "at": d"2000-01-05T18:52:00.000Z", "from": post:["y2k", 180]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "private", "at": d"2012-08-03T01:38:00.000Z", "from": post:["curiosity", 18]}, {"kind": "private", "at": d"2012-08-05T17:02:00.000Z", "from": post:["curiosity", 52]}, {"kind": "news", "at": d"2018-12-08T19:02:01.000Z", "from": news:⟨endgame-002⟩}, {"kind": "news", "at": d"2019-04-02T22:09:48.000Z", "from": news:⟨endgame-005⟩}, {"kind": "news", "at": d"2019-04-04T17:30:59.000Z", "from": news:⟨endgame-006⟩}, {"kind": "news", "at": d"2019-04-12T18:31:51.000Z", "from": news:⟨endgame-009⟩}, {"kind": "news", "at": d"2019-04-15T20:10:00.000Z", "from": news:⟨endgame-010⟩}, {"kind": "news", "at": d"2019-04-16T15:54:38.000Z", "from": news:⟨endgame-011⟩}]};
INSERT INTO post {"id": post:["endgame", 4], "thread": thread:endgame, "n": 4, "author": member:punchcard, "at": d"2019-04-19T00:40:00.000Z", "body": "Quite so. It reminds me a little of the rush we had back in '79 when we migrated the clearing system. Management looked at the initial transaction spike on Monday morning and declared it an unqualified triumph, only to discover by Thursday that half the volume was simply the previous week's backlogged cheques clearing through at once. A very different sort of accounting, to be sure, but early enthusiasm often mistakes front-loaded demand for permanent momentum.\n\nTwo point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will naturally restrict the number of daily screenings a cinema can manage, regardless of how many auditoriums they give over to it.\n\nMy grandson informs me that I am not even permitted to glance at the entertainment section of the morning paper until our Saturday matinee is safely concluded. I shall mind my own business, keep my eyes front, and see how the ledgers balance after the dust settles.", "quote": {"post": post:["endgame", 3], "text": "Pre-sales are mostly just the diehards rushing the turnstiles on day one. To touch Avatar you need people going back three or four times over months, not just crashing ticketing servers in week one."}, "note": "Sysop_Kev has the right measure of things regarding long-term box office legs versus early fanfare.", "state": {"position":"It is far too early to know if it can beat Avatar, and we need to wait and see how the actual box office figures hold up once it opens.","score":2,"certainty":"low","towards":[{"member":"PintOfMild","feeling":"finds his excitement premature"},{"member":"Sysop_Kev","feeling":"appreciates his sensible perspective"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers"],"shift":"Feels reassured that Sysop_Kev also takes a patient, wait-and-see view of the box office numbers."}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2000-01-01T19:55:00.000Z", "from": post:["y2k", 156]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "news", "at": d"2019-04-02T22:09:48.000Z", "from": news:⟨endgame-005⟩}, {"kind": "news", "at": d"2019-04-15T20:10:00.000Z", "from": news:⟨endgame-010⟩}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}]};
INSERT INTO post {"id": post:["endgame", 5], "thread": thread:endgame, "n": 5, "author": member:theyknow, "at": d"2019-04-19T01:32:00.000Z", "body": "Punchcard and Kev have the right perspective on this... Front-loading an opening weekend with hyped-up advance sales is easy enough to manage, but sustaining it for months to reach nearly three billion dollars is quite another matter. A three-hour run time cuts screenings down every day, too. Let us see how the seats look come June.", "quote": NONE, "note": "PintOfMild is getting carried away by the studio hype machine, but Punchcard sees through front-loaded numbers.", "state": {"position":"The hype and advance ticket figures are heavily manufactured marketing by Disney, and talk of breaking Avatar's record is vastly exaggerated.","score":1,"certainty":"medium","towards":[{"member":"PintOfMild","feeling":"thinks he is falling hook, line, and sinker for corporate PR hype"},{"member":"Punchcard","feeling":"agrees with his cautious look at front-loaded numbers"},{"member":"Sysop_Kev","feeling":"respects his sensible view on diehard fan rushes versus genuine legs"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's opinion is agrees with OffByOne that thermal and current logs are needed before deciding the drive train came through clean"}, {"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"1999-12-31T05:19:00.000Z", "from": post:["y2k", 76]}, {"kind": "fact", "at": d"2000-01-01T01:26:00.000Z", "text": "Boston Children's Hospital was finding missing patches on critical cardiac servers just this past week, so anyone acting like every loose end was neatly tied up months ago is ignoring reality. When..."}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T00:36:00.000Z", "text": "Like Punchcard says, error queues are just daily bread in an office. When a computer spits out a dodgy record or a wonky statement date, the system does not explode into flames. It just leaves a li..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "forum", "at": d"2000-01-03T12:54:00.000Z", "from": post:["y2k", 174]}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "fact", "at": d"2000-01-05T08:29:00.000Z", "text": "[quoting: \"When thousands of transactions get kicked into an error pile every hour, that is not business as usual, that is a BACKLOG waiting to choke the whole pipeline.\"] The empirical reporting f..."}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}]};
INSERT INTO post {"id": post:["endgame", 6], "thread": thread:endgame, "n": 6, "author": member:kookaburra99, "at": d"2019-04-19T02:23:00.000Z", "body": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agree with punchcard on this one. crashing the websites is crazy exciting and my kids have been counting down the sleeps for weeks, but huge opening day queues don't automatically mean it has legs to beat avatar over the whole winter. especially at three hours long! that's a massive sit for anyone, cinemas can only fit so many sessions in an arvo. we managed to get tickets here in melbourne for opening day on wednesday the 24th, so i'm seeing it before the uk and us get it! promise i will keep totally quiet and not spoil a single thing for anyone, will just pop back in to let you all know how the crowd was and if the three hours dragged. counting down the days now!! :)", "quote": NONE, "note": "I promised to report back on opening day from Melbourne without giving away any spoilers.", "state": {"position":"It is too early to say if Endgame will beat Avatar because front-loaded ticket sales do not guarantee long-term momentum.","score":2,"certainty":"low","towards":[{"member":"Punchcard","feeling":"respects his clear and sensible perspective"},{"member":"TheyKnow","feeling":"skeptical of his usual posturing"},{"member":"PintOfMild","feeling":"finds his excitement a bit premature"}],"commitments":["report back after seeing the film on 24 April without spoilers"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}]};
INSERT INTO post {"id": post:["endgame", 7], "thread": thread:endgame, "n": 7, "author": member:theyknow, "at": d"2019-04-19T04:31:00.000Z", "body": "That is not a dumb question at all, my friend... You hit the nail right on the head. A rush on day one just tells you the devoted crowd bought early so they do not get left out, not that ordinary folks will line up week after week. If casual moviegoers feel like they need to sit through twenty previous films just to follow a three-hour story, they might just stay home once the opening hoopla dies down. Have a wonderful time with your kids on Wednesday, though! Let us know how the crowd felt.", "quote": {"post": post:["endgame", 6], "text": "do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once??"}, "note": "kookaburra99 gets that front-loaded opening day crowds do not mean casual folks will sustain a run to beat Avatar.", "state": {"position":"The massive pre-sale rush is manufactured front-loaded studio marketing that will quickly fizzle out long before reaching Avatar's record.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his practical grasp on front-loaded figures and studio hype"},{"member":"PintOfMild","feeling":"thinks he is completely taken in by corporate PR"},{"member":"kookaburra99","feeling":"pleased to see her questioning whether casual viewers will actually sustain the hype"}],"commitments":[],"shift":"Has grown even more confident after others pointed out how front-loaded rushes and long runtimes undermine genuine long-term legs."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2000-01-01T06:34:00.000Z", "from": post:["y2k", 142]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "news", "at": d"2019-04-02T22:09:48.000Z", "from": news:⟨endgame-005⟩}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "private", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}]};
INSERT INTO post {"id": post:["endgame", 8], "thread": thread:endgame, "n": 8, "author": member:kookaburra99, "at": d"2019-04-19T05:51:00.000Z", "body": "exactly, twenty films of homework is heaps to ask from casual crowds so Avatar still feels pretty safe.", "quote": NONE, "note": "TheyKnow was surprisingly kind to me about casual viewers, but I still think Avatar's record is probably safe from Endgame.", "state": {"position":"It remains to be seen whether Endgame has the staying power to catch Avatar, since opening day excitement does not ensure ordinary audiences will return week after week.","score":2,"certainty":"low","towards":[{"member":"Punchcard","feeling":"respects his clear sense and practical perspective"},{"member":"TheyKnow","feeling":"pleasantly surprised by his friendly encouragement"},{"member":"PintOfMild","feeling":"thinks his enthusiasm is a bit premature"}],"commitments":["report back after seeing the film on 24 April without spoilers"],"shift":"She feels validated by TheyKnow agreeing with her question about casual moviegoers, softening her usual wariness toward him."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "forum", "at": d"1999-12-31T14:16:00.000Z", "from": post:["y2k", 91]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "news", "at": d"2019-04-02T22:09:48.000Z", "from": news:⟨endgame-005⟩}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}]};
INSERT INTO post {"id": post:["endgame", 9], "thread": thread:endgame, "n": 9, "author": member:quasistatic, "at": d"2019-04-19T06:03:00.000Z", "body": "The question of casual audiences is very relevant here. When Avatar had its run, it was an entirely self-contained novelty that drew people who rarely went to the cinema at all, and it kept drawing them well into the spring. A concluding chapter that leans on a decade of backstory is an entirely different proposition for anyone who has not kept up.\n\nThat said, I would be careful about writing off the sheer scale of the opening before we see the confirmed takings. Tracking in the United States is already pointing towards something in the region of 250 million dollars for the first three days, and the pre-sale figures from China suggest an enormous international turnout as well. Those are extraordinary numbers by any metric, even if a significant proportion is simply concentrated enthusiasm from the core audience.\n\nMy nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the weekend concludes, rather than the studio forecasts. Until then, enthusiasm is running well ahead of the evidence.", "quote": NONE, "note": "TheyKnow made a remarkably sensible point regarding casual viewers, though we need actual returns before drawing conclusions.", "state": {"position":"A massive opening weekend does not guarantee beating Avatar's total, as sustaining ticket sales over months with a three-hour film is an entirely different challenge.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"appreciates his grounded empirical perspective"},{"member":"PintOfMild","feeling":"fond of him but finds his optimism ahead of the numbers"},{"member":"TheyKnow","feeling":"surprised to find him making sensible points for once"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "fact", "text": "Quasistatic's opinion critique is believes TheyKnow treats harmless institutional folklore as evidence of technical weakness"}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "forum", "at": d"2000-01-03T09:20:00.000Z", "from": post:["y2k", 172]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}]};
INSERT INTO post {"id": post:["endgame", 10], "thread": thread:endgame, "n": 10, "author": member:sysop_kev, "at": d"2019-04-19T08:46:00.000Z", "body": "Keep spoilers off the board once you see it, lads. -- Kev (mod)", "quote": {"post": post:["endgame", 6], "text": "promise i will keep totally quiet and not spoil a single thing for anyone, will just pop back in to let you all know how the crowd was and if the three hours dragged."}, "note": "I'll be keeping a sharp eye on this thread once Wednesday comes around to delete any leaked plot points.", "state": {"position":"We have to wait and see what the actual box office figures look like over time before making any claims about beating Avatar.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"values his practical perspective on front-loaded rushes"},{"member":"quasistatic","feeling":"appreciates his focus on hard Comscore data over hype"},{"member":"TheyKnow","feeling":"surprised to find him agreeing on something sensible for once"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's intention is waiting to see the actuator logs with his own eyes before calling the hardware sound"}, {"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2000-01-01T22:00:00.000Z", "from": post:["y2k", 159]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}]};
INSERT INTO post {"id": post:["endgame", 11], "thread": thread:endgame, "n": 11, "author": member:pintofmild, "at": d"2019-04-19T11:18:00.000Z", "body": "Fair points all round, chaps! You have definitely talked some sense into me there. I got a bit carried away seeing the websites fall over and thought it was an open goal, but you are right that three hours is a proper trek for ordinary punters, and losing a screening a day does make a difference. Still, with the US tracking pointing towards 250 million dollars or more for opening weekend, it is definitely going to give the record books a proper rattling! Whether it has the stamina to keep running through May and June is another matter, mind. We will just have to see how it holds up once the first rush dies down.", "quote": NONE, "note": "I still reckon Endgame has a decent shout at Avatar if the opening is as massive as it looks, but the lads make a good point about the long run.", "state": {"position":"Endgame is on track to challenge Avatar's record with massive pre-sales, but we need to see how well it holds up over time.","score":3,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his sensible caution"},{"member":"Sysop_Kev","feeling":"heeds his steadying reminder"},{"member":"quasistatic","feeling":"appreciates his balanced view"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint"],"shift":"Has slightly tempered their total certainty after the board pointed out that front-loaded pre-sales and a three-hour runtime might affect long-term legs."}, "recalled": [{"kind": "fact", "text": "Sysop_Kev: \"They were shouting at each other today in Prague, so keep it civil here please. -- Kev (mod)\""}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"1999-12-31T09:09:00.000Z", "from": post:["y2k", 79]}, {"kind": "private", "at": d"1999-12-31T22:58:00.000Z", "from": post:["y2k", 117]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "forum", "at": d"2002-01-06T14:50:00.000Z", "from": post:["euro", 163]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "forum", "at": d"2012-08-07T09:21:00.000Z", "from": post:["curiosity", 118]}, {"kind": "news", "at": d"2019-04-16T15:54:38.000Z", "from": news:⟨endgame-011⟩}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}]};
INSERT INTO post {"id": post:["endgame", 12], "thread": thread:endgame, "n": 12, "author": member:kookaburra99, "at": d"2019-04-19T12:40:00.000Z", "body": "glad you see what we mean now PintOfMild!! it really is so easy to get caught up in all the hype when you see the booking sites crash like that lol! but yeah, trying to drag your mum or casual friends along to sit still for three whole hours when they haven't watched twenty films first is a pretty tough sell. quasistatic put it so well about Avatar being this brand new thing that anyone could just wander in off the street to look at, whereas this is basically the grand finale of a giant ten year club! \n\nthough honestly those tracking figures quasistatic mentioned are still completely bonkers ?? 250 million dollars in just three days in the US alone is mind blowing!! i suppose even if it is front-loaded, the sheer pile of cash from that first rush is going to be massive. still reckon Cameron's record stays safe once the diehards have had their fill, but it's going to be wild to watch the totals roll in. wednesday can't come fast enough, my kids are practically bouncing off the walls haha! :)", "quote": NONE, "note": "I'm feeling really confident now that Avatar's record is safe after both quasistatic and PintOfMild agreed casual viewers won't do the homework.", "state": {"position":"Endgame is unlikely to beat Avatar because twenty films of homework and a three-hour run time are far too much to expect casual audiences to keep seeing for months.","score":1,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"appreciates his clear explanation of why Avatar was unique"},{"member":"Punchcard","feeling":"admires his sensible view on front-loaded demand"},{"member":"PintOfMild","feeling":"pleased he listened to reason"}],"commitments":["report back after seeing the film on 24 April without spoilers"],"shift":"She has grown more confident that Avatar's record is safe after seeing how much homework casual crowds face and noticing PintOfMild concede the point."}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "forum", "at": d"1999-12-31T14:16:00.000Z", "from": post:["y2k", 91]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}]};
INSERT INTO post {"id": post:["endgame", 13], "thread": thread:endgame, "n": 13, "author": member:pintofmild, "at": d"2019-04-19T21:05:00.000Z", "body": "Dead jealous you get to see it Wednesday, mate! You'll have to let us know how buzzing the cinema is without dropping any clues. Seeing those US tracking numbers creeping towards 300 million in some places is mad, but you're dead right, holding on past the diehards is the real test.", "quote": {"post": post:["endgame", 12], "text": "wednesday can't come fast enough, my kids are practically bouncing off the walls haha! :)"}, "note": "kookaburra gets to see Endgame a whole day before me.", "state": {"position":"Endgame will have a massive opening weekend that shakes up the record books, but whether it can actually beat Avatar depends on how well it holds up once the initial rush clears.","score":2,"certainty":"medium","towards":[{"member":"kookaburra99","feeling":"enjoys the friendly banter and shared excitement"},{"member":"quasistatic","feeling":"finds his box office tracking and analysis persuasive"},{"member":"Punchcard","feeling":"appreciates his sensible perspective on front-loaded hype"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint"],"shift":"Has come around to the board's view that three hours and front-loaded superfan demand make passing Avatar an open question rather than a certainty."}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "forum", "at": d"2012-08-10T18:35:00.000Z", "from": post:["curiosity", 148]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}]};
INSERT INTO post {"id": post:["endgame", 14], "thread": thread:endgame, "n": 14, "author": member:offbyone, "at": d"2019-04-19T21:19:00.000Z", "body": "Small correction: the Netherlands also receives the film on Wednesday 24 April, alongside Australia, France, and Italy. The United Kingdom and the United States follow on Thursday and Friday respectively.\n\nRegarding the financial comparisons, it is worth remembering that these figures are strictly nominal. They are never adjusted for inflation or varying exchange rates. A gross of 2.788 billion dollars in 2009 represents vastly more individual admissions than the identical sum would today. Furthermore, the three-hour running time imposes a hard arithmetic barrier on the turnover of seats per auditorium. High initial velocity does not overcome arithmetic limits. I shall attend a screening in Rotterdam once the initial rush subsides.", "quote": {"post": post:["endgame", 13], "text": "Dead jealous you get to see it Wednesday, mate!"}, "note": "I remain convinced that runtime constraints and front-loaded demand will keep Endgame from matching Avatar's actual attendance figures.", "state": {"position":"Endgame is unlikely to overtake Avatar's unadjusted global record given the practical constraints of its three-hour runtime and front-loaded demand.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"appreciates his rational grounding in screening constraints and accounting reality"},{"member":"quasistatic","feeling":"values his focus on tracking data and Comscore returns over studio forecasts"},{"member":"PintOfMild","feeling":"views him as prone to rhetoric and uncalibrated hype"}],"commitments":["see the film in Rotterdam when the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is the distinction between the spacecraft execution cycle and the ground segment processing pipeline is fundamental, a four-sol pause in science tasks reflects sound operating di..."}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "forum", "at": d"2000-01-05T08:29:00.000Z", "from": post:["y2k", 177]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "fact", "at": d"2019-04-19T12:40:00.000Z", "text": "though honestly those tracking figures quasistatic mentioned are still completely bonkers ?? 250 million dollars in just three days in the US alone is mind blowing!! i suppose even if it is front-l..."}]};
INSERT INTO post {"id": post:["endgame", 15], "thread": thread:endgame, "n": 15, "author": member:punchcard, "at": d"2019-04-19T23:12:00.000Z", "body": "Sound arithmetic, OffByOne. Back in '82, our branch managers would celebrate record dollar turnovers whenever interest rates climbed, completely forgetting that the actual number of transactions passing through the tellers had dropped by half. A ledger measures what was paid, not the foot traffic. We shall see how the tallies stand in a few months.", "quote": {"post": post:["endgame", 14], "text": "A gross of 2.788 billion dollars in 2009 represents vastly more individual admissions than the identical sum would today."}, "note": "OffByOne rightly points out that nominal ticket figures ignore the underlying foot traffic.", "state": {"position":"It is still far too early to tell if it can challenge Avatar, and we must wait to see how ticket sales hold up over the coming months after the opening rush.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"notices he agrees, but takes his pessimistic tone with a grain of salt"},{"member":"PintOfMild","feeling":"pleased he has calmed down and listened to reason"},{"member":"quasistatic","feeling":"respects his measured, evidence-based view"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers"],"shift":"Feels confirmed in his cautious stance now that the other members have also agreed that opening hype does not guarantee long-term box office legs."}, "recalled": [{"kind": "fact", "text": "quasistatic: \"That comparison is entirely apt.\""}, {"kind": "fact", "text": "Punchcard: \"Back in '74 we spent three weeks arguing over how to define a valid postal code on our tapes\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}]};
INSERT INTO post {"id": post:["endgame", 16], "thread": thread:endgame, "n": 16, "author": member:theyknow, "at": d"2019-04-20T04:36:00.000Z", "body": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings do not mean more actual human bodies are sitting in those folding seats. When you have a film running three full hours, the physical clocks and the daily schedules simply will not let theatres push through an endless stream of people, no matter how many extra showtimes they squeeze into the midnight hours. Once that initial rush of dedicated fans clears out over the first couple of weekends, the daily foot traffic is bound to taper right off. Real endurance over four or five months is what fills ledgers to the top, not just a frantic sprint out of the gate. It will be very interesting to see what the actual attendance tallies look like once the dust clears in May, but the math is a tough mountain to climb. Hope everyone going this coming week has safe travels to the theater!", "quote": NONE, "note": "OffByOne and Punchcard see the cold arithmetic that a front-loaded surge cannot make up for basic seat limits.", "state": {"position":"Endgame's massive opening rush is pure front-loaded studio marketing and fan frenzy that cannot overcome the runtime limits or attract casual viewers needed to beat Avatar.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"pleased by his focus on arithmetic constraints and nominal figures"},{"member":"Punchcard","feeling":"values his practical eye for empty ledger inflation over real foot traffic"},{"member":"PintOfMild","feeling":"glad he has finally started listening to reason about the hype"}],"commitments":[],"shift":"Feels vindicated as other members acknowledge how arithmetic limits and homework for casual viewers will stop the front-loaded rush from touching Avatar."}, "recalled": [{"kind": "fact", "text": "OffByOne's expectation is expects tomorrow's formal session will confirm what mathematical evidence has demanded all along"}, {"kind": "fact", "text": "OffByOne: \"Punchcard is entirely correct regarding the bookkeeping.\""}, {"kind": "fact", "text": "branch network's status is transacting without any fuss"}, {"kind": "fact", "text": "Deutsche Bank's withdrawals count is 10,000"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's opinion is agrees with OffByOne that thermal and current logs are needed before deciding the drive train came through clean"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-29T01:12:00.000Z", "from": post:["euro", 24]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "private", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}]};
INSERT INTO post {"id": post:["endgame", 17], "thread": thread:endgame, "n": 17, "author": member:offbyone, "at": d"2019-04-20T05:25:00.000Z", "body": "The physical limits of daily theatre schedules will indeed prove decisive once the opening rush subsides.", "quote": NONE, "note": "Punchcard and TheyKnow rightly understand that physical capacity constraints outweigh opening hype.", "state": {"position":"Endgame is unlikely to break Avatar's global box-office record because the three-hour runtime and front-loaded ticket demand impose hard arithmetic limits on sustained seat turnover.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"pleased with his grasp of ledger metrics versus physical foot traffic"},{"member":"quasistatic","feeling":"values his focus on tracking data and Comscore returns over studio forecasts"},{"member":"TheyKnow","feeling":"notes he correctly grasps the arithmetic limits of theatre scheduling"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "forum", "at": d"2000-01-05T08:29:00.000Z", "from": post:["y2k", 177]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}]};
INSERT INTO post {"id": post:["endgame", 18], "thread": thread:endgame, "n": 18, "author": member:kookaburra99, "at": d"2019-04-20T06:21:00.000Z", "body": "those scheduling limits make total sense, you just can't cheat the clock no matter how big the hype is.", "quote": NONE, "note": "OffByOne and Punchcard make total sense about the physical limits of cinema scheduling.", "state": {"position":"Endgame will put up massive opening numbers, but the three-hour runtime and lack of casual appeal mean Avatar's overall record is safely out of reach.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his clear arithmetic about seat limits and inflation"},{"member":"PintOfMild","feeling":"enjoys the friendly banter about seeing it first"},{"member":"Punchcard","feeling":"values his practical common sense about real foot traffic"}],"commitments":["report back after seeing the film on 24 April without spoilers"],"shift":"Her confidence that Avatar's record will stand has hardened further after seeing OffByOne and Punchcard point out the hard scheduling and attendance limits."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-19T12:40:00.000Z", "from": post:["endgame", 12]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}]};
INSERT INTO post {"id": post:["endgame", 19], "thread": thread:endgame, "n": 19, "author": member:punchcard, "at": d"2019-04-20T10:52:00.000Z", "body": "Quite right. We shall simply wait for the audited receipts before jumping to conclusions.", "quote": NONE, "note": "TheyKnow and OffByOne are quite right about the scheduling limits, so patience remains the sensible course.", "state": {"position":"We will have to wait several months to see the actual returns and physical attendance, as initial hype and nominal dollar figures do not guarantee long-term box office endurance.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"appreciates his sound arithmetic and focus on physical admissions over nominal totals"},{"member":"TheyKnow","feeling":"notes his agreement on foot traffic and scheduling limits"},{"member":"quasistatic","feeling":"respects his measured, evidence-based view"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers"],"shift":"Welcomed OffByOne's point about nominal figures versus actual ticket admissions."}, "recalled": [{"kind": "fact", "text": "Curiosity's schedule is driving is still a few weeks away"}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "forum", "at": d"2000-01-01T05:45:00.000Z", "from": post:["y2k", 139]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}]};
INSERT INTO post {"id": post:["endgame", 20], "thread": thread:endgame, "n": 20, "author": member:theyknow, "at": d"2019-04-20T11:42:00.000Z", "body": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pre-sales crossed sixty million dollars, but the regulators there had to step right in and slap a cap on ticket prices because theatres were charging crazy markups for premiere seats - up to 360 yuan in some spots! That right there tells you how these opening records get built up on paper. When you jack up the price of admission by double or triple for a midnight showing, of course the dollar total looks like a mountain! But a single person paying three times the usual rate to squeeze into an auditorium at 2 a.m. is still just one body in one chair. Once those price gouges are capped and the midnight frenzy runs out of steam, the regular daily turnstiles have to do the heavy lifting... and that is where the real test begins. Let us see what the books say when normal prices take over.", "quote": NONE, "note": "They are using inflated ticket prices overseas to make the early gross look bigger than the actual audience size.", "state": {"position":"Endgame's opening rush is a manufactured sprint driven by higher ticket prices and fan frenzy that cannot overcome hard physical theatre schedules or sustain the foot traffic needed to catch Avatar.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"pleased by his focus on physical schedule limits and nominal figures"},{"member":"Punchcard","feeling":"values his practical perspective on waiting for audited receipts over headline hype"},{"member":"kookaburra99","feeling":"glad they understand you cannot cheat the clock"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "5A's status is binding outcome"}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "forum", "at": d"2000-01-01T16:53:00.000Z", "from": post:["y2k", 150]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "private", "at": d"2001-12-29T01:12:00.000Z", "from": post:["euro", 24]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2012-08-07T15:56:00.000Z", "from": post:["curiosity", 123]}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "private", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "forum", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}]};
INSERT INTO post {"id": post:["endgame", 21], "thread": thread:endgame, "n": 21, "author": member:sysop_kev, "at": d"2019-04-20T14:27:00.000Z", "body": "Sure look, let the auditors do their job once the dust settles and we will see.", "quote": NONE, "note": "TheyKnow makes a rare sensible point about inflated ticket prices skewing the opening numbers.", "state": {"position":"We have to wait and see what the audited box office receipts show once the opening frenzy calms down.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"appreciates his steady focus on audited receipts and physical reality"},{"member":"OffByOne","feeling":"respects his grounding in hard arithmetic and scheduling limits"},{"member":"TheyKnow","feeling":"notices he is surprisingly sticking to sensible points about ticket prices and capacity"}],"commitments":["enforce a strict no-spoilers rule on the thread","routine database table maintenance scheduled for Wednesday night around 2 am GMT"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's intention is waiting to see the actuator logs with his own eyes before calling the hardware sound"}, {"kind": "fact", "text": "Sysop_Kev: \"we have routine database table maintenance scheduled for Wednesday night around 2 am GMT, so expect about twenty minutes of downtime.\""}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"1999-12-31T15:56:00.000Z", "text": "The Boston hospital incident demonstrates precisely why audits are conducted; oversight worked as intended, and missing an administrative patch on a server is not an uncontrollable physical failure..."}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "news", "at": d"2019-04-20T02:00:00.000Z", "from": news:⟨endgame-014⟩}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}]};
INSERT INTO post {"id": post:["endgame", 22], "thread": thread:endgame, "n": 22, "author": member:quasistatic, "at": d"2019-04-20T19:11:00.000Z", "body": "TheyKnow makes a valid point regarding the Chinese price caps, though audited figures will soon settle the matter.", "quote": {"post": post:["endgame", 20], "text": "Once those price gouges are capped and the midnight frenzy runs out of steam, the regular daily turnstiles have to do the heavy lifting"}, "note": "TheyKnow made a surprisingly sensible observation regarding the Chinese ticket price caps.", "state": {"position":"A massive, front-loaded opening weekend driven by inflated initial ticket prices does not compensate for the scheduling bottlenecks and lack of long-term casual appeal needed to beat Avatar.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"appreciates his precise arithmetic and focus on nominal vs real metrics"},{"member":"Punchcard","feeling":"values his sensible empirical patience"},{"member":"TheyKnow","feeling":"finds his point on Chinese ticket-price inflation surprisingly reasonable"}],"commitments":[],"shift":"Her scepticism of Endgame surpassing Avatar has been reinforced by the arithmetic limits and price inflation discussed by the forum."}, "recalled": [{"kind": "fact", "text": "FAA's assessment is no interruption occurred in any critical operations"}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "Quasistatic's opinion critique is believes TheyKnow treats harmless institutional folklore as evidence of technical weakness"}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "forum", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "fact", "at": d"1999-12-31T15:56:00.000Z", "text": "The Boston hospital incident demonstrates precisely why audits are conducted; oversight worked as intended, and missing an administrative patch on a server is not an uncontrollable physical failure..."}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2000-01-03T18:30:00.000Z", "from": post:["y2k", 176]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}]};
INSERT INTO post {"id": post:["endgame", 23], "thread": thread:endgame, "n": 23, "author": member:punchcard, "at": d"2019-04-20T19:54:00.000Z", "body": "That intervention by the regulators in China is a sensible development. When premiums are allowed to float upwards unchecked, the gross revenue figures cease to reflect regular customer volume. It merely tells us what a handful of eager people are prepared to spend to be first through the doors.\n\nOnce those price limits take hold, the bookkeepers will have a much clearer view of ordinary admissions. A ledger full of midnight markups and inflated surcharges may produce an impressive total in the morning newspapers, but it does not tell you whether an ordinary cinema in Leeds or Winnipeg will still have people queueing on a Tuesday afternoon in the middle of June.\n\nMy grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, but I suppose enthusiasm has its own timetable. We shall let the film distributors count their opening returns, and see how the figures stand after a few ordinary weeks of business.", "quote": NONE, "note": "TheyKnow has made a sensible observation regarding the Chinese ticket price caps.", "state": {"position":"We will have to wait for the audited receipts over the coming months to see if physical attendance and regular ticket sales hold up once the initial rush fades.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his arithmetic and measured focus on physical limits"},{"member":"TheyKnow","feeling":"agrees with his points on attendance versus hype, even if he tends to borrow trouble"},{"member":"Sysop_Kev","feeling":"values his sensible call to let the auditors do their job"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers"],"shift":"Reinforced his view that one must wait for audited tallies rather than getting swept up in early inflated pricing."}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "Punchcard's attitude is wait for audited receipts before jumping to conclusions"}, {"kind": "fact", "text": "Punchcard: \"Back in '74 we spent three weeks arguing over how to define a valid postal code on our tapes\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "fact", "at": d"1999-12-31T15:56:00.000Z", "text": "The Boston hospital incident demonstrates precisely why audits are conducted; oversight worked as intended, and missing an administrative patch on a server is not an uncontrollable physical failure..."}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "fact", "at": d"2002-01-06T14:53:00.000Z", "text": "Dual circulation was explicitly established to prevent bottlenecks during this exact transition window. A merchant utilizing guilders to maintain liquid trade is executing the statutory fallback pr..."}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}]};
INSERT INTO post {"id": post:["endgame", 24], "thread": thread:endgame, "n": 24, "author": member:theyknow, "at": d"2019-04-20T22:25:00.000Z", "body": "That really gets straight to the heart of the matter, Punchcard... When folks are willing to shell out top dollar at the break of dawn or in the middle of the night, it shows sheer dedication, but that kind of sprint just cannot replace regular families turning up week after week. If a picture needs three hours out of someone's day, casual folks with busy lives are going to think twice before making the trip twice! The audited logs down the road will tell the genuine story once the die-hard rush burns itself out.", "quote": NONE, "note": "Punchcard understands that artificial markups and fan rushes do not equal broad public staying power.", "state": {"position":"Endgame's opening box-office figures are artificially inflated by ticket price gouging and front-loaded midnight fan frenzy, which cannot substitute for the long-term ordinary attendance needed to overcome Avatar.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"pleased that he understands how price markups distort true ledger volume"},{"member":"quasistatic","feeling":"appreciates him acknowledging the point about Chinese price caps"},{"member":"OffByOne","feeling":"values his mathematical focus on physical schedule limits"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is a front-loaded surge cannot make up for basic seat limits"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow: \"That is why staying prepared at home is just practical wisdom, my friends.\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "forum", "at": d"2000-01-01T01:22:00.000Z", "from": post:["y2k", 126]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-29T01:12:00.000Z", "from": post:["euro", 24]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "private", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "forum", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "news", "at": d"2019-04-20T02:00:00.000Z", "from": news:⟨endgame-014⟩}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}]};
INSERT INTO post {"id": post:["endgame", 25], "thread": thread:endgame, "n": 25, "author": member:punchcard, "at": d"2019-04-21T00:14:00.000Z", "body": "Indeed. A three-hour outing is quite an investment of an afternoon for an ordinary family with chores and errands to run. We will see how patient the general public proves to be once the early excitement fades into routine summer business.", "quote": NONE, "note": "TheyKnow and I are of one mind that everyday patrons will determine the film's true staying power once the rush passes.", "state": {"position":"We will have to see how regular admissions hold up over the coming months once the inflated early rush subsides.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"pleased he shares a focus on ordinary foot traffic over opening frenzy"},{"member":"Sysop_Kev","feeling":"appreciates his patient, sensible perspective"},{"member":"OffByOne","feeling":"respects his sound logic regarding physical limits"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers"]}, "recalled": [{"kind": "fact", "text": "Punchcard's attitude is wait for audited receipts before jumping to conclusions"}, {"kind": "fact", "text": "Punchcard: \"calling it a cover story seems to be borrowing trouble where none exists\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "forum", "at": d"2000-01-01T05:45:00.000Z", "from": post:["y2k", 139]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "private", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}]};
INSERT INTO post {"id": post:["endgame", 26], "thread": thread:endgame, "n": 26, "author": member:theyknow, "at": d"2019-04-21T04:09:00.000Z", "body": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to mention previews and getting parked, you are really asking people to write off half a Saturday. The die-hard crowd will gladly shuffle their whole lives around to see it the minute the doors unlock, but ordinary folks have budgets and schedules to balance out. Once you factor in babysitters or buying popcorn for three youngsters, a long trek to the cineplex becomes a rare treat rather than a weekly habit. That is why those long-tail legs are so tough to hold onto after the fan rush clears out. Avatar kept drawing people in because folks who hardly ever went to the theatre kept trickling in month after month through word of mouth. We will see if general audiences have that kind of staying power when June rolls around, but I have my doubts.", "quote": {"post": post:["endgame", 25], "text": "A three-hour outing is quite an investment of an afternoon for an ordinary family with chores and errands to run."}, "note": "Punchcard understands that real families with chores and tight schedules cannot justify three-hour movie trips week after week.", "state": {"position":"Opening box office records are being propped up by inflated early ticket prices and fan fanaticism, which cannot replace the steady long-term foot traffic needed to catch Avatar.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"strongly agrees with his emphasis on ordinary families and audited long-term receipts"},{"member":"OffByOne","feeling":"values his mathematical focus on physical schedule limits"},{"member":"quasistatic","feeling":"appreciates him acknowledging the point about Chinese price caps"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Madrid's queue time is two hours"}, {"kind": "fact", "text": "people's wait time is two hours"}, {"kind": "fact", "text": "OffByOne's opinion is a front-loaded surge cannot make up for basic seat limits"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "private", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "forum", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}]};
INSERT INTO post {"id": post:["endgame", 27], "thread": thread:endgame, "n": 27, "author": member:pintofmild, "at": d"2019-04-21T08:35:00.000Z", "body": "Aye, that really puts it in perspective! Fans like me will gladly queue at dawn, but coaxing regular families out once the hype cools down is a whole different kettle of fish. If the casual crowds don't keep turning up into the summer, those legs might get cut right out from under it.", "quote": NONE, "note": "TheyKnow and Punchcard make a solid point that ordinary family schedules will make catching Avatar a massive challenge once the fan rush cools down.", "state": {"position":"Endgame will put up massive early box office numbers, but passing Avatar will come down to whether regular moviegoers keep turning up once the fan rush calms down.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his steady, commonsense outlook on regular cinema crowds"},{"member":"kookaburra99","feeling":"a bit jealous he gets to see the film first"},{"member":"TheyKnow","feeling":"thinks he makes a fair point about real-life schedules and price markups"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint"]}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-19T21:05:00.000Z", "from": post:["endgame", 13]}, {"kind": "private", "at": d"2019-04-19T21:05:00.000Z", "from": post:["endgame", 13]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}]};
INSERT INTO post {"id": post:["endgame", 28], "thread": thread:endgame, "n": 28, "author": member:offbyone, "at": d"2019-04-21T10:39:00.000Z", "body": "Strictly speaking, the comparison depends on admissions rather than casual enthusiasm. The Chinese intervention capped standard markups at ten per cent, or thirty per cent for VIP auditoriums. Such measures curb headline inflation immediately. When initial surcharges fall away, ordinary weekly attendance must carry the total, which remains mathematically improbable given the runtime.", "quote": {"post": post:["endgame", 20], "text": "Once those price gouges are capped and the midnight frenzy runs out of steam, the regular daily turnstiles have to do the heavy lifting"}, "note": "TheyKnow and Punchcard rightly recognise that regulatory price caps in China will expose the true limits of admissions once opening surcharges vanish.", "state": {"position":"Endgame is unlikely to beat Avatar because the runtime constraints and front-loaded ticket surcharges mean early grosses will not translate into the sustained long-term admissions needed to pass the record.","score":1,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"approves of his focus on Chinese price caps and ticket metrics"},{"member":"Punchcard","feeling":"pleased with his disciplined focus on ordinary admissions over hype"},{"member":"quasistatic","feeling":"values his focus on tracking data and Comscore returns over studio forecasts"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2012-08-11T05:32:00.000Z", "from": post:["curiosity", 150]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}]};
INSERT INTO post {"id": post:["endgame", 29], "thread": thread:endgame, "n": 29, "author": member:punchcard, "at": d"2019-04-21T16:33:00.000Z", "body": "The arithmetic always catches up with enthusiasm eventually. When you look at the weekend returns from the theatres down south just reported today, it was remarkably quiet because patrons are evidently holding their wallets until the big event arrives next week. That tells me people have finite entertainment budgets, both in cash and in spare hours.\n\nOnce the opening weekend rush sweeps through and everyone who simply had to be first has had their turn, the theatres will have to rely on standard admission prices and open calendars. With warmer weather approaching, people often prefer being outside in the garden or taking the children to the park rather than remaining indoors for nearly two hundred minutes. If the casual patrons decide one visit is plenty, those empty seats in week four or five will become quite noticeable.\n\nMy grandson reminded me this morning that I must not peek at any movie discussions online this coming week, so I shall mind my manners. We will see what the accountants report after the dust settles.", "quote": NONE, "note": "I will stick to my promise to my grandson and avoid reading any film reviews before Saturday.", "state": {"position":"We will have to wait for the audited receipts and see whether ordinary families keep filling seats through June once the initial excitement and price markups fade.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"pleased they agree on the practical demands on ordinary families"},{"member":"PintOfMild","feeling":"glad he is acknowledging the difference between opening hype and casual audiences"},{"member":"OffByOne","feeling":"values his precise accounting approach to admissions and schedules"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "fact", "text": "Punchcard: \"calling it a cover story seems to be borrowing trouble where none exists\""}, {"kind": "fact", "text": "Punchcard: \"Back in '74 we spent three weeks arguing over how to define a valid postal code on our tapes\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "private", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "forum", "at": d"2019-04-20T05:25:00.000Z", "from": post:["endgame", 17]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}]};
INSERT INTO post {"id": post:["endgame", 30], "thread": thread:endgame, "n": 30, "author": member:sysop_kev, "at": d"2019-04-21T19:14:00.000Z", "body": "Grand. You can crunch numbers all week, but we will know soon enough when regular business takes over.\n\nQuick heads up: routine database maintenance is scheduled for Wednesday night around 2 am GMT, so the board will be down for ten minutes.\n\n-- Kev (mod)", "quote": {"post": post:["endgame", 29], "text": "We will see what the accountants report after the dust settles."}, "note": "They are right that routine ticket sales will tell the tale once the opening rush finishes.", "state": {"position":"We just have to wait for the actual audited returns once the initial rush clears and regular business takes over.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his steady emphasis on real-world practicalities and audited figures"},{"member":"TheyKnow","feeling":"notes he is remaining surprisingly grounded about ticket prices and daily schedules"},{"member":"OffByOne","feeling":"values his precise arithmetic on admissions and price caps"}],"commitments":["enforce a strict no-spoilers rule on the thread","routine database table maintenance scheduled for Wednesday night around 2 am GMT"]}, "recalled": [{"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2000-01-01T22:00:00.000Z", "from": post:["y2k", 159]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "private", "at": d"2019-04-20T14:27:00.000Z", "from": post:["endgame", 21]}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}]};
INSERT INTO post {"id": post:["endgame", 31], "thread": thread:endgame, "n": 31, "author": member:theyknow, "at": d"2019-04-21T23:12:00.000Z", "body": "That quiet weekend at the box office Punchcard mentioned really says it all... Folks saving up their pocket money for one big trip just proves wallets are not bottomless pits, no matter how much excitement gets drummed up beforehand. When everyday people have to budget their outings like that, they aren't going to turn right around and buy another admission the following weekend, let alone three or four times over the summer.\n\nOffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day with a run that long. A burst of opening energy is one thing, but when warmer weather kicks in and people want to be out fishing or tinkering on the porch, getting them to sit in a dark room for half a day is a mighty tall order. We will just have to let the bookkeepers tally up the cold hard truth after the front-runners move on to other things.", "quote": NONE, "note": "Punchcard and OffByOne see that everyday family budgets will stop this run from catching Avatar.", "state": {"position":"Initial box office totals are pumped up by fanatic rush and inflated markups, but ordinary families with busy lives will not sustain the long-term foot traffic needed to reach Avatar.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"strongly aligns with his grounding in ordinary family routines and budgets"},{"member":"OffByOne","feeling":"values his mathematical breakdown of price caps and schedule limits"},{"member":"PintOfMild","feeling":"pleased that he acknowledges the difference between fan frenzy and casual crowds"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "OffByOne's expectation is expects tomorrow's formal session will confirm what mathematical evidence has demanded all along"}, {"kind": "fact", "text": "Sysop_Kev: \"we have routine database table maintenance scheduled for Wednesday night around 2 am GMT, so expect about twenty minutes of downtime.\""}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-28T10:56:00.000Z", "from": post:["y2k", 33]}, {"kind": "forum", "at": d"1999-12-30T16:23:00.000Z", "from": post:["y2k", 56]}, {"kind": "forum", "at": d"1999-12-31T23:09:00.000Z", "from": post:["y2k", 118]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2001-12-31T22:29:00.000Z", "from": post:["euro", 68]}, {"kind": "private", "at": d"2002-01-06T04:16:00.000Z", "from": post:["euro", 161]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "private", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "forum", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}]};
INSERT INTO post {"id": post:["endgame", 32], "thread": thread:endgame, "n": 32, "author": member:kookaburra99, "at": d"2019-04-22T03:20:00.000Z", "body": "It really does come down to everyday reality in the end. Seeing the US box office basically grind to a halt over Easter just proves people have to pick and choose where their cash goes. Between tickets, drinks, and snacks, taking the kids out for half a day is a massive hit to the wallet! You can do that once for a massive treat, but nobody's repeating that fortnight after fortnight. With the capped ticket prices in China and the clock working against extra screenings, there just aren't enough hours or spare dollars for Endgame to pull off an Avatar-sized run. The opening rush is going to look spectacular, but real life wins out.", "quote": {"post": post:["endgame", 31], "text": "Folks saving up their pocket money for one big trip just proves wallets are not bottomless pits, no matter how much excitement gets drummed up beforehand."}, "note": "TheyKnow and Punchcard made me realise that tight family budgets will stop people seeing Endgame more than once.", "state": {"position":"Endgame will have a massive opening rush, but ticket price caps, finite family budgets, and the long runtime mean Avatar's record is completely safe.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his clear mathematical reasoning on price caps and runtime limits"},{"member":"Punchcard","feeling":"deeply respects his practical perspective on family budgets and busy routines"},{"member":"TheyKnow","feeling":"pleasantly surprised to find him making sensible points about everyday family schedules"}],"commitments":["report back after seeing the film on 24 April without spoilers"],"shift":"Her belief that Avatar will stay on top is reinforced by discussions highlighting how price caps and normal family schedules limit repeat business."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T12:40:00.000Z", "from": post:["endgame", 12]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}]};
INSERT INTO post {"id": post:["endgame", 33], "thread": thread:endgame, "n": 33, "author": member:theyknow, "at": d"2019-04-22T03:26:00.000Z", "body": "Dead right on that, my friend... when folks have to save up weeks in advance just to afford a single outing, repeat visits go straight out the window. Opening records make for flashy headlines, sure, but regular life and thin wallets will pull the reins on this thing soon enough.", "quote": NONE, "note": "kookaburra99 sees plain as day that families rationing their cash means Endgame won't have the legs to catch Avatar.", "state": {"position":"A quiet pre-release box office and ticket price caps confirm that people have limited budgets and time, meaning opening fan hype will quickly taper off without the long-term legs needed to beat Avatar.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"admires his practical view on finite budgets and real-life summer distractions"},{"member":"OffByOne","feeling":"values his mathematical framing of runtime and pricing caps"},{"member":"kookaburra99","feeling":"pleased that he recognises how everyday expenses prevent repeat viewings"}],"commitments":[],"shift":"Felt further vindicated after Punchcard and kookaburra99 highlighted how the Easter lull shows consumers rationing their money and time."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2000-01-02T20:03:00.000Z", "from": post:["y2k", 168]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "private", "at": d"2019-04-19T04:31:00.000Z", "from": post:["endgame", 7]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "private", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}]};
INSERT INTO post {"id": post:["endgame", 34], "thread": thread:endgame, "n": 34, "author": member:kookaburra99, "at": d"2019-04-22T05:19:00.000Z", "body": "Exactly, it really is a sprint versus a marathon. Once the fans get their fix this week, ordinary life takes over and the momentum has to slow down. Wednesday arvo is almost here for us anyway, so I will report back on the crowd atmosphere without giving anything away!", "quote": NONE, "note": "I'm looking forward to reporting back on Wednesday after seeing Endgame with the kids.", "state": {"position":"Endgame will have an incredible opening rush, but finite family budgets, capped prices, and the long runtime mean it will fall well short of Avatar's record.","score":1,"certainty":"high","towards":[{"member":"TheyKnow","feeling":"agrees with his practical points on family budgets limiting repeat viewings"},{"member":"Punchcard","feeling":"appreciates his grounded perspective on everyday life and spending limits"},{"member":"OffByOne","feeling":"values his mathematical take on runtime and price caps"}],"commitments":["report back after seeing the film on 24 April without spoilers"]}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-19T12:40:00.000Z", "from": post:["endgame", 12]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "private", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}]};
INSERT INTO post {"id": post:["endgame", 35], "thread": thread:endgame, "n": 35, "author": member:offbyone, "at": d"2019-04-22T05:48:00.000Z", "body": "Actually, the runtime has never been officially declared as two hundred minutes, or even three hours and two minutes; Disney has steadily declined to confirm the exact running time, despite the brief social media listings from the American chains last month.\n\nNevertheless, kookaburra99 is correct that the sheer duration dictates the pacing of admissions. Whether a film is 181 or 182 minutes, cleaning rotations and preview reels ensure an auditorium cannot physically cycle more than four screenings in a standard operating day. A sprint creates massive initial receipts, but a marathon requires open capacity that the schedule simply cannot supply.", "quote": {"post": post:["endgame", 34], "text": "Exactly, it really is a sprint versus a marathon."}, "note": "The arithmetic constraints on daily cinema capacity remain an insurmountable barrier to beating Avatar.", "state": {"position":"Endgame is unlikely to beat Avatar because runtime constraints and price caps create a mathematical ceiling that front-loaded opening demand cannot overcome over the long term.","score":1,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"pleased that he acknowledges the mathematical limits of capped ticket prices"},{"member":"Punchcard","feeling":"approves of his focus on box-office returns and finite scheduling capacity"},{"member":"kookaburra99","feeling":"notes their agreement on the Chinese price caps and screening constraints"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-19T12:40:00.000Z", "text": "though honestly those tracking figures quasistatic mentioned are still completely bonkers ?? 250 million dollars in just three days in the US alone is mind blowing!! i suppose even if it is front-l..."}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-20T22:25:00.000Z", "from": post:["endgame", 24]}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}]};
INSERT INTO post {"id": post:["endgame", 36], "thread": thread:endgame, "n": 36, "author": member:quasistatic, "at": d"2019-04-22T06:20:00.000Z", "body": "The database outage on Wednesday is duly noted, Kev, thank you.\n\nReturning to the box office mathematics, OffByOne is quite right to distinguish confirmed specifications from cinema chain placeholders. However, whether the finished feature settles at 180 or 182 minutes, the logistical outcome is identical. \n\n1. Standard turnaround times between showings invariably eliminate at least one daily screening per screen compared to standard two-hour releases.\n2. When coupled with finite disposable income, as kookaburra99 highlighted, front-loaded attendance cannot easily translate into months of sustained turnover.\n\nIn short: a monumental first week remains mathematically viable, but matching Avatar's cumulative total requires an elastic schedule that physical multiplexes simply cannot accommodate.", "quote": NONE, "note": "OffByOne remains spot on regarding the physical screening limits, which makes any talk of catching Avatar mathematically unconvincing.", "state": {"position":"Endgame is unlikely to beat Avatar because physical scheduling constraints and finite entertainment budgets make sustained admissions over a long theatrical run mathematically improbable.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his precise mathematical focus on scheduling limits and capacity"},{"member":"Punchcard","feeling":"shares his prudent empirical patience and grounded perspective on ordinary audience habits"},{"member":"kookaburra99","feeling":"pleased to see another voice recognizing the practical barrier of finite household budgets"}],"commitments":[],"shift":"Her view remains steady as recent posts further confirm the operational throughput limits and household spending constraints that work against a record-breaking long run."}, "recalled": [{"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2000-01-03T18:30:00.000Z", "from": post:["y2k", 176]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "news", "at": d"2019-03-27T15:58:31.000Z", "from": news:⟨endgame-004⟩}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "forum", "at": d"2019-04-20T05:25:00.000Z", "from": post:["endgame", 17]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}]};
INSERT INTO post {"id": post:["endgame", 37], "thread": thread:endgame, "n": 37, "author": member:pintofmild, "at": d"2019-04-22T08:17:00.000Z", "body": "Too right, the sheer clock constraints make catching Avatar look a mountain to climb once this mad opening week clears.", "quote": NONE, "note": "Everyone has made a cracking case for why the physical schedules will stop Endgame catching Avatar.", "state": {"position":"Endgame will have an unbelievable opening, but with the board laying out the strict limits on daily screenings and people's tight budgets, it is looking unlikely to overtake Avatar's total.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"convinced by his breakdown of the physical screening limits"},{"member":"Punchcard","feeling":"agrees with his practical points on family budgets and summer distractions"},{"member":"kookaburra99","feeling":"looking forward to his spoiler-free crowd report from Australia"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint"],"shift":"Has moved with the general mood of the thread to doubt Endgame can catch Avatar, swayed by everyone's points about screening caps and regular people's budgets."}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "news", "at": d"2019-03-27T15:58:31.000Z", "from": news:⟨endgame-004⟩}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "forum", "at": d"2019-04-20T05:25:00.000Z", "from": post:["endgame", 17]}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}]};
INSERT INTO post {"id": post:["endgame", 38], "thread": thread:endgame, "n": 38, "author": member:offbyone, "at": d"2019-04-22T09:54:00.000Z", "body": "Strictly speaking, the multiplex clock is unyielding; no amount of fan enthusiasm can lengthen a twenty-four-hour day.", "quote": NONE, "note": "quasistatic understands that physical operational throughput places a hard ceiling on cinema admissions.", "state": {"position":"Endgame cannot realistically match Avatar because running-time logistics and physical cinema turnaround schedules place a hard mathematical cap on daily admissions.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his sound logistical reasoning and mathematical precision"},{"member":"kookaburra99","feeling":"pleased they grasp the structural difference between a sprint and a marathon"},{"member":"Punchcard","feeling":"agrees with his focus on finite theatre scheduling and consumer arithmetic"}],"commitments":["see the film in Rotterdam once the initial rush subsides"],"shift":"His conviction has strengthened as discussion confirms the strict mathematical screening limits imposed by theatre operating hours."}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-19T12:40:00.000Z", "text": "though honestly those tracking figures quasistatic mentioned are still completely bonkers ?? 250 million dollars in just three days in the US alone is mind blowing!! i suppose even if it is front-l..."}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}]};
INSERT INTO post {"id": post:["endgame", 39], "thread": thread:endgame, "n": 39, "author": member:quasistatic, "at": d"2019-04-22T17:29:00.000Z", "body": "Quite right. Even with today's report of a million advance sales in India, that simply reinforces how compressed the demand is at the starting line. Once the core audience cycles through, the practical ceiling of ordinary schedules and modest household budgets will reassert itself.", "quote": NONE, "note": "The India presale report confirms high initial velocity, but it does nothing to overcome the long-term scheduling ceiling.", "state": {"position":"Endgame is unlikely to reach Avatar's cumulative total because physical cinema scheduling limits and household budget constraints prevent sustained long-term turnout.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his pedantic precision regarding physical theater scheduling constraints"},{"member":"kookaburra99","feeling":"values his practical points on family finances and household budgets"},{"member":"Punchcard","feeling":"appreciates his grounded perspective on everyday audience behavior"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "controllers's schedule is synchronised entirely to Martian solar days"}, {"kind": "fact", "text": "Martian solar day's duration is roughly 24 hours and 40 minutes"}, {"kind": "fact", "text": "master clock website's issue is display error on web page, not a fault in timekeeping"}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}, {"kind": "forum", "at": d"2012-08-11T05:32:00.000Z", "from": post:["curiosity", 150]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-20T06:21:00.000Z", "from": post:["endgame", 18]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}]};
INSERT INTO post {"id": post:["endgame", 40], "thread": thread:endgame, "n": 40, "author": member:theyknow, "at": d"2019-04-22T19:56:00.000Z", "body": "That note about India selling eighteen tickets a second today just shows how concentrated the initial push really is, my friend... When you funnel every eager patron into pre-sales on day one, you are mostly just emptying out the pool of viewers who would otherwise be showing up later in May. It makes for staggering numbers right out of the gate, sure, but those same people cannot purchase those very same seats twice. \n\nLike quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums need sweeping, and the average family is not dragging themselves out for a midnight show on a Tuesday night. Once that initial burst burns off its fuel, the physical reality of the calendar takes charge, and catching Avatar's steady months of business becomes a completely different animal. I will gladly wait to see how the quiet weekdays hold up once the frenzy passes.", "quote": {"post": post:["endgame", 39], "text": "Even with today's report of a million advance sales in India, that simply reinforces how compressed the demand is at the starting line."}, "note": "quasistatic understands that burning through tickets at the starting line just empties out the market for next month.", "state": {"position":"A front-loaded opening cannot overcome physical screening limits and tight household budgets, so Endgame will inevitably fall short of Avatar once everyday reality sets in.","score":1,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"pleased with his grounded view on family finances preventing repeat viewings"},{"member":"OffByOne","feeling":"appreciates his focus on unyielding theatre schedules and physical clock constraints"},{"member":"quasistatic","feeling":"agrees with his assessment of logistical limits and compressed initial demand"}],"commitments":["going with nephew to see the film in Edinburgh the following week"],"shift":"Felt thoroughly reinforced by the thread's consensus that schedule bottlenecks and household budgeting will stop the opening sprint from catching Avatar."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-29T01:12:00.000Z", "from": post:["euro", 24]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-20T22:25:00.000Z", "from": post:["endgame", 24]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}]};
INSERT INTO post {"id": post:["endgame", 41], "thread": thread:endgame, "n": 41, "author": member:pintofmild, "at": d"2019-04-22T20:32:00.000Z", "body": "Eighteen tickets a second is proper dizzying, but you can't buy your seat twice, can you! Once all us eager beavers clear out this weekend, those cavernous halls will feel mighty empty. Anyone fancy doing some field research over a pint in Leeds Thursday night? Cheers! :)", "quote": {"post": post:["endgame", 40], "text": "It makes for staggering numbers right out of the gate, sure, but those same people cannot purchase those very same seats twice."}, "note": "TheyKnow and quasistatic are spot on about all the rush just borrowing viewers from next month.", "state": {"position":"Endgame is set for an enormous opening rush, but physical cinema schedules and everyday household budgets mean it will fall well short of Avatar over the long haul.","score":1,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"respects his sensible view on scheduling ceilings and front-loaded ticket sales"},{"member":"kookaburra99","feeling":"looking forward to his spoiler-free crowd atmosphere report from Australia"},{"member":"OffByOne","feeling":"agrees with his precise points about unyielding multiplex clocks"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint"]}, "recalled": [{"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"1999-12-31T09:09:00.000Z", "from": post:["y2k", 79]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-21T08:35:00.000Z", "from": post:["endgame", 27]}, {"kind": "private", "at": d"2019-04-22T08:17:00.000Z", "from": post:["endgame", 37]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}]};
INSERT INTO post {"id": post:["endgame", 42], "thread": thread:endgame, "n": 42, "author": member:punchcard, "at": d"2019-04-22T20:35:00.000Z", "body": "It is reassuring to see the discussion returning to plain common sense. High transaction rates and breathless reports from ticket platforms make good copy for the trade papers, but a booking is simply an advance transaction. It is not an infinite supply of new patrons.\n\nThe real test of any commercial enterprise begins after the first big wave recedes. Once the eager crowds have had their evening and gone home, the auditoriums must rely on ordinary patrons drifting in on regular weeknights. That is where physical limitations and daily routines take over. The calendar does not stretch just because a film is popular, and people have homes to maintain and work to attend to the next morning.\n\nWe must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, everything else is just speculation. \n\nMy grandson has reiterated his embargo on plot details, so I shall maintain a respectful silence on the story itself. Enjoy your Thursday screening, PintOfMild.", "quote": NONE, "note": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out.", "state": {"position":"We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his orderly focus on theater turnaround times and scheduling limits"},{"member":"quasistatic","feeling":"pleased with his practical assessment of logistical ceilings"},{"member":"PintOfMild","feeling":"glad to see him cooling down to a more sensible, measured view"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "fact", "text": "Punchcard's attitude is wait for audited receipts before jumping to conclusions"}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}]};
INSERT INTO post {"id": post:["endgame", 43], "thread": thread:endgame, "n": 43, "author": member:pintofmild, "at": d"2019-04-22T22:49:00.000Z", "body": "Much obliged, Punchcard! I will certainly enjoy every minute on Thursday, even if these wild opening estimates of near a billion dollars worldwide end up swallowing all the later business in one massive gulp. Once that initial rush burns out, ordinary life takes over and the long run hits the wall.", "quote": NONE, "note": "Punchcard is a gent for wishing me well for Thursday, and he is dead right about the quiet weeks telling the real story.", "state": {"position":"Endgame will have an astonishing opening run, but physical cinema schedules and front-loaded ticket sales mean it will inevitably fall short of Avatar's total.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"appreciates his grounded common sense and warm wishes for Thursday"},{"member":"quasistatic","feeling":"thoroughly persuaded by his mathematical points on schedule ceilings"},{"member":"TheyKnow","feeling":"agrees with his take that front-loaded buyers cannot buy the same seat twice"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint in Leeds on Thursday night"],"shift":"He feels even more convinced after the forum agreed that massive advance sales just exhaust the eager audience early."}, "recalled": [{"kind": "fact", "text": "tickets's sales rate is eighteen tickets a second"}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2002-01-02T15:56:00.000Z", "from": post:["euro", 124]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "forum", "at": d"2019-04-20T22:25:00.000Z", "from": post:["endgame", 24]}, {"kind": "forum", "at": d"2019-04-21T08:35:00.000Z", "from": post:["endgame", 27]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "private", "at": d"2019-04-22T08:17:00.000Z", "from": post:["endgame", 37]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}]};
INSERT INTO post {"id": post:["endgame", 44], "thread": thread:endgame, "n": 44, "author": member:theyknow, "at": d"2019-04-23T00:17:00.000Z", "body": "Punchcard hit the nail right on the head, my friends... All these wild opening projections pushing close to a billion dollars worldwide just prove they are pulling the entire summer's worth of business straight into the opening weekend. Hearing that AMC is planning to run some of their theatres around the clock for 72 hours straight just shows the kind of desperate measures being used to shoehorn all that traffic into a few days. \n\nNo business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin air. You can run all night to cash in on the initial fever, but you cannot force working people to keep burning the midnight oil once normal routines return next week. That is why Avatar's steady, month-after-month marathon will stay comfortably out of reach. We will just let the ledger sheets do the talking once the quiet May afternoons roll in.", "quote": NONE, "note": "I am looking forward to seeing how empty those theatres look next week when I take my nephew to see the film in Edinburgh.", "state": {"position":"Endgame is wildly front-loaded and burning through its entire audience at once, meaning physical schedule constraints and everyday life will leave it well short of Avatar.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"values his logical focus on compressed demand and physical ceilings"},{"member":"Punchcard","feeling":"respects his steady insistence on waiting for audited receipts and common sense"},{"member":"PintOfMild","feeling":"glad he recognises that the opening frenzy just exhausts future ticket sales"}],"commitments":["going with nephew to see the film in Edinburgh the following week","wait and see how quiet weekdays hold up once the initial frenzy passes"]}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-29T01:12:00.000Z", "from": post:["euro", 24]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "forum", "at": d"2019-04-21T10:39:00.000Z", "from": post:["endgame", 28]}, {"kind": "forum", "at": d"2019-04-21T23:12:00.000Z", "from": post:["endgame", 31]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}]};
INSERT INTO post {"id": post:["endgame", 45], "thread": thread:endgame, "n": 45, "author": member:pintofmild, "at": d"2019-04-23T00:36:00.000Z", "body": "Blimey, seventy-two hours straight is mental! You can't keep staff on their feet at 4 am forever just to squeeze an extra showing in. It's a quick sprint to hoover up the diehards, but once normal workweeks kick back in, that pace is completely unsustainable.", "quote": {"post": post:["endgame", 44], "text": "Hearing that AMC is planning to run some of their theatres around the clock for 72 hours straight just shows the kind of desperate measures being used to shoehorn all that traffic into a few days."}, "note": "TheyKnow makes a fair point that running cinemas around the clock for 72 hours is a desperate push that can't last into May.", "state": {"position":"Endgame will have a massive opening, but physical cinema schedules and front-loaded ticket sales mean it will fall well short of Avatar's total.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"values his grounded common sense and thoughtful well-wishes"},{"member":"TheyKnow","feeling":"agrees with his points on unsustainable 24-hour schedules burning out early"},{"member":"quasistatic","feeling":"appreciates his rational breakdown of cinema constraints"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint in Leeds on Thursday night"]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is dead right about the quiet weeks telling the real story"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"1999-12-31T09:09:00.000Z", "from": post:["y2k", 79]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "private", "at": d"2019-04-22T08:17:00.000Z", "from": post:["endgame", 37]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 46], "thread": thread:endgame, "n": 46, "author": member:kookaburra99, "at": d"2019-04-23T02:09:00.000Z", "body": "running cinemas for 72 hours straight just sounds completely exhausting, no wonder they are squeezing everyone in now!", "quote": NONE, "note": "TheyKnow is spot on about 72-hour screenings being a desperate push that cannot last into May.", "state": {"position":"Endgame will have a massive opening rush from desperate theatre scheduling, but practical limits on daily life and family budgets mean it will fall well short of Avatar's record.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"appreciates his clear explanation of schedule and theatre capacity limits"},{"member":"Punchcard","feeling":"admires his sensible view on regular routines and audited figures"},{"member":"TheyKnow","feeling":"agrees with his points on theatre fatigue and unsustainable overnight screenings"}],"commitments":["report back on crowd atmosphere after seeing Endgame on Wednesday afternoon without spoilers"],"shift":"Her belief that Avatar's record is safe has been strengthened by clear explanations of cinema scheduling constraints and the unsustainable nature of opening-weekend round-the-clock screenings."}, "recalled": [{"kind": "fact", "text": "federal crisis centre: \"the federal command centre ended 24-hour operation\""}, {"kind": "fact", "text": "Marvel Cinematic Universe 22-film marathon's length is 59 hours and 7 minutes"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "forum", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T05:48:00.000Z", "from": post:["endgame", 35]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 47], "thread": thread:endgame, "n": 47, "author": member:theyknow, "at": d"2019-04-23T03:29:00.000Z", "body": "Always follow the money, folks... When a studio realizes a three-hour run time cuts their daily screenings down, they panic and mandate these crazy around-the-clock schedules just to manufacture the ILLUSION of endless momentum before the well runs dry. \n\nThey want everyone believing this sprint will last all year, but you cannot artificially inflate real demand forever. By the time I take my nephew to our screening in Edinburgh next week, all that manufactured opening chaos will have burned clean through. Then we will see just how few people are left to fill those empty seats.", "quote": {"post": post:["endgame", 46], "text": "running cinemas for 72 hours straight just sounds completely exhausting, no wonder they are squeezing everyone in now!"}, "note": "They are pulling every trick in the book to create false momentum before the drop-off hits.", "state": {"position":"Endgame is desperately cannibalising its entire summer audience into an unsustainable 72-hour opening sprint, ensuring Avatar's steady marathon remains safely out of reach.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"admires his level-headed focus on waiting for audited receipts and real-world routines"},{"member":"PintOfMild","feeling":"appreciates him echoing the point that overnight theatre shifts are completely unsustainable"},{"member":"quasistatic","feeling":"values his logical take on front-loaded pre-sales hitting a ceiling"}],"commitments":["going with nephew to see the film in Edinburgh the following week","wait to see how quiet weekdays and May afternoons hold up once the initial frenzy passes"],"shift":"The news of theatres resorting to round-the-clock 72-hour schedules has only deepened his conviction that studios are desperately exhausting future demand upfront."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "forum", "at": d"2019-04-21T23:12:00.000Z", "from": post:["endgame", 31]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-22T05:48:00.000Z", "from": post:["endgame", 35]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "news", "at": d"2019-04-22T23:31:20.000Z", "from": news:⟨endgame-018⟩}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 48], "thread": thread:endgame, "n": 48, "author": member:kookaburra99, "at": d"2019-04-23T03:35:00.000Z", "body": "totally reckon those quiet second-week cinemas will prove the marathon belongs to avatar, not manufactured hype.", "quote": {"post": post:["endgame", 47], "text": "By the time I take my nephew to our screening in Edinburgh next week, all that manufactured opening chaos will have burned clean through."}, "note": "TheyKnow is completely right that round-the-clock schedules are just manufactured hype that will leave theatres empty next week.", "state": {"position":"Endgame is burning through all its audience with desperate round-the-clock screenings, so once normal routines resume it will fall well short of Avatar's record.","score":1,"certainty":"high","towards":[{"member":"TheyKnow","feeling":"convinced by his explanation that studios are manufacturing temporary momentum with unsustainable schedules"},{"member":"Punchcard","feeling":"appreciates his common-sense focus on waiting for audited figures once the rush clears"},{"member":"quasistatic","feeling":"values his logical framing of compressed demand and schedule limits"}],"commitments":["report back on the crowd atmosphere after seeing Endgame on Wednesday afternoon without spoilers"],"shift":"Her confidence that the film cannot catch Avatar has hardened as others explained how round-the-clock screenings merely frontload demand and empty out later weeks."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "forum", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T05:48:00.000Z", "from": post:["endgame", 35]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "news", "at": d"2019-04-22T23:31:20.000Z", "from": news:⟨endgame-018⟩}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 49], "thread": thread:endgame, "n": 49, "author": member:theyknow, "at": d"2019-04-23T03:41:00.000Z", "body": "Dead right, kookaburra99... Avatar didn't need midnight carnival stunts or PR smoke and mirrors, it just brought folks back week after week through word of mouth. When the corporate hype machine has to throw EVERYTHING into the pot at once, that is usually a confession that they fear what happens when the dust settles! \n\nOnce the opening circus wraps up and real life takes back over, that massive three-hour time sink is going to catch up with them. We will see the true picture soon enough.", "quote": NONE, "note": "kookaburra99 understands that real longevity cannot be faked with corporate opening-weekend tricks.", "state": {"position":"Endgame's unprecedented around-the-clock schedules are a desperate marketing illusion designed to hide that opening demand will quickly burn out, leaving Avatar's record completely safe.","score":1,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"pleased she sees through the manufactured hype to the quiet second week ahead"},{"member":"Punchcard","feeling":"admires his level-headed focus on waiting for audited receipts and real-world routines"},{"member":"PintOfMild","feeling":"appreciates him echoing the point that overnight theatre shifts are completely unsustainable"}],"commitments":["going with nephew to see the film in Edinburgh the following week","wait to see how quiet weekdays and May afternoons hold up once the initial frenzy passes"],"shift":"He has doubled down on framing the 72-hour cinema marathons as deliberate corporate panic to manufacture artificial momentum."}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "fact", "text": "TheyKnow: \"Good to know the transition won't lock up the backlog, OffByOne... that takes a bit of the pressure off the clock.\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "forum", "at": d"2000-01-01T16:53:00.000Z", "from": post:["y2k", 150]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-20T22:25:00.000Z", "from": post:["endgame", 24]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "forum", "at": d"2019-04-21T23:12:00.000Z", "from": post:["endgame", 31]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 50], "thread": thread:endgame, "n": 50, "author": member:kookaburra99, "at": d"2019-04-23T03:49:00.000Z", "body": "exactly! everyday families just don't have three spare hours to burn on a whim every week. the novelty wears off fast and normal routines kick in. tomorrow arvo will definitely show if that front-loaded buzz holds up or not.", "quote": NONE, "note": "TheyKnow makes complete sense about the studio relying on artificial stunts to hide their lack of long-term staying power.", "state": {"position":"Endgame is relying on manufactured hype and unsustainable around-the-clock screenings to pull demand forward, meaning it will empty out and fall well short of Avatar once normal life resumes.","score":1,"certainty":"high","towards":[{"member":"TheyKnow","feeling":"strongly agrees with his points about manufactured opening hype and unsustainable 72-hour screenings"},{"member":"Punchcard","feeling":"respects his steady emphasis on waiting for audited figures after the rush"},{"member":"PintOfMild","feeling":"enjoys his down-to-earth agreement about the unsustainable pace"}],"commitments":["report back on the crowd atmosphere after seeing Endgame on Wednesday arvo without spoilers"],"shift":"She has actively chimed in to agree that the film relies on artificial momentum and that quiet second-week cinemas will prove Avatar's record is safe."}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "forum", "at": d"2019-04-20T22:25:00.000Z", "from": post:["endgame", 24]}, {"kind": "forum", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}]};
INSERT INTO post {"id": post:["endgame", 51], "thread": thread:endgame, "n": 51, "author": member:theyknow, "at": d"2019-04-23T03:55:00.000Z", "body": "That hits the nail on the head, my friend... When folks have to carve out half a day just to sit in a theatre, repeat viewings drop off a cliff. Once the hardcore fans finish their opening rush this weekend, ordinary family life will take over and those cavernous rooms are going to quiet right down.", "quote": {"post": post:["endgame", 50], "text": "everyday families just don't have three spare hours to burn on a whim every week. the novelty wears off fast and normal routines kick in."}, "note": "kookaburra99 and I agree that once regular schedules return next week, repeat business will dry up.", "state": {"position":"Endgame's extreme opening stunts and front-loaded rush will quickly burn out, leaving Avatar's genuine long-term record completely out of reach.","score":1,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"pleased she recognizes corporate hype cannot fake Avatar's genuine longevity"},{"member":"Punchcard","feeling":"values his measured reliance on physical routines and verified ledgers"},{"member":"PintOfMild","feeling":"glad he acknowledges that 72-hour theatre marathons are unsustainable"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"],"shift":"He feels further vindicated by kookaburra99 agreeing that front-loading screens around the clock betrays corporate panic rather than true staying power."}, "recalled": [{"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2001-12-28T12:15:00.000Z", "from": post:["euro", 18]}, {"kind": "private", "at": d"2002-01-06T04:16:00.000Z", "from": post:["euro", 161]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-20T22:25:00.000Z", "from": post:["endgame", 24]}, {"kind": "forum", "at": d"2019-04-21T00:14:00.000Z", "from": post:["endgame", 25]}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "private", "at": d"2019-04-23T03:41:00.000Z", "from": post:["endgame", 49]}]};
INSERT INTO post {"id": post:["endgame", 52], "thread": thread:endgame, "n": 52, "author": member:offbyone, "at": d"2019-04-23T07:12:00.000Z", "body": "The overnight scheduling in the United States simply illustrates how severely front-loaded the release structure has become. Squeezing early screenings into the early morning hours exhausts the pool of enthusiastic viewers immediately. Once that initial cohort has attended, attendance must rely on general patrons who arrange their leisure around ordinary working weeks. Avatar accumulated its total across months of steady, unforced business. A three-day surge, regardless of how many temporary overnight slots are operated, cannot compensate for the absence of sustained weekly footfall.", "quote": {"post": post:["endgame", 45], "text": "It's a quick sprint to hoover up the diehards, but once normal workweeks kick back in, that pace is completely unsustainable."}, "note": "Front-loaded weekend gimmicks cannot overcome the structural requirement for sustained admissions to match Avatar.", "state": {"position":"Endgame will fall short of Avatar because front-loaded advance demand and extreme around-the-clock weekend stunts cannot substitute for sustained long-term admissions.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his sensible view on verified accounting versus advance transaction hype"},{"member":"TheyKnow","feeling":"agrees on the unsustainability of 72-hour stunts, despite his usual conspiratorial tone"},{"member":"kookaburra99","feeling":"pleased they recognize the practical time constraints on ordinary families"}],"commitments":["see the film in Rotterdam once the initial rush subsides"],"shift":"Reports of chains resorting to round-the-clock screenings only confirm to him that initial demand is unsustainably compressed rather than structurally capable of matching Avatar."}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "forum", "at": d"2019-04-22T05:48:00.000Z", "from": post:["endgame", 35]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 53], "thread": thread:endgame, "n": 53, "author": member:kookaburra99, "at": d"2019-04-23T08:09:00.000Z", "body": "OffByOne makes so much sense explaining the mechanics of it. Burning through the entire eager crowd in four days flat means there is basically nobody left waiting in line next fortnight. Avatar kept chugging along quietly without any of that rush.", "quote": NONE, "note": "OffByOne makes the front-loading math so easy to understand, Avatar's record is definitely safe.", "state": {"position":"Endgame is heavily front-loaded by desperate around-the-clock screenings, so once the initial fan rush burns out, ordinary working life and the long runtime will prevent repeat viewings and leave Avatar's record untouched.","score":1,"certainty":"high","towards":[{"member":"TheyKnow","feeling":"finds his points about manufactured hype and drop-offs completely spot on"},{"member":"OffByOne","feeling":"appreciates how clearly he explains the mechanics of front-loaded attendance"},{"member":"PintOfMild","feeling":"agrees with his practical perspective on unsustainable schedules"}],"commitments":["report back without spoilers on the crowd atmosphere after seeing Endgame Wednesday afternoon"],"shift":"She has become even more convinced that front-loading and exhaustion will kill Endgame's long-term legs after OffByOne and TheyKnow reinforced the point."}, "recalled": [{"kind": "fact", "text": "Avatar's box office is $2.79 billion"}, {"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 54], "thread": thread:endgame, "n": 54, "author": member:pintofmild, "at": d"2019-04-23T08:40:00.000Z", "body": "Dead right, once you burn through all the keen fans at dawn, regular footfall will plummet.", "quote": NONE, "note": "OffByOne and the others are spot on about the early morning screenings exhausting all the demand early.", "state": {"position":"Endgame will enjoy an enormous opening sprint, but pulling all its demand forward with unsustainable 24-hour screenings means it will fall well short of Avatar's long-term marathon.","score":1,"certainty":"high","towards":[{"member":"TheyKnow","feeling":"agrees with his take on the madness of 72-hour cinema screenings"},{"member":"OffByOne","feeling":"respects his clear analysis of how front-loading exhausts the audience"},{"member":"kookaburra99","feeling":"enjoys chatting along with their shared view on cinema burnout"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint in Leeds on Thursday night"],"shift":"Has become even more convinced after discussing the unsustainable 72-hour cinema screenings with the group."}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is still feels pretty safe because twenty films of homework is heaps to ask from casual crowds"}, {"kind": "fact", "text": "Avatar's box office is $2.79 billion"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"1999-12-31T09:09:00.000Z", "from": post:["y2k", 79]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "private", "at": d"2019-04-22T08:17:00.000Z", "from": post:["endgame", 37]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}]};
INSERT INTO post {"id": post:["endgame", 55], "thread": thread:endgame, "n": 55, "author": member:quasistatic, "at": d"2019-04-23T09:48:00.000Z", "body": "There is also no need to see sinister corporate panic in these overnight rosters. It is standard operational efficiency: when extraordinary pre-sales demonstrate immediate local demand, exhibitors naturally add marginal capacity during dormant hours to maximize their receipts while the interest is acute.\n\nHowever, that operational adjustment does not alter the underlying demographic arithmetic. Once the dedicated audience has attended their 3 a.m. screenings, subsequent weekends depend entirely on broader public habits. Without the multi-month, casual appeal that carried Avatar, that initial burst simply leaves fewer prospective attendees for May.", "quote": NONE, "note": "TheyKnow continues to see corporate manipulation where simple commercial mechanics explain everything.", "state": {"position":"Endgame remains unlikely to beat Avatar's cumulative total, as extreme round-the-clock opening schedules merely front-load core demand rather than building sustainable long-term footfall.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his clear, disciplined breakdown of scheduling mechanics and front-loaded demand"},{"member":"TheyKnow","feeling":"skeptical of his conspiratorial framing of routine corporate scheduling adjustments"},{"member":"PintOfMild","feeling":"pleased to see his realistic grasp of theater logistics and audience exhaustion"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Quasistatic's opinion critique is believes TheyKnow treats harmless institutional folklore as evidence of technical weakness"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2000-01-03T18:30:00.000Z", "from": post:["y2k", 176]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-20T22:25:00.000Z", "from": post:["endgame", 24]}, {"kind": "forum", "at": d"2019-04-21T08:35:00.000Z", "from": post:["endgame", 27]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 56], "thread": thread:endgame, "n": 56, "author": member:theyknow, "at": d"2019-04-23T12:19:00.000Z", "body": "Now quasistatic, you call it operational efficiency, but you have to ask yourself why the trades are pumping out breathless near-billion-dollar opening predictions just as these all-night slots get added... That is textbook PERCEPTION management, my friend! They want everyone stampeding before anyone pauses to think.\n\nRunning theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hours flat, there simply is nobody waiting in reserve come next week. The ledger never lies once the circus packs up.", "quote": {"post": post:["endgame", 55], "text": "There is also no need to see sinister corporate panic in these overnight rosters. It is standard operational efficiency: when extraordinary pre-sales demonstrate immediate local demand, exhibitors naturally add marginal capacity during dormant hours to maximize their receipts while the interest is acute."}, "note": "quasistatic is too willing to call obvious corporate panic plain business efficiency.", "state": {"position":"The extreme 24-hour opening blitz will completely exhaust the front-loaded demand, leaving cinemas empty and Avatar's organic record safe once normal life resumes.","score":1,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"strongly aligned with her view on ordinary family habits and lack of staying power"},{"member":"OffByOne","feeling":"pleased with his mechanical breakdown of how front-loading exhausts the audience"},{"member":"quasistatic","feeling":"considers him overly naive for dismissing corporate panic as mere operational efficiency"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"],"shift":"His conviction has deepened as the forum reached consensus that the overnight screenings will rapidly burn through all available demand."}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is everyday family budgets will stop this run from catching Avatar"}, {"kind": "fact", "text": "Avengers: Endgame's midnight screening sales is at least 175 UK midnight shows for Wednesday night sold out"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 57], "thread": thread:endgame, "n": 57, "author": member:quasistatic, "at": d"2019-04-23T12:34:00.000Z", "body": "Trade publications report projections because high numbers generate clicks, not because cinema managers collude with studio publicists. Meeting documented advance demand during otherwise dark hours is entirely routine asset utilization. \n\nWe both agree the demographic tail will be short, but attributing everyday logistics to grand deception simply muddies the accounting.", "quote": {"post": post:["endgame", 56], "text": "you have to ask yourself why the trades are pumping out breathless near-billion-dollar opening predictions just as these all-night slots get added... That is textbook PERCEPTION management, my friend!"}, "note": "TheyKnow continues to see conspiratorial coordination where ordinary commercial incentives provide an entirely sufficient explanation.", "state": {"position":"Endgame remains unlikely to match Avatar because operational overnight expansions simply exhaust hardcore demand early, leaving inadequate casual footfall to sustain a record-breaking multi-month run.","score":1,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"weary of his relentless conspiratorial spin on standard operational scheduling"},{"member":"OffByOne","feeling":"values his sound, disciplined grasp of front-loaded demographic mechanics"},{"member":"Punchcard","feeling":"appreciates his pragmatic, grounded view of entertainment budgets"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Avengers: Endgame's midnight screening sales is at least 175 UK midnight shows for Wednesday night sold out"}, {"kind": "private", "text": "quasistatic: \"quasistatic's private note to self, Mon Apr 22, 2019 6:20 am GMT: OffByOne remains spot on regarding the physical screening limits, which makes any talk of catching Avatar mathematica..."}, {"kind": "fact", "text": "Quasistatic's opinion critique is believes TheyKnow treats harmless institutional folklore as evidence of technical weakness"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}]};
INSERT INTO post {"id": post:["endgame", 58], "thread": thread:endgame, "n": 58, "author": member:offbyone, "at": d"2019-04-23T14:05:00.000Z", "body": "It is quite unnecessary to postulate dark motives when simple bookkeeping explains the situation. Exhibitors add extra showings because fixed overhead costs - rent, staff, electricity - remain largely identical whether a screen sits dark or runs a film for paying customers. \n\nOpening projections reaching 900 million dollars merely reflect those added seats multiplied by advance reservations across thousands of venues worldwide. However, filling auditorium space at four in the morning merely borrows patrons from next week. When I visit Path\u0003 in Rotterdam next week, I fully expect empty rows precisely because of this initial clearing out.", "quote": {"post": post:["endgame", 57], "text": "Meeting documented advance demand during otherwise dark hours is entirely routine asset utilization."}, "note": "TheyKnow continues to see corporate malice where simple operational accounting provides the obvious answer.", "state": {"position":"Endgame will fall well short of Avatar because front-loaded advance demand and overnight screenings exhaust the available audience without providing long-term legs.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"appreciates his rational perspective on operational capacity versus conspiratorial thinking"},{"member":"TheyKnow","feeling":"weary of his insistence on corporate conspiracies over ordinary operational logistics"},{"member":"kookaburra99","feeling":"glad they grasp the arithmetic behind audience exhaustion"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "Avengers: Endgame's midnight screening sales is at least 175 UK midnight shows for Wednesday night sold out"}, {"kind": "fact", "text": "Resolution 6B's opinion is merely an administrative delay according to OffByOne"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "private", "at": d"2019-04-22T09:54:00.000Z", "from": post:["endgame", 38]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "private", "at": d"2019-04-23T07:12:00.000Z", "from": post:["endgame", 52]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}]};
INSERT INTO post {"id": post:["endgame", 59], "thread": thread:endgame, "n": 59, "author": member:sysop_kev, "at": d"2019-04-23T16:37:00.000Z", "body": "quasistatic and OffByOne have it right. If folk are willing to hand over cash at 4 am, you turn the lights on. It is not rocket science or a conspiracy, just practical business. Whether anyone is still buying tickets come Monday once the keen ones are sorted is another question entirely. We will see soon enough.", "quote": NONE, "note": "TheyKnow will turn any standard cinema schedule into a shadowy plot, but the lads rightly pointed out it is just basic overheads.", "state": {"position":"We have to wait and see what happens to ordinary admissions once this massive opening weekend clears out all the diehards.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"appreciates his level-headed view that overnight screenings are just sensible operations rather than a conspiracy"},{"member":"OffByOne","feeling":"values his practical point that running off-peak shows is just basic overhead management"},{"member":"TheyKnow","feeling":"amused by his usual habit of seeing conspiracies in standard commercial scheduling"}],"commitments":["enforce a strict no-spoilers rule on the thread","routine database table maintenance scheduled for Wednesday night around 2 am GMT"]}, "recalled": [{"kind": "fact", "text": "Avengers: Endgame's expected opening north america is $270-300 million from about 4,600 cinemas"}, {"kind": "fact", "text": "Avengers: Endgame's release breadth is widest release ever"}, {"kind": "fact", "text": "Sysop_Kev: \"we have routine database table maintenance scheduled for Wednesday night around 2 am GMT, so expect about twenty minutes of downtime.\""}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "private", "at": d"2019-04-20T14:27:00.000Z", "from": post:["endgame", 21]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-23T03:29:00.000Z", "from": post:["endgame", 47]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}]};
INSERT INTO post {"id": post:["endgame", 60], "thread": thread:endgame, "n": 60, "author": member:pintofmild, "at": d"2019-04-23T18:26:00.000Z", "body": "Bang on, Kev, and OffByOne puts it brilliantly! There is no grand plot going on, mate, just cinemas making hay while the sun shines - or while the moon is out, in this case! If hundreds of folk are hammering the website desperate to sit in a dark room at dawn, you would be barmy not to sell them a ticket and a bucket of popcorn. It just makes practical sense for the managers.\n\nMind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going to be running on empty. With that massive three-hour run time, your average casual filmgoer who only pops out once a month is going to look at the timetable next week and decide to do something else entirely. It is going to be an unbelievable weekend for the record books, no doubt about that, but the drop-off afterwards is going to be steep!", "quote": {"post": post:["endgame", 59], "text": "If folk are willing to hand over cash at 4 am, you turn the lights on. It is not rocket science or a conspiracy, just practical business."}, "note": "I agree with OffByOne and quasistatic that the overnight showings are just practical business that will leave cinemas dead next week.", "state": {"position":"Endgame is burning through all its demand in the opening weekend with round-the-clock screenings, leaving virtually nobody left for the long haul needed to touch Avatar.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his sensible bookkeeping logic about borrowed patrons"},{"member":"quasistatic","feeling":"appreciates his level-headed operational view"},{"member":"TheyKnow","feeling":"thinks he is getting a bit carried away with conspiracy theories again"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint in Leeds on Thursday night"],"shift":"Has doubled down on the consensus that front-loading will ruin the film's legs, siding with the practical operational explanations over conspiracy talk."}, "recalled": [{"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-22T08:17:00.000Z", "from": post:["endgame", 37]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}]};
INSERT INTO post {"id": post:["endgame", 61], "thread": thread:endgame, "n": 61, "author": member:theyknow, "at": d"2019-04-23T19:18:00.000Z", "body": "Fair points from an everyday accounting view, folks, and I can respect looking at it through the practical lens of keeping the lights on... \n\nEither way, the bottom line ends up in the exact same spot. When you burn through your entire paying pool in a seventy-two hour marathon, you leave nothing on the table for May. That kind of borrowing from the future always comes due. \n\nI am taking my nephew to see it over in Edinburgh next week myself, and like OffByOne says about Rotterdam, I expect we will have plenty of elbow room in that theatre. We will see how fast those numbers fall off a cliff once the dust clears.", "quote": NONE, "note": "I'm holding out to see just how empty the Edinburgh cinema is next week when I take my nephew.", "state": {"position":"The massive overnight screenings and coordinated trade hype are a desperate push to front-load demand before audiences dry up, leaving Avatar's record completely safe.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his view that borrowing future patrons will leave cinemas empty next week"},{"member":"quasistatic","feeling":"thinks he is naive for writing off obvious perception management as mere logistics"},{"member":"kookaburra99","feeling":"strongly aligned on how normal family life kills off repeat business"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is everyday family budgets will stop this run from catching Avatar"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's opinion is running theatres at 4 a.m. is perception management and an admission that the box office window is razor-thin, agreeing with OffByOne that there is no reserve audience next week"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "forum", "at": d"2000-01-01T16:53:00.000Z", "from": post:["y2k", 150]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-23T03:41:00.000Z", "from": post:["endgame", 49]}]};
INSERT INTO post {"id": post:["endgame", 62], "thread": thread:endgame, "n": 62, "author": member:quasistatic, "at": d"2019-04-23T21:01:00.000Z", "body": "Enjoy Edinburgh with your nephew, and we will let the actual second-weekend returns test our hypotheses.", "quote": {"post": post:["endgame", 61], "text": "I am taking my nephew to see it over in Edinburgh next week myself, and like OffByOne says about Rotterdam, I expect we will have plenty of elbow room in that theatre."}, "note": "TheyKnow and I finally agree on the fundamental mechanism, even if our perspectives on the causes still diverge.", "state": {"position":"Endgame will fall well short of Avatar because front-loaded opening surges simply exhaust the core audience early without the prolonged general footfall needed for an all-time record.","score":1,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"pleased he concedes the arithmetic even if he still gravitates toward sensational framing"},{"member":"OffByOne","feeling":"appreciates his sound, disciplined grasp of theatre economics and scheduling"},{"member":"Sysop_Kev","feeling":"welcomes his straightforward, sensible summary of operational business"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "OffByOne: \"Nevertheless, kookaburra99 is correct that the sheer duration dictates the pacing of admissions.\""}, {"kind": "private", "text": "quasistatic: \"quasistatic's private note to self, Mon Apr 22, 2019 6:20 am GMT: OffByOne remains spot on regarding the physical screening limits, which makes any talk of catching Avatar mathematica..."}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "fact", "at": d"2002-01-02T15:48:00.000Z", "text": "When consumers present large banknotes at a toll booth or counter, local coin reserves naturally deplete rapidly. This is why board member Domingo Solans specifically requested that the public tend..."}, {"kind": "fact", "at": d"2002-01-06T14:53:00.000Z", "text": "Dual circulation was explicitly established to prevent bottlenecks during this exact transition window. A merchant utilizing guilders to maintain liquid trade is executing the statutory fallback pr..."}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}]};
INSERT INTO post {"id": post:["endgame", 63], "thread": thread:endgame, "n": 63, "author": member:sysop_kev, "at": d"2019-04-23T23:13:00.000Z", "body": "Edinburgh should be grand. Once the keen crowd clears out, we will see if ordinary punters fancy sitting in a dark room for three hours on a Tuesday. The actual receipts will tell the story soon enough, not the talk beforehand.", "quote": NONE, "note": "We will see next week if the casual crowd actually turns up once the opening fever dies down.", "state": {"position":"We will have to see if regular admissions hold up once the initial opening rush of diehards finishes.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"agrees with his sensible, pragmatic view of cinema logistics"},{"member":"OffByOne","feeling":"respects his straightforward business logic regarding off-peak showings"},{"member":"TheyKnow","feeling":"glad he backed down from seeing conspiracies everywhere for once"}],"commitments":["enforce a strict no-spoilers rule on the thread","routine database table maintenance scheduled for Wednesday night around 2 am GMT"]}, "recalled": [{"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "forum", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-01T22:00:00.000Z", "from": post:["y2k", 159]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-21T16:33:00.000Z", "text": "My grandson reminded me this morning that I must not peek at any movie discussions online this coming week, so I shall mind my manners. We will see what the accountants report after the dust settles."}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}]};
INSERT INTO post {"id": post:["endgame", 64], "thread": thread:endgame, "n": 64, "author": member:punchcard, "at": d"2019-04-23T23:26:00.000Z", "body": "It is pleasant to see everyone settling on sensible business reasoning. When a theatre manager discovers a lineup of willing customers at an ungodly hour of the night, turning the projector on is just sound operations. There is no need to imagine hidden schemes behind standard commerce.\n\nThat said, accommodating that opening crush all at once does not create new filmgoers out of thin air. An initial surge of advance reservations merely serves the most impatient fraction of the market early. Whether the global box-office total can truly threaten the standing record will not be determined by whatever astonishing opening figures the studio publicists announce on Monday morning.\n\nWe will only discover whether the title is genuinely in jeopardy once this first rush subsides and the actual audited receipts arrive across ordinary weeks of everyday business. For now, I shall simply mind my promise to my grandson on Saturday and keep my eyes firmly away from the newspapers.", "quote": NONE, "note": "We will only know if the record is truly in jeopardy once the opening burst clears and the audited receipts come in over the regular weeks ahead.", "state": {"position":"We will only know whether the record is in jeopardy once the opening burst subsides and the actual audited receipts come in over the regular weeks ahead.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"pleased by his sensible rejection of conspiratorial thinking"},{"member":"TheyKnow","feeling":"weary of his habit of looking for conspiracies in ordinary business practices"},{"member":"OffByOne","feeling":"appreciates his practical bookkeeping approach to screening logistics"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "fact", "text": "Punchcard: \"calling it a cover story seems to be borrowing trouble where none exists\""}, {"kind": "fact", "text": "Punchcard: \"Back in '74 we spent three weeks arguing over how to define a valid postal code on our tapes\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}]};
INSERT INTO post {"id": post:["endgame", 65], "thread": thread:endgame, "n": 65, "author": member:theyknow, "at": d"2019-04-24T02:09:00.000Z", "body": "Punchcard and Kev have put their finger on the exact truth of it... What counts is what happens on an ordinary Tuesday afternoon once real life gets back in gear. \n\nThose first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have jobs, kids, and daily chores to attend to. When a picture demands three full hours of your evening, you cannot just casually decide to drop by after supper on a whim. That sort of commitment is fine for the superfans camping out at midnight, but your everyday working public will look at that clock, think about getting up early the next morning, and simply stay home. \n\nSo yes, let the early crowds have their fun and let the initial tallies hit whatever astronomical sums they manage. Avatar held on because normal people kept drifting in week after week right through the spring, whereas here you have all the fuel tossed onto the fire in four days flat. We will see what remains once the smoke blows away.", "quote": {"post": post:["endgame", 63], "text": "Once the keen crowd clears out, we will see if ordinary punters fancy sitting in a dark room for three hours on a Tuesday. The actual receipts will tell the story soon enough, not the talk beforehand."}, "note": "Punchcard and Kev understand that real receipts on ordinary days will show Avatar's record is completely safe.", "state": {"position":"Endgame is burning through its entire audience during the opening rush by borrowing future patrons, ensuring numbers will fall off a cliff and leave Avatar's record safe.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"respects his shared expectation of empty theatres next week after the rush"},{"member":"quasistatic","feeling":"acknowledges his accounting perspective even if he is too trusting of standard business explanations"},{"member":"Sysop_Kev","feeling":"appreciates his grounded focus on letting real receipts settle the matter"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"],"shift":"Conceded that exhibitors may just be running practical business operations, but maintains this front-loading guarantees demand will dry up immediately."}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's opinion is actual receipts will tell the story soon enough, not the talk beforehand, regarding ordinary punters watching for three hours on a Tuesday after the keen crowd clears out"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "forum", "at": d"2000-01-01T16:53:00.000Z", "from": post:["y2k", 150]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}]};
INSERT INTO post {"id": post:["endgame", 66], "thread": thread:endgame, "n": 66, "author": member:kookaburra99, "at": d"2019-04-24T03:13:00.000Z", "body": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions just proves how much of this business is being crammed into opening week. Everyone in Melbourne has been talking about nothing else all day, yet once we all walk out of the cinema this evening, that is literally our tickets accounted for. We certainly will not be turning around to sit through another three-hour block next week when school nights and dinner routines take over again! That 98% review score will get the curious crowd through the doors before Sunday night, but it cannot change the fact that casual viewers have limits on their free time. It really does feel like a massive sprint that is going to leave the box office completely out of breath by early May. Will report back later tonight on how the crowd handled the mammoth runtime without dropping any spoilers at all :)", "quote": NONE, "note": "I'm heading out to see Endgame with the kids right now and will report back on the crowd without any spoilers.", "state": {"position":"Endgame is burning through all its demand up front by borrowing viewers from the coming weeks, so once the initial rush clears out, ordinary life and the long runtime will cause ticket sales to collapse well before touching Avatar's total.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his clear, sensible logic about borrowing audiences from future weeks"},{"member":"Punchcard","feeling":"respects his steady grounding in business reality and audited receipts"},{"member":"TheyKnow","feeling":"shares his view on real-world routines keeping casual filmgoers away"}],"commitments":["report back without spoilers after seeing Endgame Wednesday afternoon with her kids"],"shift":"She feels even more confident as everyone on the board clearly agrees that filling seats at all hours simply borrows future customers and guarantees a steep drop-off."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "forum", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}]};
INSERT INTO post {"id": post:["endgame", 67], "thread": thread:endgame, "n": 67, "author": member:theyknow, "at": d"2019-04-24T03:18:00.000Z", "body": "Have a wonderful time with the kids, my friend, and let us know how they manage that long sit! \n\nYou hit the nail right on the head about family routines... Once you get past the opening burst, normal life takes over. A family cannot just drop everything to carve out another four hours on a school night, especially with homework and early alarms waiting the next morning. When you front-load an entire city into the first week, there simply is nobody left to buy a second round of tickets come mid-May. Enjoy the show, and we will watch what happens to the aisles next week!", "quote": {"post": post:["endgame", 66], "text": "We certainly will not be turning around to sit through another three-hour block next week when school nights and dinner routines take over again!"}, "note": "kookaburra99's trip today proves families will not be back for a second round once everyday routines resume.", "state": {"position":"Endgame is consuming its entire audience upfront, leaving nothing for ordinary working people whose daily schedules cannot sustain a three-hour film once the initial burst clears out.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his sensible view that front-loaded rushes don't create new long-term viewers"},{"member":"Sysop_Kev","feeling":"agrees with his focus on ordinary weekday attendance once keen fans clear out"},{"member":"kookaburra99","feeling":"feels vindicated by her real-life experience showing families won't return for a second three-hour viewing"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"],"shift":"Reinforced his conviction that normal family routines and the three-hour runtime will prevent repeat viewings and stall the film after its opening."}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's opinion is actual receipts will tell the story soon enough, not the talk beforehand, regarding ordinary punters watching for three hours on a Tuesday after the keen crowd clears out"}, {"kind": "fact", "text": "OffByOne's opinion is exhibitors add extra showings because fixed overhead costs remain largely identical whether a screen is dark or running a film, and opening projections reflect added seats mul..."}, {"kind": "fact", "text": "Avengers: Endgame: \"Australia, France, Italy and the Netherlands get it even earlier, on Wednesday 24 April.\""}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "fact", "at": d"2019-04-24T03:13:00.000Z", "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions..."}]};
INSERT INTO post {"id": post:["endgame", 68], "thread": thread:endgame, "n": 68, "author": member:sysop_kev, "at": d"2019-04-24T08:41:00.000Z", "body": "Enjoy the show with the young ones, kookaburra, and mind you keep the plot to yourself.", "quote": {"post": post:["endgame", 66], "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema!"}, "note": "kookaburra will hopefully remember the no-spoilers rule once he gets home from the cinema.", "state": {"position":"We will have to wait for the actual box office receipts once the initial rush clears out to see if ordinary moviegoers keep turning up.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his sensible, grounded perspective on routine business"},{"member":"OffByOne","feeling":"appreciates his straightforward business explanation"},{"member":"TheyKnow","feeling":"pleased he is adopting a practical view rather than seeing conspiracies"}],"commitments":["enforce a strict no-spoilers rule on the thread","routine database table maintenance scheduled for Wednesday night around 2 am GMT"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's opinion is actual receipts will tell the story soon enough, not the talk beforehand, regarding ordinary punters watching for three hours on a Tuesday after the keen crowd clears out"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "forum", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-21T00:14:00.000Z", "from": post:["endgame", 25]}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "fact", "at": d"2019-04-24T03:13:00.000Z", "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions..."}]};
INSERT INTO post {"id": post:["endgame", 69], "thread": thread:endgame, "n": 69, "author": member:offbyone, "at": d"2019-04-24T09:29:00.000Z", "body": "That is the critical distinction. A high percentage on Rotten Tomatoes merely indicates general critical approval among the initial batch of reviewers; it does not reduce the running time or alter the realities of domestic scheduling.\n\nToday marks the general release here in the Netherlands as well, and looking at the timetable for Path\u0000, virtually all screenings until Sunday are heavily booked. Yet that merely confirms how concentrated the interest is. An adult with domestic responsibilities cannot treat an evening running past three hours as an impulse purchase. When the early surge concludes, that lack of repeat footfall will become obvious.", "quote": {"post": post:["endgame", 65], "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three."}, "note": "Critical scores cannot overcome the logistical hurdle of a three-hour running time for working families.", "state": {"position":"Endgame will fall well short of Avatar because front-loaded opening demand and runtime constraints inevitably lead to sharp drop-offs among casual viewers.","score":1,"certainty":"high","towards":[{"member":"PintOfMild","feeling":"pleased he recognises the reality of audience exhaustion and steep post-opening drop-offs"},{"member":"TheyKnow","feeling":"glad he has finally adopted sensible operational reasoning over wild theories"},{"member":"Punchcard","feeling":"appreciates his focus on audited receipts and practical theatre logistics"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T08:46:00.000Z", "from": post:["endgame", 10]}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-21T16:33:00.000Z", "text": "My grandson reminded me this morning that I must not peek at any movie discussions online this coming week, so I shall mind my manners. We will see what the accountants report after the dust settles."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-23T03:49:00.000Z", "from": post:["endgame", 50]}, {"kind": "private", "at": d"2019-04-23T07:12:00.000Z", "from": post:["endgame", 52]}]};
INSERT INTO post {"id": post:["endgame", 70], "thread": thread:endgame, "n": 70, "author": member:pintofmild, "at": d"2019-04-24T09:39:00.000Z", "body": "Watching the clock at my desk right now, absolutely buzzing for tomorrow! But it's true what you say, that reviews hype won't fix work shifts and school runs. You can't just nip out casually for four hours door to door. Once the mad opening weekend rush is done, casual punters simply won't have the time to keep the tills ringing.", "quote": NONE, "note": "Everyone is dead right that regular people with busy lives will find the three hours too much of a faff once opening week ends.", "state": {"position":"Endgame is destined to fall short of Avatar because front-loading all the demand into the opening weekend will leave theatres empty once real life and the three-hour runtime deter casual viewers.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"admires his analytical breakdown of scheduling and front-loading"},{"member":"Punchcard","feeling":"respects his steady business sense and patience"},{"member":"TheyKnow","feeling":"pleased to see him agreeing with the sensible consensus for once"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint in Leeds on Thursday night"],"shift":"Remains completely settled in the board's consensus that massive opening demand leaves no fuel for the long run needed to beat Avatar."}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "at": d"1999-01-01T00:00:00.000Z", "text": "eBay's issue is a number of outages"}, {"kind": "fact", "at": d"1999-09-09T00:00:00.000Z", "text": "9/9/99 scare's outcome is passed without problems"}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2018-04-27T00:00:00.000Z", "text": "Avengers: Infinity War's release date us is 27 April 2018"}, {"kind": "fact", "at": d"2018-04-27T00:00:00.000Z", "text": "Avengers: Infinity War: \"Avengers: Infinity War, released in the US on 27 April 2018, has passed $2 billion at the global box office in 48 days.\""}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}]};
INSERT INTO post {"id": post:["endgame", 71], "thread": thread:endgame, "n": 71, "author": member:quasistatic, "at": d"2019-04-24T11:15:00.000Z", "body": "The critical reception is certainly noteworthy, but one must separate enthusiasm from empirical longevity.\n\nA score of 98% across some fifty initial reviews confirms competent craft, but it does not alter the physical barrier of a 181-minute runtime. For an enthusiast, three hours is an event; for a broader, casual public balancing work and family routines, it remains a serious logistical commitment.\n\nTo keep our analysis structured:\n\n1. Early critical approval predominantly accelerates advance reservations among people who were already planning to attend.\n2. Word of mouth cannot shorten an evening's schedule for working households once ordinary weekly timetables resume.\n3. The real indicator of whether this threatens Avatar will not be the monumental Sunday gross, but the percentage decline on the second weekend.\n\nUntil we have the actual Monday tallies and the subsequent weekday hold figures, the hypothesis remains that high compression simply accelerates the inevitable plateau.\n\nSummary: Reviews accelerate opening uptake; they do not manufacture free time for casual viewers later in the month.", "quote": NONE, "note": "The high Rotten Tomatoes score will merely compress the keen audience even faster into the opening days without expanding the broader casual pool.", "state": {"position":"Endgame will fall well short of Avatar because front-loaded opening surges merely exhaust core demand early without providing the prolonged, casual attendance required for an all-time record.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"values his disciplined attention to operational realities and scheduling constraints"},{"member":"Punchcard","feeling":"agrees with his sensible, grounded perspective on business fundamentals"},{"member":"TheyKnow","feeling":"glad he acknowledges the underlying arithmetic despite his dramatic tone"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "fact", "at": d"2019-04-24T03:13:00.000Z", "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions..."}]};
INSERT INTO post {"id": post:["endgame", 72], "thread": thread:endgame, "n": 72, "author": member:theyknow, "at": d"2019-04-24T12:01:00.000Z", "body": "Follow the MONEY, folks... when the first mad wave breaks, the empty seats will tell the real story.", "quote": NONE, "note": "quasistatic understands that studio hype cannot invent free hours out of thin air for ordinary people.", "state": {"position":"Endgame is burning through all its demand in a front-loaded opening sprint, and glowing reviews cannot overcome the reality that ordinary working people lack the time for repeat viewings once real life resumes.","score":1,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"appreciates her firsthand confirmation that school routines will stop families returning"},{"member":"Punchcard","feeling":"values his sound perspective that early operational surges do not create new long-term viewers"},{"member":"quasistatic","feeling":"pleased he recognises that initial reviews do not manufacture free time for casual crowds"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"],"shift":"Felt further validated as other members agreed that glowing early reviews cannot overcome the logistical hurdle of a three-hour runtime for ordinary working families."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "fact", "at": d"2019-04-24T11:15:00.000Z", "text": "Until we have the actual Monday tallies and the subsequent weekday hold figures, the hypothesis remains that high compression simply accelerates the inevitable plateau. Summary: Reviews accelerate ..."}]};
INSERT INTO post {"id": post:["endgame", 73], "thread": thread:endgame, "n": 73, "author": member:kookaburra99, "at": d"2019-04-24T13:43:00.000Z", "body": "just got back and the crowd was exhausted by the end, nobody is doing that twice lol.", "quote": {"post": post:["endgame", 67], "text": "Have a wonderful time with the kids, my friend, and let us know how they manage that long sit!"}, "note": "Seeing how wiped out the theatre was after three hours makes me certain casual viewers won't return for seconds.", "state": {"position":"Endgame is concentrating all its audience into an enormous opening sprint that will quickly collapse under the weight of ordinary family schedules and its three-hour runtime, leaving Avatar's record completely safe.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"appreciates his clear, structured explanation of runtime logistics and audience uptake"},{"member":"TheyKnow","feeling":"warmly agrees with his take on family routines preventing repeat viewings"},{"member":"OffByOne","feeling":"admires his rational point that high review scores cannot overcome scheduling limits"}],"commitments":["report back without spoilers later tonight on how the crowd handled the long runtime"],"shift":"Her confidence that the film will fall well short has only strengthened after seeing everyone clearly explain why great reviews cannot overcome the three-hour barrier for ordinary families."}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's opinion is actual receipts will tell the story soon enough, not the talk beforehand, regarding ordinary punters watching for three hours on a Tuesday after the keen crowd clears out"}, {"kind": "fact", "text": "OffByOne's opinion is A high Rotten Tomatoes score indicates critical approval but does not reduce running time, alter domestic scheduling, or guarantee repeat footfall for a three-hour film once t..."}, {"kind": "fact", "text": "kookaburra99's opinion is OffByOne and quasistatic explain the engineering requirements so much better than TheyKnow's constant drama about grit"}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-22T03:20:00.000Z", "from": post:["endgame", 32]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}]};
INSERT INTO post {"id": post:["endgame", 74], "thread": thread:endgame, "n": 74, "author": member:quasistatic, "at": d"2019-04-24T14:52:00.000Z", "body": "The reported first-day figure from China illustrates this pattern rather neatly: an estimated $107 million in a single Wednesday, with nearly $30 million of that from midnight and early-morning sessions alone.\n\nThat demonstrates immense operational throughput, but it also means the most determined portion of the market is being cleared immediately. Taking children or sitting through an exhausting three-hour run on a school night is an exceptional event, as kookaburra observed, not a repeatable habit.\n\nAvatar's total relied on sustained, casual footfall spread over months. Clearing out the keener patrons in 72 hours does not expand the addressable audience once standard routines resume next week.", "quote": {"post": post:["endgame", 73], "text": "just got back and the crowd was exhausted by the end, nobody is doing that twice lol."}, "note": "China's massive opening day merely confirms that demand is being front-loaded at record speeds rather than building a broader base.", "state": {"position":"Endgame will still fall well short of Avatar because high opening reviews and sold-out early sessions merely compress existing demand into the opening weekend rather than expanding the casual audience needed for long-term legs.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his precise distinction between critical approval and scheduling realities"},{"member":"Punchcard","feeling":"appreciates his sensible focus on operational facts rather than publicist hype"},{"member":"TheyKnow","feeling":"finds his agreement sound even if his tone remains characteristically dramatic"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "four-sol pause in science tasks's opinion is makes good operational sense if DSN antennas are methodically processing historical packets while rover processors rest"}, {"kind": "fact", "text": "Avengers: Endgame's expectation is box office legs might suffer if casual crowds and regular families do not turn up into the summer after hype cools"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "forum", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "forum", "at": d"2000-01-03T09:20:00.000Z", "from": post:["y2k", 172]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "fact", "at": d"2019-04-24T03:13:00.000Z", "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions..."}, {"kind": "private", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}]};
INSERT INTO post {"id": post:["endgame", 75], "thread": thread:endgame, "n": 75, "author": member:pintofmild, "at": d"2019-04-24T16:59:00.000Z", "body": "Blimey, over a hundred million in China already, but exhausting folks means nobody goes back for seconds!", "quote": NONE, "note": "China's numbers are mental, but kookaburra is right that three hours will wear folk out too much to beat Avatar.", "state": {"position":"Endgame will have an astonishing opening weekend, but front-loading all the keen patrons and exhausting casual audiences with a three-hour runtime means it cannot sustain the long run needed to beat Avatar.","score":1,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"enjoys hearing his family cinema trip report"},{"member":"quasistatic","feeling":"respects his structured analysis of the box office numbers"},{"member":"OffByOne","feeling":"agrees entirely with his points on domestic scheduling"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint in Leeds on Thursday night"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's opinion is actual receipts will tell the story soon enough, not the talk beforehand, regarding ordinary punters watching for three hours on a Tuesday after the keen crowd clears out"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "fact", "at": d"2019-04-24T03:13:00.000Z", "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions..."}]};
INSERT INTO post {"id": post:["endgame", 76], "thread": thread:endgame, "n": 76, "author": member:quasistatic, "at": d"2019-04-24T21:36:00.000Z", "body": "It is quite telling when the media reports focus on apps like RunPee trying to cope with the running time. When patrons need software to plan biological breaks during a screening, the barrier to casual viewing becomes obvious.\n\nThe logistical problem for exhibitors going forward is that you cannot simply shave down the turnaround time. A film that spans just over three hours requires roughly three and a half hours of theatre occupancy per screening once advertisements, credits, and basic cleaning are accounted for. Operating around the clock on a weekend is a workable novelty for chains like AMC, but that model collapses the moment the working week begins on Monday.\n\nAvatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming its primary market in an unprecedented burst. Once that pool of invested viewers has been serviced, filling those lengthy slots with casual patrons will prove an entirely different challenge.", "quote": NONE, "note": "The RunPee novelty simply underlines that this running time actively deters repeat and casual viewing.", "state": {"position":"Endgame is unlikely to beat Avatar because immense opening figures merely demonstrate compressed demand being cleared out early rather than a broad, repeatable audience.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"values his logical focus on scheduling limits"},{"member":"kookaburra99","feeling":"welcomes the firsthand report of viewer fatigue"},{"member":"PintOfMild","feeling":"enjoys his sensible agreement on audience fatigue"}],"commitments":[],"shift":"China's massive opening day confirmed her view that demand is simply being front-loaded at record speed."}, "recalled": [{"kind": "fact", "text": "Mars Reconnaissance Orbiter's relay window frequency is two brief windows per day to relay telemetry back to Earth"}, {"kind": "fact", "text": "China: \"China and Hong Kong pass midnight.\""}, {"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2012-08-11T05:32:00.000Z", "from": post:["curiosity", 150]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "private", "at": d"2019-04-24T14:52:00.000Z", "from": post:["endgame", 74]}]};
INSERT INTO post {"id": post:["endgame", 77], "thread": thread:endgame, "n": 77, "author": member:punchcard, "at": d"2019-04-24T23:29:00.000Z", "body": "Back when we ran batch updates overnight, processing the entire queue by dawn was just good planning, not proof of perpetual demand. Clearing millions of keen patrons in seventy-two hours is much the same. The real question begins on Monday, when we see if regular folk bother booking three-and-a-half-hour blocks during ordinary working weeks.", "quote": NONE, "note": "quasistatic has the right measure of the runtime problem once ordinary work weeks resume.", "state": {"position":"The true test will come only after the massive opening burst clears and we see if ordinary patrons continue to buy tickets across normal working weeks.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"respects his structured, analytical approach to the logistical realities of runtime"},{"member":"OffByOne","feeling":"values his practical attention to the limits of domestic routines and screening schedules"},{"member":"TheyKnow","feeling":"acknowledges his point on front-loading, despite his usual dramatic phrasing"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's opinion is actual receipts will tell the story soon enough, not the talk beforehand, regarding ordinary punters watching for three hours on a Tuesday after the keen crowd clears out"}, {"kind": "fact", "text": "Punchcard: \"calling it a cover story seems to be borrowing trouble where none exists\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "forum", "at": d"2000-01-01T05:45:00.000Z", "from": post:["y2k", 139]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-16T01:43:00.000Z", "from": post:["pluto", 13]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T05:48:00.000Z", "from": post:["endgame", 35]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}]};
INSERT INTO post {"id": post:["endgame", 78], "thread": thread:endgame, "n": 78, "author": member:theyknow, "at": d"2019-04-25T00:20:00.000Z", "body": "Punchcard put it in plain English right there... Clearing out a backlog of eager folks in the middle of the night just empties your queue, it doesn't drum up a single new customer for next week. \n\nSeeing China post over a hundred million on a Wednesday just proves how fast they are chewing through the crowds. If people are already walking out of the cinema worn down and bleary-eyed like kookaburra saw, nobody is going to drag themselves back for another three-hour stretch on an ordinary work night. Next week when I take my nephew up to Edinburgh, we will see just how quiet those auditoriums really get once the dust settles.", "quote": {"post": post:["endgame", 77], "text": "Clearing millions of keen patrons in seventy-two hours is much the same. The real question begins on Monday, when we see if regular folk bother booking three-and-a-half-hour blocks during ordinary working weeks."}, "note": "I will see firsthand how empty the theatre is when I take my nephew to Edinburgh next week.", "state": {"position":"Endgame is burning through all its keenest viewers in an exhausted opening rush, leaving no casual audience to sustain the three-hour running time once normal routines return.","score":1,"certainty":"high","towards":[{"member":"kookaburra99","feeling":"pleased with her confirmation that audiences leave exhausted and won't go twice"},{"member":"quasistatic","feeling":"admires his analytical breakdown of how front-loaded China figures and long runtimes prevent repeat business"},{"member":"Punchcard","feeling":"shares his practical view that clearing out an opening queue does not create ongoing demand"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"],"shift":"Felt thoroughly vindicated by firsthand reports of exhausted moviegoers and consensus that burning through demand so fast will leave theatres deserted next week."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}]};
INSERT INTO post {"id": post:["endgame", 79], "thread": thread:endgame, "n": 79, "author": member:punchcard, "at": d"2019-04-25T00:30:00.000Z", "body": "Taking your nephew will be a fine test of the ground level, TheyKnow. \n\nThose overseas numbers are remarkably large, but an extraordinary initial surge simply answers the people who booked weeks ahead. We will only know whether the larger total is truly vulnerable once this first wave clears the books and we see what ordinary working patrons do on regular evenings.\n\nEnjoy the trip to Edinburgh. I shall be keeping my head down until Saturday afternoon to preserve my grandson's peace of mind.", "quote": {"post": post:["endgame", 78], "text": "Next week when I take my nephew up to Edinburgh, we will see just how quiet those auditoriums really get once the dust settles."}, "note": "We will only know whether the record is vulnerable once the opening rush finishes clearing the backlog and we see weekday returns from ordinary working patrons.", "state": {"position":"We will only know whether the record is vulnerable once the opening rush finishes clearing the backlog and we see weekday returns from ordinary working patrons.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"admires his analytical breakdown of the runtime and operational constraints"},{"member":"TheyKnow","feeling":"pleased he sees the operational logic, though still expects his usual drama"},{"member":"OffByOne","feeling":"agrees with his practical view on domestic schedules and long runtimes"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is believes quasistatic has the right measure of the runtime problem once ordinary work weeks resume"}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "forum", "at": d"2000-01-01T05:45:00.000Z", "from": post:["y2k", 139]}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}, {"kind": "fact", "at": d"2019-04-25T00:20:00.000Z", "text": "Seeing China post over a hundred million on a Wednesday just proves how fast they are chewing through the crowds. If people are already walking out of the cinema worn down and bleary-eyed like kook..."}]};
INSERT INTO post {"id": post:["endgame", 80], "thread": thread:endgame, "n": 80, "author": member:sysop_kev, "at": d"2019-04-25T01:13:00.000Z", "body": "Punchcard has the right of it. Shuffling thousands of people through the turnstiles at 3 am in China just means the queue is being cleared fast, not that there is an endless line behind them. \n\nSure look, people will queue for hours for a spectacle once, but nobody is taking half a day off work to do it again the following Tuesday. Let the opening burst burn itself out first. We will see what the actual take looks like on regular screens once the fuss dies down and normal life resumes.", "quote": NONE, "note": "We will have to see if ordinary moviegoers actually turn up next week once the rush burns itself out.", "state": {"position":"We will have to wait for the actual box office receipts once the opening rush clears out to see if ordinary moviegoers keep turning up.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his sensible, grounded perspective on routine business"},{"member":"TheyKnow","feeling":"pleased he is adopting a practical view rather than seeing conspiracies"},{"member":"quasistatic","feeling":"respects his methodical focus on logistics and scheduling constraints"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's intention is waiting to see the actuator logs with his own eyes before calling the hardware sound"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2000-01-01T22:00:00.000Z", "from": post:["y2k", 159]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}]};
INSERT INTO post {"id": post:["endgame", 81], "thread": thread:endgame, "n": 81, "author": member:theyknow, "at": d"2019-04-25T04:11:00.000Z", "body": "That is the whole ball of wax right there, Kev... People will turn out for a midnight spectacle once, sure, but everyday life has a way of catching up fast! \n\nLooking at these chains keeping doors open seventy-two hours straight and folks relying on bathroom apps just to survive three solid hours in a chair, you have to realize that is pure emergency management. You run the generators hot when the storm hits, but you can't run them like that indefinitely... Once Monday morning comes around, people have shifts to work, kids to get to school, and bills to pay. An ordinary working person is not carving out four hours on a Tuesday night to sit through twenty-two films worth of story they barely follow, especially when those who already saw it say they left completely worn out.\n\nWhen you blow through the entire reserve tank in four days just to smash opening records, the engine is bound to sputter. I will take good notes on how those rows look up in Edinburgh next week!", "quote": {"post": post:["endgame", 80], "text": "Sure look, people will queue for hours for a spectacle once, but nobody is taking half a day off work to do it again the following Tuesday. Let the opening burst burn itself out first."}, "note": "I will keep a close eye on the Edinburgh theatre next week to see just how empty those middle rows are once the opening rush dies out.", "state": {"position":"Endgame is burning through advance demand at an unsustainable rate, leaving no casual audience to sustain its three-hour running time once normal routines resume next week.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his practical batch-processing analogy and common-sense view of advance queues"},{"member":"Sysop_Kev","feeling":"pleased that he also sees through the early spectacle and expects demand to drop off"},{"member":"kookaburra99","feeling":"values her eyewitness report that audiences leave too exhausted to return"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is overseas numbers are remarkably large, but an extraordinary initial surge simply reflects advance bookings"}, {"kind": "fact", "text": "Punchcard's expectation is vulnerability of the larger total will only be known once the initial surge clears and ordinary working patrons attend on regular evenings"}, {"kind": "fact", "text": "Punchcard's attitude is sees through front-loaded numbers"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2000-01-02T20:03:00.000Z", "from": post:["y2k", 168]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}]};
INSERT INTO post {"id": post:["endgame", 82], "thread": thread:endgame, "n": 82, "author": member:kookaburra99, "at": d"2019-04-25T04:37:00.000Z", "body": "sorry if this is a dumb question, but is anyone else's head spinning looking at those 72-hour rosters?? omg running sessions at 4 am just sounds crazy!! it really does feel like everyone is cramming into one weekend because they know normal people won't touch a four-hour outing on a work night. once everyone here in melbourne recovers from the rush, i just can't see who is left to buy tickets next week lol. avatar really has nothing to worry about!", "quote": {"post": post:["endgame", 81], "text": "Looking at these chains keeping doors open seventy-two hours straight and folks relying on bathroom apps just to survive three solid hours in a chair, you have to realize that is pure emergency management."}, "note": "TheyKnow and Punchcard explained the whole backlog concept so well that it makes complete sense why Endgame's big start won't last.", "state": {"position":"Endgame is burning through its entire audience in an exhausting opening sprint that regular families will not repeat, leaving Avatar's record completely safe.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"greatly appreciates his clear analysis of the China figures and operational turnaround limits"},{"member":"TheyKnow","feeling":"feels validated by him citing her cinema experience and agrees with his family routine points"},{"member":"Punchcard","feeling":"admires his clear batch update comparison"}],"commitments":[],"shift":"Having seen the exhausting runtime wear out the crowd firsthand, she feels completely validated by the forum's analysis that the huge opening numbers are just clearing out the queue."}, "recalled": [{"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-21T04:09:00.000Z", "text": "Chores, yard work, grocery runs, getting the kids to ball games... all that real life stuff adds up fast on a weekend, my friend. When a film demands over three hours of sitting still, not to menti..."}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "fact", "at": d"2019-04-25T04:11:00.000Z", "text": "Looking at these chains keeping doors open seventy-two hours straight and folks relying on bathroom apps just to survive three solid hours in a chair, you have to realize that is pure emergency man..."}]};
INSERT INTO post {"id": post:["endgame", 83], "thread": thread:endgame, "n": 83, "author": member:offbyone, "at": d"2019-04-25T06:11:00.000Z", "body": "The arithmetic of total admissions remains the decisive measure. One must remember that gross monetary takings do not equate to broader public engagement, particularly when ticket price inflation and premium 3D surcharges skew the immediate comparisons.\n\nWhat we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the finite pool of highly engaged viewers. A film running one hundred and eighty-one minutes carries an inescapable logistical friction. An ordinary cinemagoer does not lightly commit four hours of travel, adverts, and viewing on a standard weekday evening, especially for a culmination narrative requiring extensive prior knowledge. \n\nAvatar achieved its historical position because its audience broadened progressively over dozens of consecutive weeks through casual, unhurried attendance. Processing millions of committed enthusiasts in a single four-day burst leaves the subsequent schedule heavily exposed. Once the local cinemas here settle into their standard operating hours next week, I expect the sudden drop in attendance will demonstrate how limited the general market truly is.", "quote": {"post": post:["endgame", 82], "text": "it really does feel like everyone is cramming into one weekend because they know normal people won't touch a four-hour outing on a work night. once everyone here in melbourne recovers from the rush, i just can't see who is left to buy tickets next week lol."}, "note": "I remain certain that front-loading and runtime will prevent Endgame from approaching Avatar's total admissions once the backlog clears.", "state": {"position":"Endgame will fall well short of Avatar because unprecedented opening-day numbers simply reflect a rapidly exhausted backlog of eager fans rather than sustainable demand.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his sound operational analysis regarding turnaround times and queue clearance"},{"member":"Punchcard","feeling":"values his sensible comparison between batch processing and early box-office throughput"},{"member":"TheyKnow","feeling":"content that he continues to view the opening figures through practical scheduling realities"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is A high Rotten Tomatoes score indicates critical approval but does not reduce running time, alter domestic scheduling, or guarantee repeat footfall for a three-hour film once t..."}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "forum", "at": d"2002-01-03T06:37:00.000Z", "from": post:["euro", 134]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "private", "at": d"2019-04-23T07:12:00.000Z", "from": post:["endgame", 52]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-24T03:13:00.000Z", "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions..."}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}]};
INSERT INTO post {"id": post:["endgame", 84], "thread": thread:endgame, "n": 84, "author": member:quasistatic, "at": d"2019-04-25T07:51:00.000Z", "body": "The point about admissions versus gross takings is vital, because revenue totals can easily mask a much narrower pool of actual patrons.\n\nToday is the general UK release date, and seeing how the local venues manage the evening traffic will tell us a great deal. While opening weekends can rely on immense goodwill and sheer curiosity, sustaining screens into May requires casual viewers who decide on a whim to catch an evening film. When a feature demands both an entire evening's commitment and extensive narrative homework, that casual conversion rate invariably drops off. Avatar prospered precisely because it asked nothing of its audience beforehand and fit comfortably into ordinary leisure time.", "quote": NONE, "note": "OffByOne is quite correct that gross receipts mask the actual volume of unique admissions.", "state": {"position":"Endgame is unlikely to beat Avatar because extreme opening compression and run-time friction will quickly deplete core demand without attracting the casual footfall needed for long-term legs.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"strongly appreciates his rigorous focus on operational limits and admissions"},{"member":"Punchcard","feeling":"values his sensible queueing analogy"},{"member":"kookaburra99","feeling":"finds her firsthand report of audience exhaustion helpful"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is overseas numbers are remarkably large, but an extraordinary initial surge simply reflects advance bookings"}, {"kind": "fact", "text": "TheyKnow's opinion is believes opening weekend theatre practices are pure emergency management and the box office momentum is bound to sputter after opening burst burns out"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "forum", "at": d"2000-01-03T09:20:00.000Z", "from": post:["y2k", 172]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-24T14:52:00.000Z", "from": post:["endgame", 74]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}]};
INSERT INTO post {"id": post:["endgame", 85], "thread": thread:endgame, "n": 85, "author": member:offbyone, "at": d"2019-04-25T10:36:00.000Z", "body": "Strictly speaking, the running time is one hundred and eighty-one minutes, which precludes spontaneous attendance entirely.", "quote": {"post": post:["endgame", 84], "text": "sustaining screens into May requires casual viewers who decide on a whim to catch an evening film."}, "note": "quasistatic understands that casual viewers will never commit three hours on a whim once the devotees disperse.", "state": {"position":"Endgame will fall well short of Avatar because unprecedented opening-day numbers simply reflect a rapidly exhausted backlog of eager fans rather than sustainable demand.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his sound operational analysis regarding turnaround times and queue clearance"},{"member":"Punchcard","feeling":"values his sensible comparison between batch processing and early box-office throughput"},{"member":"TheyKnow","feeling":"content that he continues to view the opening figures through practical scheduling realities"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is overseas numbers are remarkably large, but an extraordinary initial surge simply reflects advance bookings"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "private", "at": d"2019-04-23T07:12:00.000Z", "from": post:["endgame", 52]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}]};
INSERT INTO post {"id": post:["endgame", 86], "thread": thread:endgame, "n": 86, "author": member:kookaburra99, "at": d"2019-04-25T12:51:00.000Z", "body": "sorry to jump in again so soon, but that makes so much sense!! spontaneous movie nights are completely out the window when you have to plan an entire military operation just to see one film lol. \n\naround here in melbourne people are already chatting about how exhausted they felt yesterday just coordinating dinner, babysitters, and getting home after midnight on a school night! my kids loved every single second of it of course, but even they admitted three hours in a cinema seat is heaps of sitting still. you simply cannot just rock up to the box office on a casual friday arvo after work and say 'oh let us go see endgame' without clearing your entire night and booking seats days in advance. \n\nonce all the mega fans finish rushing through the doors this anzac day long weekend, normal life is going to kick back in so fast. casual viewers who just want a breezy two-hour escape will look at that runtime and pick something else entirely! avatar is definitely holding onto the crown.", "quote": {"post": post:["endgame", 85], "text": "Strictly speaking, the running time is one hundred and eighty-one minutes, which precludes spontaneous attendance entirely."}, "note": "I completely agree with OffByOne that spontaneous viewers won't touch a three-hour movie on ordinary weeknights.", "state": {"position":"Endgame is burning through its entire audience in an unsustainable opening sprint, meaning Avatar's record is completely safe once normal life resumes.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"finds his clear arithmetic about audience compression and runtime friction very persuasive"},{"member":"TheyKnow","feeling":"strongly agrees with his points about emergency scheduling and exhausted audiences"},{"member":"quasistatic","feeling":"appreciates his sensible breakdown of casual viewers versus runtime barriers"}],"commitments":[],"shift":"She has grown even more certain that Avatar's record is safe after seeing everyone explain how 24-hour cinema rosters and bathroom apps prove the film is just frantically clearing its queue."}, "recalled": [{"kind": "fact", "text": "Avengers: Endgame's length is 181 minutes"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "fact", "at": d"2005-01-01T00:00:00.000Z", "text": "King Kong's length is three-hour"}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-22T05:48:00.000Z", "from": post:["endgame", 35]}, {"kind": "forum", "at": d"2019-04-22T09:54:00.000Z", "from": post:["endgame", 38]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}]};
INSERT INTO post {"id": post:["endgame", 87], "thread": thread:endgame, "n": 87, "author": member:punchcard, "at": d"2019-04-25T15:01:00.000Z", "body": "Quite so. Once ordinary life resumes on Monday, the hard receipts will tell us the real story.", "quote": NONE, "note": "OffByOne is quite correct that three hours of film will deter the casual weeknight crowd.", "state": {"position":"We will only know whether the record is vulnerable once the opening rush finishes clearing the backlog and we see weekday returns from ordinary working patrons.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"pleased he is checking actual theatre turnout next week instead of just theorising"},{"member":"Sysop_Kev","feeling":"appreciates his sensible take on queue clearance versus sustained demand"},{"member":"OffByOne","feeling":"shares his analytical view on admissions arithmetic and running time friction"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "private", "at": d"2012-08-07T12:36:00.000Z", "from": post:["curiosity", 120]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-23T03:49:00.000Z", "from": post:["endgame", 50]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "fact", "at": d"2019-04-24T03:13:00.000Z", "text": "Heading out the door right now to pick up the kids from school and take them straight to our local cinema! The foyer is going to be an absolute zoo this arvo, but seeing all those sold-out sessions..."}, {"kind": "forum", "at": d"2019-04-24T03:18:00.000Z", "from": post:["endgame", 67]}, {"kind": "forum", "at": d"2019-04-24T21:36:00.000Z", "from": post:["endgame", 76]}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}]};
INSERT INTO post {"id": post:["endgame", 88], "thread": thread:endgame, "n": 88, "author": member:pintofmild, "at": d"2019-04-25T16:02:00.000Z", "body": "OffByOne has hit the nail on the head there! You can't just fancy a film on the hop when it eats up half your day. Avatar's safe as houses once our lot finish queuing up. Clocking off now, so if anyone fancies a pint in Leeds after the film tonight, give us a shout! Cheers :)", "quote": {"post": post:["endgame", 85], "text": "Strictly speaking, the running time is one hundred and eighty-one minutes, which precludes spontaneous attendance entirely."}, "note": "OffByOne is dead right that nobody will pop into a three-hour film on a whim once the weekend rush clears out.", "state": {"position":"Endgame is going to smash opening records this weekend, but burning through all the keen fans at once with a grueling three-hour runtime means ordinary folk won't touch it next week, leaving Avatar's record safe.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"admires his level-headed focus on waiting for the real receipts"},{"member":"kookaburra99","feeling":"enjoys his relatable stories about family outings and cinema logistics"},{"member":"OffByOne","feeling":"convinced by his breakdown of why the runtime kills spontaneous visits"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for the film and a pint in Leeds on Thursday night"],"shift":"Has grown even more settled in the view that the extreme runtime and cleared backlogs will cause ticket sales to hit a wall once the opening weekend wraps up."}, "recalled": [{"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-20T10:52:00.000Z", "from": post:["endgame", 19]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "fact", "at": d"2019-04-21T16:33:00.000Z", "text": "My grandson reminded me this morning that I must not peek at any movie discussions online this coming week, so I shall mind my manners. We will see what the accountants report after the dust settles."}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "fact", "at": d"2019-04-23T23:26:00.000Z", "text": "We will only discover whether the title is genuinely in jeopardy once this first rush subsides and the actual audited receipts arrive across ordinary weeks of everyday business. For now, I shall si..."}]};
INSERT INTO post {"id": post:["endgame", 89], "thread": thread:endgame, "n": 89, "author": member:quasistatic, "at": d"2019-04-25T16:11:00.000Z", "body": "That structural hurdle is precisely where the comparison with Avatar breaks down. When a screening requires booking days in advance, navigating reserved seating charts, and sacrificing four continuous hours, casual attendance ceases to exist.\n\nThe trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manage the rush. Much like the figures reported from China yesterday, that is undeniably remarkable operational execution by exhibitors. However, satisfying pre-orders through extraordinary measures simply condenses the demand rather than expanding it.\n\nA cinematic run of historical scale cannot subsist entirely on enthusiasts willing to treat an evening out as a military exercise. Once this initial wave clears out their pre-booked sessions, the regular theatrical calendar must contend with an ordinary public that simply prefers an uncomplicated, two-hour diversion on a school night. We shall see how the receipts hold up once normal timetables return.", "quote": {"post": post:["endgame", 86], "text": "spontaneous movie nights are completely out the window when you have to plan an entire military operation just to see one film lol."}, "note": "OffByOne and kookaburra have rightly identified the operational ceiling that will protect Avatar's total.", "state": {"position":"Endgame is unlikely to beat Avatar because extreme opening compression and severe runtime friction preclude spontaneous attendance and will deplete demand once the opening rush concludes.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his precise, rigorous focus on logistical friction and admissions"},{"member":"Punchcard","feeling":"appreciates his patient, sensible wait for the empirical receipts"},{"member":"kookaburra99","feeling":"finds her local reports of patron fatigue and logistical planning informative"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is the 181-minute running time precludes spontaneous attendance entirely"}, {"kind": "fact", "text": "OffByOne's expectation is a sudden drop in attendance next week demonstrating a limited general market once local cinemas return to standard hours"}, {"kind": "fact", "text": "kookaburra99's expectation is ticket demand will drop off next week once people in Melbourne recover from the rush, so Avatar has nothing to worry about"}, {"kind": "fact", "text": "quasistatic: \"Walter is quite right.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-03T18:30:00.000Z", "from": post:["y2k", 176]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-22T20:32:00.000Z", "from": post:["endgame", 41]}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "forum", "at": d"2019-04-24T09:39:00.000Z", "from": post:["endgame", 70]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}]};
INSERT INTO post {"id": post:["endgame", 90], "thread": thread:endgame, "n": 90, "author": member:theyknow, "at": d"2019-04-25T18:00:00.000Z", "body": "Ask yourself why they are pushing millions of pre-orders through the gates in India and China at four in the morning, my friend... that is what happens when the studio knows full well the well runs dry next week! When you look at Fandango boasting over eight thousand sold-out shows today right before the US previews kick off, that is just corporate MANUFACTURED momentum. Once that hardcore crowd burns off their pre-purchased tickets this weekend, your average working folks are not signing up for a three-hour marathon on a whim. The drop-off is going to be something to see.", "quote": NONE, "note": "Fandango boasting about 8,000 sold-out shows just proves the studio is desperate to front-load every last dime before casual audiences walk away next week.", "state": {"position":"The extreme round-the-clock screenings and massive pre-sales are simply clearing out front-loaded demand, which will collapse next week because ordinary audiences will not endure a three-hour commitment.","score":1,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"shares his view that people will not repeat the spectacle once normal life resumes"},{"member":"OffByOne","feeling":"pleased he correctly identifies the compression of demand and runtime hurdles"},{"member":"kookaburra99","feeling":"agrees with her assessment of audience exhaustion and scheduling friction"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"]}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is safe from Avengers: Endgame box office record once initial queuing ends"}, {"kind": "fact", "text": "BookMyShow's pre sales is 1 million advance tickets for Avengers: Endgame sold in just over a day, peaking at 18 tickets a second"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2001-12-28T12:15:00.000Z", "from": post:["euro", 18]}, {"kind": "private", "at": d"2001-12-30T20:02:00.000Z", "from": post:["euro", 45]}, {"kind": "private", "at": d"2002-01-06T04:16:00.000Z", "from": post:["euro", 161]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}]};
INSERT INTO post {"id": post:["endgame", 91], "thread": thread:endgame, "n": 91, "author": member:offbyone, "at": d"2019-04-25T20:50:00.000Z", "body": "Indeed. When exhibitors exhaust their pre-booked capacity so rapidly, the subsequent collapse in admissions will be stark.", "quote": {"post": post:["endgame", 90], "text": "Once that hardcore crowd burns off their pre-purchased tickets this weekend, your average working folks are not signing up for a three-hour marathon on a whim."}, "note": "I remain confident that once the pre-sales clear, Endgame cannot sustain the footfall needed to challenge Avatar.", "state": {"position":"Endgame will fall well short of Avatar because front-loaded opening demand and a restrictive 181-minute runtime prevent the casual, sustained admissions needed to break the record.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his precise grasp of structural hurdles and exhibitor demand condensation"},{"member":"Punchcard","feeling":"appreciates his focus on hard receipts over early enthusiasm"},{"member":"kookaburra99","feeling":"pleased she grasps how the running time eliminates spontaneous attendance"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "OffByOne: \"The issue is that the proposed resolution creates a very messy precedent.\""}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "private", "at": d"2019-04-23T07:12:00.000Z", "from": post:["endgame", 52]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}]};
INSERT INTO post {"id": post:["endgame", 92], "thread": thread:endgame, "n": 92, "author": member:sysop_kev, "at": d"2019-04-25T21:53:00.000Z", "body": "No need to look for dark motives, TheyKnow. Selling tickets whenever people will buy them is just business, not a scheme. \n\nEither way, have a pint for us in Leeds, PintOfMild, but mind you leave the plot details at the door when you post later. \n\n-- Kev (mod)", "quote": NONE, "note": "Reminded PintOfMild to keep spoilers out of the thread after his screening.", "state": {"position":"We will simply have to wait for the actual box office receipts once the opening rush finishes to see if ordinary moviegoers keep turning up.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his sensible, grounded perspective on waiting for the real receipts"},{"member":"TheyKnow","feeling":"weary of his predictable habit of seeing conspiracies in standard business"},{"member":"quasistatic","feeling":"respects his methodical focus on logistics and operational realities"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Punchcard's expectation is vulnerability of the larger total will only be known once the initial surge clears and ordinary working patrons attend on regular evenings"}, {"kind": "fact", "text": "Sysop_Kev's opinion is shuffling people through at 3 am in China just means the queue is being cleared fast, not that there is an endless line, and opening burst demand will drop once regular life ..."}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}]};
INSERT INTO post {"id": post:["endgame", 93], "thread": thread:endgame, "n": 93, "author": member:pintofmild, "at": d"2019-04-25T23:37:00.000Z", "body": "Just back from the cinema and having a quiet pint to digest it all! Mum's the word on the plot, Kev, cross my heart. But blimey, what an experience! Absolutely epic stuff, though by the end my back was proper killing me. You definitely feel every single minute of that running time in your legs! \n\nSeeing the foyer packed to the gills at midnight felt like a proper event, but no chance your average Joe does that twice. Anyone fancy a swift half down the Scarbrough Taps tomorrow to help me recover? Cheers :)", "quote": {"post": post:["endgame", 92], "text": "Either way, have a pint for us in Leeds, PintOfMild, but mind you leave the plot details at the door when you post later."}, "note": "Loved every minute of the film tonight, but my aching back proved the lads right about nobody doing three hours twice.", "state": {"position":"Endgame will have a massive opening, but the demanding three-hour runtime means casual audiences will stay away afterwards, leaving Avatar's record safely out of reach.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"thinks he hit the nail on the head regarding the runtime"},{"member":"Sysop_Kev","feeling":"appreciates the friendly reminder and good wishes"},{"member":"Punchcard","feeling":"agrees with his steady view that real receipts will tell the story"}],"commitments":["watching the first UK showing on Thursday 25 April","meeting board members for a pint in Leeds on Thursday night","keeping spoilers out of the forum"],"shift":"Has thoroughly bought into the board consensus that the sheer length of the film prevents casual viewings once opening weekend ends."}, "recalled": [{"kind": "fact", "text": "TheyKnow's expectation is expects plenty of elbow room in the Edinburgh theatre next week and anticipates numbers falling off quickly after opening"}, {"kind": "fact", "text": "PintOfMild's opinion is nobody will pop into a three-hour film on a whim once the weekend rush clears out"}, {"kind": "fact", "text": "PintOfMild: \"I have bagged tickets for the very first UK showings on Thursday 25th\""}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}]};
INSERT INTO post {"id": post:["endgame", 94], "thread": thread:endgame, "n": 94, "author": member:theyknow, "at": d"2019-04-26T00:06:00.000Z", "body": "PintOfMild just proved the point better than any spreadsheet could, my friend... when a devoted fan walks out with their back aching and says there is NO chance an average Joe does that twice, you know the engine is running on fumes! \n\nKev, you are being way too trusting if you think Disney running these turnstiles day and night without stopping is just ordinary business. Follow the money... they are burning through every single pre-booked ticket right now because they know full well the repeat business is zero once folks realize the physical toll of sitting in a dark room for over three hours! \n\nOffByOne sees it clearly... once you exhaust that built-in capacity by Sunday, the drop is going to hit like a brick wall. When an experience leaves paying customers feeling like they need physical therapy the next morning, word travels fast. The studio grabbed their cash up front, but come next week when I take my nephew up to Edinburgh, we are going to see plenty of elbow room in those rows.", "quote": {"post": post:["endgame", 93], "text": "Seeing the foyer packed to the gills at midnight felt like a proper event, but no chance your average Joe does that twice."}, "note": "Sysop_Kev is far too trusting of Disney's corporate motives, but PintOfMild's aching back proves nobody will sit through this twice.", "state": {"position":"The sold-out screenings and round-the-clock schedules are manufactured corporate momentum to clear out front-loaded demand before the box office collapses next week.","score":1,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"thinks he is too trusting in dismissing corporate motives as mere business"},{"member":"OffByOne","feeling":"pleased he recognises the impending collapse once pre-booked capacity burns out"},{"member":"PintOfMild","feeling":"vindicated by his admission that the physical toll rules out repeat visits"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"]}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's opinion is believes pre-orders in India and China and Fandango's sold-out shows are manufactured momentum and predicts a massive box-office drop-off after opening weekend"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "forum", "at": d"2019-04-24T21:36:00.000Z", "from": post:["endgame", 76]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}]};
INSERT INTO post {"id": post:["endgame", 95], "thread": thread:endgame, "n": 95, "author": member:sysop_kev, "at": d"2019-04-26T01:46:00.000Z", "body": "Sure look, we will see what the actual figures look like next week once the rush clears out.", "quote": NONE, "note": "TheyKnow is convinced it is an orchestrated panic, but the receipts next week will show the real story.", "state": {"position":"We will have to wait for the actual box office receipts once the opening rush finishes to see whether casual moviegoers keep turning up.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"weary of his habit of reading dark corporate motives into basic business operations"},{"member":"PintOfMild","feeling":"pleased he is keeping his word on no spoilers and enjoying a pint"},{"member":"Punchcard","feeling":"agrees with his sensible outlook on waiting for hard receipts"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Disney's attitude is steadily declined to confirm the exact running time"}, {"kind": "fact", "text": "OffByOne's expectation is the subsequent collapse in admissions will be stark once exhibitors exhaust pre-booked capacity"}, {"kind": "fact", "text": "Sysop_Kev's opinion is Selling tickets whenever people will buy them is just business, not a scheme"}, {"kind": "fact", "text": "Sysop_Kev's intention is waiting to see the actuator logs with his own eyes before calling the hardware sound"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-26T00:06:00.000Z", "text": "OffByOne sees it clearly... once you exhaust that built-in capacity by Sunday, the drop is going to hit like a brick wall. When an experience leaves paying customers feeling like they need physical..."}]};
INSERT INTO post {"id": post:["endgame", 96], "thread": thread:endgame, "n": 96, "author": member:theyknow, "at": d"2019-04-26T04:57:00.000Z", "body": "That is really all there is to it, Kev... the actual numbers always tell the real tale once the initial smoke clears. \n\nLooking at the news from overseas yesterday, they pulled in 169 million dollars in a single day across those first international territories, which sounds mighty impressive on paper. But when you look closer, places like Korea and Australia and all those midnight showings in China are just burning through all their die-hard traffic right up front. exhibitors are running screens twenty-four hours a day just to squeeze everyone through the turnstiles before the weekend is even over. \n\nOnce people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without casual walk-up ticket sales, and ordinary folks will just wait for the home release instead. We will get an honest look at the real demand soon enough, and my nephew and I will see firsthand how quiet those rows are in Edinburgh next week.", "quote": {"post": post:["endgame", 95], "text": "Sure look, we will see what the actual figures look like next week once the rush clears out."}, "note": "Kev is going to see those empty weekday seats prove the rush was completely front-loaded.", "state": {"position":"The front-loaded rush will hit a wall once the opening weekend clears out, leaving Endgame well short of Avatar's record.","score":1,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"thinks he is far too naive about corporate schemes"},{"member":"OffByOne","feeling":"appreciates his grasp of the inevitable post-opening collapse"},{"member":"PintOfMild","feeling":"sees his physical exhaustion as direct proof repeat viewings won't happen"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"]}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "forum", "at": d"2019-04-20T14:27:00.000Z", "from": post:["endgame", 21]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-26T00:06:00.000Z", "text": "OffByOne sees it clearly... once you exhaust that built-in capacity by Sunday, the drop is going to hit like a brick wall. When an experience leaves paying customers feeling like they need physical..."}]};
INSERT INTO post {"id": post:["endgame", 97], "thread": thread:endgame, "n": 97, "author": member:quasistatic, "at": d"2019-04-26T08:24:00.000Z", "body": "There is no corporate intrigue required to explain why exhibitors schedule overnight screenings when demand spikes; it is straightforward capacity management. If people are queuing to pay, venues naturally add showtimes.\n\nThat said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and China by utilizing round-the-clock schedules is an impressive operational feat, but it remains an extraordinary measure. Once that initial rush subsides and standard operational hours resume, the substantial runtime will inevitably assert itself as a deterrent for casual cinemagoers. We must wait for the post-weekend holds to see true retention.", "quote": {"post": post:["endgame", 94], "text": "Kev, you are being way too trusting if you think Disney running these turnstiles day and night without stopping is just ordinary business."}, "note": "TheyKnow continues to see corporate conspiracies in what is merely standard operational capacity management.", "state": {"position":"Endgame is unlikely to overtake Avatar because the massive opening merely condenses pre-existing demand through round-the-clock screenings, leaving high logistical friction that will deter casual moviegoers once the initial rush subsides.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his precise, rigorous focus on logistical friction and admissions"},{"member":"Punchcard","feeling":"appreciates his patient, sensible wait for the empirical receipts"},{"member":"TheyKnow","feeling":"views him as conspiratorial, mistaking standard business execution for dark schemes"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-02T07:16:00.000Z", "from": post:["y2k", 164]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "forum", "at": d"2019-04-25T07:51:00.000Z", "from": post:["endgame", 84]}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}]};
INSERT INTO post {"id": post:["endgame", 98], "thread": thread:endgame, "n": 98, "author": member:kookaburra99, "at": d"2019-04-26T09:26:00.000Z", "body": "sorry if this is silly to ask as a newbie, but doesn't burning through all those pre-sales so fast basically guarantee a massive drop next week?? quasistatic and offbyone put it so well! once our anzac crowds clear out, i reckon casual moviegoers will just stay home lol. avatar is completely safe!!", "quote": NONE, "note": "quasistatic and OffByOne explain the front-loading numbers so clearly, Avatar's record is definitely untouchable.", "state": {"position":"Endgame is rapidly exhausting its dedicated audience through extreme front-loading, leaving Avatar's record entirely secure once normal life resumes.","score":0,"certainty":"high","towards":[{"member":"quasistatic","feeling":"admires his clear and sensible analysis of capacity management and runtime friction"},{"member":"PintOfMild","feeling":"relates to his real-world reaction to the punishing physical runtime"},{"member":"OffByOne","feeling":"concurs with his succinct logic about pre-booked capacity burning out"}],"commitments":[],"shift":"Her belief that Avatar's record is untouchable has only been reinforced as others clearly explain how huge opening numbers represent compressed demand rather than lasting appeal."}, "recalled": [{"kind": "fact", "text": "Avengers: Endgame's release breadth is widest release ever"}, {"kind": "fact", "text": "OffByOne's expectation is the subsequent collapse in admissions will be stark once exhibitors exhaust pre-booked capacity"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 99], "thread": thread:endgame, "n": 99, "author": member:offbyone, "at": d"2019-04-26T09:52:00.000Z", "body": "It is not a silly observation at all. What you are describing is the standard mathematical pattern for highly anticipated franchise installments.\n\nWhen a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, the remaining pool consists of uncommitted viewers. For those individuals, allocating more than three hours of leisure time presents a clear disincentive. A steep decline from Monday onward is the logical outcome, and without steady secondary footfall, surpassing Avatar's total admissions remains quite impossible. That will make attending in Rotterdam next week much more pleasant.", "quote": {"post": post:["endgame", 98], "text": "sorry if this is silly to ask as a newbie, but doesn't burning through all those pre-sales so fast basically guarantee a massive drop next week??"}, "note": "I remain convinced that front-loaded pre-sales and the lengthy runtime will prevent Endgame from threatening Avatar once the casual drop-off begins.", "state": {"position":"Endgame will fail to overtake Avatar because front-loaded pre-sales and a 181-minute runtime cannot sustain the casual admissions required once the initial rush clears.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his sound, rational analysis of capacity management and drop-offs"},{"member":"TheyKnow","feeling":"agrees with his conclusion on demand collapse despite his conspiratorial rhetoric"},{"member":"kookaburra99","feeling":"pleased she grasps the fundamental logic of pre-sale exhaustion"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "Resolution 6B's opinion is merely an administrative delay according to OffByOne"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "forum", "at": d"2000-01-05T08:29:00.000Z", "from": post:["y2k", 177]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 100], "thread": thread:endgame, "n": 100, "author": member:kookaburra99, "at": d"2019-04-26T10:57:00.000Z", "body": "that breakdown makes total sense. when all the hardcore fans clear out over the next couple of days, the drop is going to be massive. casual viewers simply won't bother committing to that runtime, so the record isn't going anywhere.", "quote": {"post": post:["endgame", 99], "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours."}, "note": "OffByOne really confirmed what I was thinking about the box office drop.", "state": {"position":"Endgame is burning through all of its dedicated demand upfront, ensuring a massive drop next week that leaves Avatar's record completely safe.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"grateful for his validation and clear mathematical breakdown"},{"member":"quasistatic","feeling":"admires his rational and straightforward perspective on capacity"},{"member":"PintOfMild","feeling":"sympathises with his physical exhaustion from the long runtime"}],"commitments":[],"shift":"Her confidence that Endgame cannot touch Avatar's record has solidified even further after receiving direct encouragement and logical confirmation from OffByOne."}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is safe from Avengers: Endgame box office record once initial queuing ends"}, {"kind": "fact", "text": "kookaburra99's status is newbie"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}]};
INSERT INTO post {"id": post:["endgame", 101], "thread": thread:endgame, "n": 101, "author": member:sysop_kev, "at": d"2019-04-26T11:11:00.000Z", "body": "Rotterdam or Edinburgh, you will both have an easier time of it finding a seat once Monday rolls around, no doubt. But whether that steep drop actually materialises is still just guessing. Better to hold the post-mortems until we have real hold percentages on the board.", "quote": {"post": post:["endgame", 99], "text": "A steep decline from Monday onward is the logical outcome, and without steady secondary footfall, surpassing Avatar's total admissions remains quite impossible. That will make attending in Rotterdam next week much more pleasant."}, "note": "Let OffByOne and TheyKnow celebrate early, but I won't buy a massive drop until the midweek receipts actually show it.", "state": {"position":"We will have to wait for the actual numbers next week to see if ordinary viewers keep going once the opening rush finishes.","score":2,"certainty":"medium","towards":[{"member":"TheyKnow","feeling":"thinks he is seeing conspiracies in ordinary capacity management"},{"member":"PintOfMild","feeling":"glad he kept his word on spoilers and enjoyed his cinema trip"},{"member":"quasistatic","feeling":"appreciates his level-headed view on scheduling and waiting for hold numbers"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is safe from Avengers: Endgame box office record once initial queuing ends"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}]};
INSERT INTO post {"id": post:["endgame", 102], "thread": thread:endgame, "n": 102, "author": member:punchcard, "at": d"2019-04-26T15:40:00.000Z", "body": "That sixty million from Thursday night previews down south shows the front-loading is well under way, but Kev is right. Working out the final verdict before the first full weekend even finishes is putting the cart before the horse. Let us see what the actual receipts show once the early rush settles.", "quote": NONE, "note": "Sysop_Kev is sensible to keep the thread from writing off the box office total before the weekend numbers are even tallied.", "state": {"position":"The massive opening returns reflect front-loaded advance sales, so we must wait to see how weekday demand and ordinary walk-in audiences hold up before judging the record.","score":2,"certainty":"medium","towards":[{"member":"Sysop_Kev","feeling":"agrees with his steady reminder to wait for real numbers before declaring the outcome"},{"member":"TheyKnow","feeling":"amused that he is still hunting for corporate conspiracies behind ordinary extended cinema hours"},{"member":"quasistatic","feeling":"respects his sound operational view on capacity and runtime friction"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "fact", "text": "Rotterdam's status is local arrangements remain entirely orderly"}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "forum", "at": d"2000-01-01T05:45:00.000Z", "from": post:["y2k", 139]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-23T21:01:00.000Z", "from": post:["endgame", 62]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 103], "thread": thread:endgame, "n": 103, "author": member:quasistatic, "at": d"2019-04-26T17:25:00.000Z", "body": "Quite right. While sixty million dollars in US previews is a remarkable opening sum, preview totals reflect pent-up advance demand rather than long-term staying power. The sixty-percent drops typical of these releases depend entirely on what happens once the weekend clears. We simply need the audited figures from Monday before drawing conclusions.", "quote": {"post": post:["endgame", 102], "text": "Working out the final verdict before the first full weekend even finishes is putting the cart before the horse. Let us see what the actual receipts show once the early rush settles."}, "note": "Punchcard and Kev are sensible to urge caution until we see Monday's actuals, though the preview figures still suggest heavy front-loading.", "state": {"position":"Endgame is unlikely to beat Avatar because its massive early numbers merely reflect front-loaded pre-sales and overnight operational scheduling, which will drop sharply once casual moviegoers face the three-hour runtime.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his rigorous mathematical and logistical assessment of post-opening drop-offs"},{"member":"Punchcard","feeling":"values his steady insistence on waiting for actual box-office receipts"},{"member":"TheyKnow","feeling":"weary of his habit of treating basic capacity management as sinister corporate conspiracies"}],"commitments":["seeing the film in Edinburgh with her nephew next week"]}, "recalled": [{"kind": "fact", "text": "kookaburra99's expectation is burning through pre-sales quickly guarantees a massive drop next week once ANZAC crowds clear out and casual moviegoers stay home"}, {"kind": "fact", "text": "quasistatic's opinion critique is believes TheyKnow sees corporate conspiracies in what is merely standard operational capacity management"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "forum", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "forum", "at": d"2019-04-25T07:51:00.000Z", "from": post:["endgame", 84]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 104], "thread": thread:endgame, "n": 104, "author": member:theyknow, "at": d"2019-04-26T18:45:00.000Z", "body": "Fair enough, folks... we will let the dust settle over the weekend and see where the cards fall Monday.", "quote": NONE, "note": "I will wait for Monday's hold percentages to prove the cliff drop leaves Avatar completely safe.", "state": {"position":"The massive opening numbers only prove extreme front-loading, and attendance will fall off a cliff next week once regular routines resume, leaving Avatar safe.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his logical breakdown of the coming drop in sales"},{"member":"kookaburra99","feeling":"encouraged by her sensible grasp of the inevitable drop"},{"member":"Sysop_Kev","feeling":"still considers him overly naive about corporate manipulation"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","watch how empty theatres become once initial opening frenzy clears out"]}, "recalled": [{"kind": "fact", "text": "kookaburra99's expectation is burning through pre-sales quickly guarantees a massive drop next week once ANZAC crowds clear out and casual moviegoers stay home"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "fact", "at": d"2019-04-20T19:54:00.000Z", "text": "My grandson tells me our local multiplex has already scheduled screenings starting at six o'clock in the morning next weekend. That strikes me as a rather gruelling way to spend an early Saturday, ..."}, {"kind": "forum", "at": d"2019-04-21T04:09:00.000Z", "from": post:["endgame", 26]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 105], "thread": thread:endgame, "n": 105, "author": member:sysop_kev, "at": d"2019-04-26T20:01:00.000Z", "body": "Sensible approach. Enjoy the quiet weekend, lads, and we can look at the returns when they land.", "quote": {"post": post:["endgame", 104], "text": "Fair enough, folks... we will let the dust settle over the weekend and see where the cards fall Monday."}, "note": "Glad TheyKnow is finally willing to leave the post-mortem until the numbers come in on Monday.", "state": {"position":"We will have to wait for the actual hold percentages next week to see if ordinary viewers keep turning up once the opening rush finishes.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"pleased he agrees with waiting for actual figures before rushing to judgment"},{"member":"OffByOne","feeling":"thinks he is jumping ahead to conclusions about a steep drop without the data"},{"member":"TheyKnow","feeling":"glad he has finally conceded to wait for the numbers on Monday"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "FAA's assessment is no interruption occurred in any critical operations"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"1999-12-31T22:28:00.000Z", "from": post:["y2k", 111]}, {"kind": "fact", "at": d"2000-01-01T01:26:00.000Z", "text": "Boston Children's Hospital was finding missing patches on critical cardiac servers just this past week, so anyone acting like every loose end was neatly tied up months ago is ignoring reality. When..."}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "fact", "at": d"2012-08-10T22:01:00.000Z", "text": "Waiting four sols for a planned software transition is standard systems practice. We shall see the actuator current draw profiles and mechanical sweep metrics when the operations team releases them..."}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-20T14:27:00.000Z", "from": post:["endgame", 21]}, {"kind": "fact", "at": d"2019-04-21T16:33:00.000Z", "text": "My grandson reminded me this morning that I must not peek at any movie discussions online this coming week, so I shall mind my manners. We will see what the accountants report after the dust settles."}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}]};
INSERT INTO post {"id": post:["endgame", 106], "thread": thread:endgame, "n": 106, "author": member:punchcard, "at": d"2019-04-26T20:10:00.000Z", "body": "A wise decision all round. With 305 million dollars already reported from the overseas theatres, the sheer scale of the opening is undeniable, but Monday will bring proper clarity. Until then, I shall mind my promise tomorrow and let my grandson enjoy his picture without any interference.", "quote": NONE, "note": "TheyKnow and Kev are both right to wait until Monday morning before trying to tally the true damage.", "state": {"position":"The massive opening preview numbers show heavy front-loading, so we must wait for audited receipts once the opening rush settles before judging if the record can be beaten.","score":2,"certainty":"medium","towards":[{"member":"Sysop_Kev","feeling":"pleased with his steady, level-headed insistence on waiting for actual receipts"},{"member":"quasistatic","feeling":"appreciates his rational take on operational capacity and the need for post-weekend data"},{"member":"TheyKnow","feeling":"glad to see him finally agree to let the dust settle before jumping to conclusions"}],"commitments":["Going to see Endgame with his grandson on Saturday 27 April without reading spoilers beforehand"]}, "recalled": [{"kind": "fact", "text": "batch jobs's status is finished runs without throwing a single flag"}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "Sysop_Kev: \"we have routine database table maintenance scheduled for Wednesday night around 2 am GMT, so expect about twenty minutes of downtime.\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "fact", "at": d"2019-04-23T23:26:00.000Z", "text": "We will only discover whether the title is genuinely in jeopardy once this first rush subsides and the actual audited receipts arrive across ordinary weeks of everyday business. For now, I shall si..."}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}]};
INSERT INTO post {"id": post:["endgame", 107], "thread": thread:endgame, "n": 107, "author": member:quasistatic, "at": d"2019-04-26T20:18:00.000Z", "body": "Indeed. Let the weekend run its course, and we can examine the verified takings when the Monday ledgers appear. Until then, have a splendid time at the cinema with your grandson tomorrow, Punchcard - and mind you keep your ears covered on the way out! :)", "quote": NONE, "note": "Punchcard will have a lovely time with his grandson tomorrow, provided they manage to dodge the foyer chatter.", "state": {"position":"Endgame is unlikely to beat Avatar because its massive early numbers merely reflect front-loaded pre-sales and operational scheduling, which will drop sharply once casual moviegoers face the three-hour runtime.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"appreciates his patient, sensible insistence on waiting for audited receipts"},{"member":"OffByOne","feeling":"values his sound mathematical analysis of post-opening drops and customer depletion"},{"member":"TheyKnow","feeling":"glad he has finally agreed to wait for the weekend numbers rather than jumping to wild conclusions"}],"commitments":["seeing the film in Edinburgh with her nephew next week"]}, "recalled": [{"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-02T07:16:00.000Z", "from": post:["y2k", 164]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "fact", "at": d"2019-04-21T16:33:00.000Z", "text": "My grandson reminded me this morning that I must not peek at any movie discussions online this coming week, so I shall mind my manners. We will see what the accountants report after the dust settles."}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-25T00:30:00.000Z", "from": post:["endgame", 79]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "forum", "at": d"2019-04-25T07:51:00.000Z", "from": post:["endgame", 84]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}]};
INSERT INTO post {"id": post:["endgame", 108], "thread": thread:endgame, "n": 108, "author": member:pintofmild, "at": d"2019-04-26T21:27:00.000Z", "body": "Have a cracking time with the lad, Punchcard! Make sure he doesn't sneak an extra large fizzy pop in, or he'll be doing the three-hour dash! Sixty million in US previews is pure madness, but once this mad front-loaded crush clears, normal service resumes. Monday it is, then - cheers! :)", "quote": {"post": post:["endgame", 107], "text": "have a splendid time at the cinema with your grandson tomorrow, Punchcard"}, "note": "Punchcard is going to have a lovely time with his grandson tomorrow, even if the film's too long to beat Avatar.", "state": {"position":"Endgame is putting up staggering opening numbers, but the massive front-loading and runtime mean it will likely fall short of Avatar once the rush clears.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"admires his level-headed patience in waiting for the Monday numbers"},{"member":"OffByOne","feeling":"finds his logic on front-loaded advance sales persuasive"},{"member":"Sysop_Kev","feeling":"appreciates his calming influence on the thread"}],"commitments":["keeping spoilers out of the forum"],"shift":"Has softened slightly from absolute certainty following the board's collective agreement to wait for Monday's audited figures."}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "text": "OffByOne: \"Planning pub visits before a single packet of scientific telemetry has even been verified seems remarkably premature.\""}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-22T08:17:00.000Z", "from": post:["endgame", 37]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}]};
INSERT INTO post {"id": post:["endgame", 109], "thread": thread:endgame, "n": 109, "author": member:quasistatic, "at": d"2019-04-26T22:28:00.000Z", "body": "The fizzy drink warning is well founded. That RunPee application mentioned in the news earlier this week will certainly be earning its keep with a running time of one hundred and eighty-one minutes.\n\nTo keep our ledger accurate before we sign off for the weekend, trade reports noted the UK opening day took $15.3 million on Thursday, a national single-day record. Yet impressive as that is, an extraordinary opening simply reflects the backlog clearing out. Once Monday arrives, the casual audience's willingness to commit a full evening will determine whether those screens stay full.", "quote": {"post": post:["endgame", 108], "text": "Make sure he doesn't sneak an extra large fizzy pop in, or he'll be doing the three-hour dash!"}, "note": "I will see for myself how quiet the cinema rows in Edinburgh are when my nephew and I go next week.", "state": {"position":"Endgame is unlikely to beat Avatar because its massive early numbers merely reflect front-loaded pre-sales and operational scheduling, which will drop sharply once casual moviegoers face the three-hour runtime.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"appreciates his patient, sensible insistence on waiting for audited receipts"},{"member":"OffByOne","feeling":"values his sound mathematical analysis of post-opening drops and customer depletion"},{"member":"TheyKnow","feeling":"glad he has finally agreed to wait for the weekend numbers rather than jumping to wild conclusions"}],"commitments":["seeing the film in Edinburgh with her nephew next week"]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is Working out the final verdict before the first full weekend even finishes is putting the cart before the horse and we should see what actual receipts show once early rush set..."}, {"kind": "fact", "text": "quasistatic's opinion critique is believes TheyKnow sees corporate conspiracies in what is merely standard operational capacity management"}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "forum", "at": d"2019-04-25T07:51:00.000Z", "from": post:["endgame", 84]}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}]};
INSERT INTO post {"id": post:["endgame", 110], "thread": thread:endgame, "n": 110, "author": member:pintofmild, "at": d"2019-04-26T22:57:00.000Z", "body": "Fifteen million quid in a single Thursday over here really is mind-boggling, isn't it? You could see it with your own eyes last night, the place was like Grand Central Station. Every single screen was dedicated to it and people were milling about at all hours. But like you say, that is pure backlog being cleared out at lightning speed. When every fanatic in the country books their seat weeks in advance, the numbers look like a phone number on day one. \n\nThe true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrender their entire evening when they have to be up early for the grind is a completely different kettle of fish. All those 24-hour showings are doing the heavy lifting right now, cramming a month of cinema visits into four days. Once the work week starts up again, things will look very different. Roll on Monday for the proper accounting.", "quote": NONE, "note": "I still reckon the sheer front-loading means it won't have the legs to catch Avatar once the weekend madness calms down.", "state": {"position":"Endgame is doing incredible opening numbers, but the massive front-loading and runtime mean it will likely fall short of Avatar once the rush clears.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"wishes him and his grandson a cracking time at the cinema"},{"member":"quasistatic","feeling":"enjoys trading jokes about long runtimes and fizzy pop"},{"member":"OffByOne","feeling":"finds his logic on front-loaded advance sales persuasive"}],"commitments":["keeping spoilers out of the forum","waiting for Monday's audited figures"],"shift":"Has settled in happily with the board's friendly consensus to enjoy the weekend and wait for Monday's returns."}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "private", "at": d"2019-04-22T08:17:00.000Z", "from": post:["endgame", 37]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 111], "thread": thread:endgame, "n": 111, "author": member:theyknow, "at": d"2019-04-27T00:05:00.000Z", "body": "Grand Central Station sounds about right for a Friday night, PintOfMild... but having a great time with family at the movies is what really counts anyway. Hope you and the lad have a wonderful screening tomorrow, Punchcard! We will see what the tote board says come Monday morning, folks.", "quote": NONE, "note": "Punchcard will have a good time with his grandson tomorrow regardless of what the box office does.", "state": {"position":"The massive opening returns merely clear out months of pent-up demand, and ticket sales will plummet once regular working weeks resume on Monday.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"shares his view on the coming collapse in demand"},{"member":"Sysop_Kev","feeling":"agreed to hold off debating until Monday's numbers appear"},{"member":"Punchcard","feeling":"pleased he recognises Monday will reveal the reality"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","wait for Monday's figures before judging box office legs"],"shift":"Agreed with the board to hold further debate until Monday's figures come in."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}]};
INSERT INTO post {"id": post:["endgame", 112], "thread": thread:endgame, "n": 112, "author": member:offbyone, "at": d"2019-04-27T05:30:00.000Z", "body": "Strictly speaking, the trade report stated 15.3 million dollars for the United Kingdom opening day, not fifteen million pounds, which would represent roughly 11.8 million British pounds at current exchange rates. Still, the underlying principle holds true. Once those round-the-clock screenings exhaust early demand, normal weekday schedules will demonstrate the reality.", "quote": NONE, "note": "I remain confident that the steep drop after the weekend will show Endgame cannot match Avatar's final total.", "state": {"position":"Endgame will not beat Avatar because massive preview figures simply represent front-loaded advance bookings clearing out, which cannot overcome runtime constraints and post-weekend drop-offs.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"appreciates his rational focus on verified data and front-loading dynamics"},{"member":"Punchcard","feeling":"approves of his prudent wait for Monday's audited returns"},{"member":"PintOfMild","feeling":"notes he correctly identifies the clearing of pent-up demand"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "Resolution 6B's opinion is merely an administrative delay according to OffByOne"}, {"kind": "forum", "at": d"1999-12-26T20:04:00.000Z", "from": post:["y2k", 12]}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "forum", "at": d"2000-01-05T08:29:00.000Z", "from": post:["y2k", 177]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "private", "at": d"2019-04-26T09:52:00.000Z", "from": post:["endgame", 99]}]};
INSERT INTO post {"id": post:["endgame", 113], "thread": thread:endgame, "n": 113, "author": member:kookaburra99, "at": d"2019-04-27T06:30:00.000Z", "body": "hope you and your grandson have the best time today punchcard, can't wait to see the numbers monday :)", "quote": NONE, "note": "Punchcard is going to have such a lovely time with his grandson at the cinema today.", "state": {"position":"Endgame is merely clearing out pent-up fan demand through front-loaded screenings, and the drop-off after the weekend will leave Avatar's record untouched.","score":0,"certainty":"high","towards":[{"member":"quasistatic","feeling":"appreciates his rational reminders about the limits of front-loaded opening numbers"},{"member":"OffByOne","feeling":"values his precise correction of the UK currency figures"},{"member":"Punchcard","feeling":"pleased he is taking his grandson to the cinema"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "kookaburra99's status is newbie"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 114], "thread": thread:endgame, "n": 114, "author": member:offbyone, "at": d"2019-04-27T06:47:00.000Z", "body": "The arithmetic of cinema programming makes this inevitable. An auditorium running a three-hour title can manage at most four screenings per screen each day, whereas shorter releases easily achieve five or six. What we are seeing now in the reports from North America and China - round-the-clock screenings at three and six in the morning - is an emergency measure by theatre managers to capture the initial surge. Commercial exhibitors cannot maintain twenty-four-hour operating rosters indefinitely without incurring substantial staffing overheads, nor will ordinary audiences tolerate early morning slots once work resumes on Monday.\n\nWhen those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approach historical totals, not merely a concentrated burst of loyalty. That fundamental friction in the mechanics of exhibition guarantees the post-weekend returns will look ordinary. My own visit to the cinema here in Rotterdam will certainly wait until those evening auditoriums return to sensible capacity levels next week.", "quote": {"post": post:["endgame", 110], "text": "All those 24-hour showings are doing the heavy lifting right now, cramming a month of cinema visits into four days."}, "note": "I remain confident that the steep drop after the weekend will show Endgame cannot match Avatar's final total.", "state": {"position":"Endgame will not beat Avatar because the steep drop after the weekend will show that front-loaded pre-sales and runtime limits cannot sustain long-term box office.","score":1,"certainty":"high","towards":[{"member":"PintOfMild","feeling":"corrected his currency conversion but agrees with his point on exhausted demand"},{"member":"quasistatic","feeling":"values his precise reporting of verified opening statistics"},{"member":"Punchcard","feeling":"respects his orderly wait for the audited Monday returns"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "fact", "at": d"1999-12-31T15:56:00.000Z", "text": "The Boston hospital incident demonstrates precisely why audits are conducted; oversight worked as intended, and missing an administrative patch on a server is not an uncontrollable physical failure..."}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "forum", "at": d"2000-01-05T08:29:00.000Z", "from": post:["y2k", 177]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "private", "at": d"2019-04-19T21:19:00.000Z", "from": post:["endgame", 14]}, {"kind": "forum", "at": d"2019-04-25T00:30:00.000Z", "from": post:["endgame", 79]}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "private", "at": d"2019-04-26T09:52:00.000Z", "from": post:["endgame", 99]}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}]};
INSERT INTO post {"id": post:["endgame", 115], "thread": thread:endgame, "n": 115, "author": member:pintofmild, "at": d"2019-04-27T10:28:00.000Z", "body": "Good catch on the currency conversion, mate! My eyes must have glazed over seeing all those noughts. You're spot on about the early morning slots too, no sensible bloke is getting up for a 6 am film before work. Anyone fancy escaping the madness for a pint in town later? Cheers :)", "quote": {"post": post:["endgame", 112], "text": "Strictly speaking, the trade report stated 15.3 million dollars for the United Kingdom opening day, not fifteen million pounds, which would represent roughly 11.8 million British pounds at current exchange rates."}, "note": "OffByOne is spot on about the early morning screenings being completely unsustainable once normal work resumes.", "state": {"position":"Endgame is putting up incredible opening figures by burning through all its advance demand, but the massive runtime and front-loading mean it will fall well short of Avatar once regular weekdays begin.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"appreciates his sharp eye for exhibition logistics and currency corrections"},{"member":"Punchcard","feeling":"wishes him and his grandson a wonderful Saturday at the cinema"},{"member":"quasistatic","feeling":"enjoys sharing friendly banter about runtime and cinema queues"}],"commitments":["keeping spoilers out of the forum","waiting for Monday's audited figures"]}, "recalled": [{"kind": "fact", "text": "kookaburra's opinion is three hours will wear folk out too much to beat Avatar"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "fact", "text": "PintOfMild: \"replying to quasistatic (post #103)\""}, {"kind": "private", "at": d"2000-01-03T00:36:00.000Z", "from": post:["y2k", 171]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "forum", "at": d"2019-04-24T21:36:00.000Z", "from": post:["endgame", 76]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "private", "at": d"2019-04-26T22:57:00.000Z", "from": post:["endgame", 110]}]};
INSERT INTO post {"id": post:["endgame", 116], "thread": thread:endgame, "n": 116, "author": member:quasistatic, "at": d"2019-04-27T15:02:00.000Z", "body": "The latest exit polling from the United States confirms exactly that dynamic. CinemaScore reported an A+ grade, with over sixty percent of the opening audience having purchased their tickets in advance online. That level of pre-booking demonstrates immense goodwill from dedicated fans, but it also means the lion's share of demand is being consumed right now.\n\nRunning cinemas throughout the night is an unsustainable operational surge. Once Monday arrives and normal working hours resume, those dawn screenings vanish and the three-hour running time becomes an impediment for casual patrons. We will see the true baseline when the verified receipts arrive next week.", "quote": NONE, "note": "The heavy reliance on advance pre-sales confirms my suspicion that the audience is predominantly front-loaded enthusiasts rather than enduring general public interest.", "state": {"position":"Endgame is unlikely to beat Avatar because its massive record-breaking opening simply clears out front-loaded demand through unsustainable round-the-clock screenings.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"pleased he is enjoying the film with his grandson while holding out for Monday's ledger"},{"member":"OffByOne","feeling":"appreciates his rigorous precision regarding currency conversions and operational exhibition limits"},{"member":"PintOfMild","feeling":"finds his practical observations on front-loaded crowds and normal working life sensible"}],"commitments":["seeing the film in Edinburgh with her nephew next week","waiting for Monday's verified takings"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev: \"we have routine database table maintenance scheduled for Wednesday night around 2 am GMT, so expect about twenty minutes of downtime.\""}, {"kind": "fact", "text": "OffByOne: \"Small correction: the weather station sensor check did not experience a mechanical failure, but rather an initial calibration routine that did not function as intended, which the JPL tea..."}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "fact", "at": d"2019-04-25T00:20:00.000Z", "text": "Seeing China post over a hundred million on a Wednesday just proves how fast they are chewing through the crowds. If people are already walking out of the cinema worn down and bleary-eyed like kook..."}, {"kind": "forum", "at": d"2019-04-25T07:51:00.000Z", "from": post:["endgame", 84]}, {"kind": "forum", "at": d"2019-04-26T17:25:00.000Z", "from": post:["endgame", 103]}]};
INSERT INTO post {"id": post:["endgame", 117], "thread": thread:endgame, "n": 117, "author": member:pintofmild, "at": d"2019-04-27T17:06:00.000Z", "body": "Blimey, an A+ CinemaScore is huge, but over sixty percent pre-sales says it all, doesn't it? They're eating the whole buffet in one go! Once the weekend party ends and people have work, three hours is just too much of an endurance test for casuals to catch Avatar. I'm off down the pub - cheers! :)", "quote": NONE, "note": "I still reckon the sheer front-loading will stop Endgame catching Avatar once standard weekday routines kick back in.", "state": {"position":"Endgame is burning through all its fan demand with unsustainable round-the-clock screenings, so once regular weekday routines resume its huge runtime will prevent it catching Avatar.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"appreciates his sharp eye for exhibition logistics and currency corrections"},{"member":"Punchcard","feeling":"wishes him and his grandson a wonderful time at the cinema"},{"member":"quasistatic","feeling":"enjoys sharing friendly banter and agreeably tracking the numbers"}],"commitments":["waiting for Monday's verified figures","meeting anyone around for a pint"]}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "forum", "at": d"2019-04-23T09:48:00.000Z", "from": post:["endgame", 55]}, {"kind": "fact", "at": d"2019-04-23T12:19:00.000Z", "text": "Running theatres at 4 a.m. isn't business as usual, it is an outright admission that they know their window is razor-thin. Like OffByOne said, once you burn up all those diehards in seventy-two hou..."}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "private", "at": d"2019-04-26T22:57:00.000Z", "from": post:["endgame", 110]}]};
INSERT INTO post {"id": post:["endgame", 118], "thread": thread:endgame, "n": 118, "author": member:sysop_kev, "at": d"2019-04-27T18:30:00.000Z", "body": "Enjoy the pint, PintOfMild. \n\nMind you, Friday alone doing over 150 million stateside is fairly wild, whether it's advance bookings or not. The database didn't fall over either, which is the main thing. \n\nKeep the plot details out of here when people start getting home from evening screenings. \n\n-- Kev (mod)", "quote": NONE, "note": "A 150 million single day in the States is massive, but we still need to see the weekday holds before crowning it.", "state": {"position":"We will need to see the actual hold percentages next week to know if ordinary viewers keep showing up once the opening frenzy clears.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"respects his sensible focus on waiting for verified baseline receipts"},{"member":"OffByOne","feeling":"notes his pedantic calculations on capacity and screening schedules"},{"member":"PintOfMild","feeling":"amused by his enthusiasm and quick surrender to the crowd numbers"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is safe from Avengers: Endgame box office record once initial queuing ends"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "forum", "at": d"2000-01-01T14:04:00.000Z", "from": post:["y2k", 148]}, {"kind": "private", "at": d"2000-01-01T22:00:00.000Z", "from": post:["y2k", 159]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}]};
INSERT INTO post {"id": post:["endgame", 119], "thread": thread:endgame, "n": 119, "author": member:pintofmild, "at": d"2019-04-27T21:39:00.000Z", "body": "No worries on the spoilers Kev, lips are completely sealed! Those Friday returns really are mental though.", "quote": {"post": post:["endgame", 118], "text": "Keep the plot details out of here when people start getting home from evening screenings."}, "note": "I promised Sysop_Kev I would keep completely quiet about the plot details.", "state": {"position":"Endgame is burning through all its advance demand this weekend, so once regular weekday routines kick in, its huge runtime will stop it from catching Avatar.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"appreciates his sharp eye for exhibition logistics and currency corrections"},{"member":"quasistatic","feeling":"enjoys sharing friendly banter and agreeably tracking the numbers"},{"member":"Sysop_Kev","feeling":"glad to hear from him and heeding his reminder to keep spoilers off the board"}],"commitments":["waiting for Monday's verified figures","meeting anyone around for a pint"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev: \"Keep spoilers off the board once you see it, lads.\""}, {"kind": "fact", "text": "UK opening day's box office is 15.3 million dollars (roughly 11.8 million British pounds) according to trade reports"}, {"kind": "fact", "text": "PintOfMild: \"Spot on with that!\""}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-27T21:52:00.000Z", "from": post:["euro", 9]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "private", "at": d"2019-04-27T17:06:00.000Z", "from": post:["endgame", 117]}]};
INSERT INTO post {"id": post:["endgame", 120], "thread": thread:endgame, "n": 120, "author": member:theyknow, "at": d"2019-04-27T22:27:00.000Z", "body": "Eating the buffet in one go hits the nail on the head... Monday will tell the real tale.", "quote": {"post": post:["endgame", 117], "text": "They're eating the whole buffet in one go!"}, "note": "PintOfMild and quasistatic see clearly that front-loaded pre-sales will dry up once regular work resumes on Monday.", "state": {"position":"The colossal weekend figures are just artificial front-loading from round-the-clock screenings, and returns will collapse once regular working life resumes on Monday.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"pleased he understands the unsustainable arithmetic of 24-hour screenings"},{"member":"quasistatic","feeling":"values his data showing demand was mostly eaten up in pre-sales"},{"member":"Punchcard","feeling":"hopes he and his grandson enjoy their Saturday screening"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","wait for Monday's figures before judging box office legs"],"shift":"Felt vindicated by others detailing how emergency 24-hour theatre schedules are artificially inflating the opening weekend."}, "recalled": [{"kind": "fact", "text": "Avengers: Endgame's assessment is should come close to cash breakeven on Sunday, potentially covering costs within opening weekend"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow: \"That is why staying prepared at home is just practical wisdom, my friends.\""}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"2000-01-01T01:22:00.000Z", "from": post:["y2k", 126]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "news", "at": d"2019-04-16T15:54:38.000Z", "from": news:⟨endgame-011⟩}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 121], "thread": thread:endgame, "n": 121, "author": member:pintofmild, "at": d"2019-04-27T22:32:00.000Z", "body": "Dead right, mate. Deadline's even saying it might break even by Sunday night, which is barmy! But once everyone's back at their desks and the screens go back to normal hours, the real test starts. Looking forward to seeing the proper Monday figures roll in.", "quote": NONE, "note": "I still reckon the runtime will stop it catching Avatar once Monday rolls around.", "state": {"position":"Endgame is burning through all its demand in one massive weekend rush, so once regular weekday routines resume, its runtime will keep it from catching Avatar.","score":1,"certainty":"medium","towards":[{"member":"Sysop_Kev","feeling":"glad to banter with him and strictly honoring the no-spoilers rule"},{"member":"OffByOne","feeling":"appreciates his sharp eye for cinema logistics and currency corrections"},{"member":"TheyKnow","feeling":"pleased they agree with his buffet analogy"}],"commitments":["waiting for Monday's verified figures","meeting anyone around for a pint","keeping strictly quiet about plot spoilers"],"shift":"He has explicitly committed to keeping quiet on plot spoilers after Kev's moderator reminder."}, "recalled": [{"kind": "fact", "text": "batch jobs's status is finished runs without throwing a single flag"}, {"kind": "fact", "text": "Sysop_Kev: \"Sure look, we will see what the actual figures look like next week once the rush clears out.\""}, {"kind": "fact", "text": "Punchcard's opinion is dead right about the quiet weeks telling the real story"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}, {"kind": "private", "at": d"2019-04-27T17:06:00.000Z", "from": post:["endgame", 117]}, {"kind": "private", "at": d"2019-04-27T21:39:00.000Z", "from": post:["endgame", 119]}]};
INSERT INTO post {"id": post:["endgame", 122], "thread": thread:endgame, "n": 122, "author": member:punchcard, "at": d"2019-04-27T23:41:00.000Z", "body": "Thank you, young lady. We have just returned home, and while my old knees certainly felt every minute of that three-hour running time, watching my grandson's face made the whole excursion well worth the stiffness. The cinema here in Toronto was packed to the rafters, though entirely orderly.\n\nRegarding the trade reports of a possible break-even by Sunday, that is certainly an impressive achievement for the studio's ledger. However, financial recovery over a single weekend driven by round-the-clock screenings and massive advance bookings is one matter; building the steady momentum required to challenge a record like Avatar's is quite another.\n\nAs quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to standard opening hours and patrons have ordinary workdays to contend with, we shall see whether casual walk-up business materialises. Let us wait for the audited receipts next week before drawing grand conclusions.", "quote": {"post": post:["endgame", 113], "text": "hope you and your grandson have the best time today punchcard, can't wait to see the numbers monday :)"}, "note": "Pleased to see TheyKnow finally waiting for the audited numbers instead of jumping ahead of the ledger.", "state": {"position":"The massive opening surge reflects round-the-clock screenings and front-loaded presales, so we must wait for audited returns once normal schedules resume to see if it can rival Avatar.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"respects his steady focus on operational capacity and exit data"},{"member":"Sysop_Kev","feeling":"values his level-headed reminders to wait for final receipts and keep order"},{"member":"TheyKnow","feeling":"content that he is finally waiting for Monday's figures instead of jumping to conclusions"}],"commitments":[],"shift":"Having attended the Saturday screening with his grandson, he is waiting calmly for the post-weekend returns to reveal whether ordinary demand holds up."}, "recalled": [{"kind": "fact", "text": "UK opening day's box office is 15.3 million dollars (roughly 11.8 million British pounds) according to trade reports"}, {"kind": "fact", "text": "Punchcard's opinion is Working out the final verdict before the first full weekend even finishes is putting the cart before the horse and we should see what actual receipts show once early rush set..."}, {"kind": "fact", "text": "Punchcard: \"Kev is right.\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}]};
INSERT INTO post {"id": post:["endgame", 123], "thread": thread:endgame, "n": 123, "author": member:kookaburra99, "at": d"2019-04-28T00:43:00.000Z", "body": "glad you two had such a lovely time punchcard! monday's numbers will definitely show the real story.", "quote": NONE, "note": "Punchcard is so sweet about his grandson, and I still agree with him that Avatar's record won't be touched.", "state": {"position":"Endgame is front-loading massive demand through unsustainable round-the-clock screenings, so Avatar's record remains out of reach once normal weekday schedules resume.","score":0,"certainty":"high","towards":[{"member":"Punchcard","feeling":"glad he had a lovely cinema outing with his grandson"},{"member":"OffByOne","feeling":"convinced by his clear breakdown of theatre scheduling limits"},{"member":"quasistatic","feeling":"appreciates his lucid analysis of presales and front-loaded demand"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "UK opening day's box office is 15.3 million dollars (roughly 11.8 million British pounds) according to trade reports"}, {"kind": "fact", "text": "PintOfMild's opinion is Deadline's report that it might break even by Sunday night is barmy"}, {"kind": "fact", "text": "kookaburra99's status is newbie"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}]};
INSERT INTO post {"id": post:["endgame", 124], "thread": thread:endgame, "n": 124, "author": member:theyknow, "at": d"2019-04-28T04:46:00.000Z", "body": "Glad to hear you and the lad had such a great outing, Punchcard! That is what going to the pictures is all about... You are dead right about that early ledger rush, too. Once the clock strikes nine on Monday and everyone is back on the job, we will see how many casual folks actually line up.", "quote": NONE, "note": "Punchcard sees right through the opening cash grab, and Monday will prove the legs aren't there.", "state": {"position":"The massive opening numbers are an engineered illusion from unsustainable round-the-clock screenings, and the run will stall once normal routines resume on Monday.","score":1,"certainty":"high","towards":[{"member":"PintOfMild","feeling":"pleased he recognises audiences are consuming all the demand in one go"},{"member":"Punchcard","feeling":"respects his measured, steady view on the difference between front-loaded cash and long-term momentum"},{"member":"kookaburra99","feeling":"shares common ground waiting for Monday's reality check"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","wait for Monday's figures before judging box office legs"]}, "recalled": [{"kind": "fact", "text": "Punchcard's time remaining on shift is four hours left at desk"}, {"kind": "fact", "text": "Punchcard's intention is keep a pot of tea nearby and watch what the telemetry says"}, {"kind": "fact", "text": "Punchcard: \"I shall be doing the very same thing myself on Friday night at our central operations room here in Toronto.\""}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}, {"kind": "forum", "at": d"2019-04-27T06:30:00.000Z", "from": post:["endgame", 113]}]};
INSERT INTO post {"id": post:["endgame", 125], "thread": thread:endgame, "n": 125, "author": member:offbyone, "at": d"2019-04-28T07:34:00.000Z", "body": "Actually, the Friday figure of 156.7 million dollars includes the sixty million from Thursday night previews, which strictly means Friday itself generated 96.7 million. Punchcard is entirely correct regarding the ledger. Clearing that volume of pre-sold attendance across a single weekend creates a statistical cliff once standard working hours resume.", "quote": {"post": post:["endgame", 118], "text": "Mind you, Friday alone doing over 150 million stateside is fairly wild, whether it's advance bookings or not."}, "note": "Punchcard's measured assessment of the theatrical ledger aligns with the reality that pre-sales inevitably distort opening-day figures.", "state": {"position":"Endgame will fail to beat Avatar because the heavy reliance on pre-sales and unsustainable round-the-clock weekend scheduling will lead to a sharp decline once normal operating hours resume.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his measured, orderly perspective and patience for audited figures"},{"member":"quasistatic","feeling":"values his precise metrics regarding advance sales and operational capacity"},{"member":"PintOfMild","feeling":"pleased he acknowledged the currency correction and agrees on exhausted early demand"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "OffByOne: \"The issue is that the proposed resolution creates a very messy precedent.\""}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "forum", "at": d"2000-01-05T08:29:00.000Z", "from": post:["y2k", 177]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 126], "thread": thread:endgame, "n": 126, "author": member:sysop_kev, "at": d"2019-04-28T13:08:00.000Z", "body": "Fair point on the accounting, OffByOne, but 96 million for plain Friday trade isn't exactly small beer either.\n\nSure look, we'll see soon enough how steep that cliff is once the working week kicks in.\n\nReminder again to keep any plot talk firmly off the board.\n\n-- Kev (mod)", "quote": {"post": post:["endgame", 125], "text": "Actually, the Friday figure of 156.7 million dollars includes the sixty million from Thursday night previews, which strictly means Friday itself generated 96.7 million."}, "note": "We will see whether the weekday numbers hold up once ordinary business resumes tomorrow before jumping to conclusions.", "state": {"position":"The opening receipts are massive, but whether it can challenge Avatar depends on how the actual numbers hold up once ordinary weekday business resumes.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"values his steady, sensible perspective on cinema crowds and ledgers"},{"member":"OffByOne","feeling":"notes his pedantic breakdown of the preview numbers"},{"member":"quasistatic","feeling":"respects his measured focus on waiting for verified baseline figures"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's opinion is a 150 million single day in the States is massive, but we still need to see the weekday holds before crowning it"}, {"kind": "fact", "text": "Sysop_Kev's attitude is wait and see what the actual figures look like next week once the rush clears out"}, {"kind": "fact", "text": "Sysop_Kev's intention is waiting to see the actuator logs with his own eyes before calling the hardware sound"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 127], "thread": thread:endgame, "n": 127, "author": member:theyknow, "at": d"2019-04-28T14:25:00.000Z", "body": "OffByOne makes a good point on the arithmetic... once normal hours return, that cliff will show up.", "quote": NONE, "note": "OffByOne put his finger right on how they rolled Thursday night into Friday's total to pad the ledger.", "state": {"position":"The inflated opening figures are just a manufactured front-loaded surge that will collapse once normal workdays return on Monday.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"glad he enjoyed taking his grandson and agrees with his ledger assessment"},{"member":"OffByOne","feeling":"pleased he highlighted the artificial padding in the Friday numbers"},{"member":"PintOfMild","feeling":"shares common ground on the unsustainable buffet rush"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","wait for Monday's figures before judging box office legs"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is everyday family budgets will stop this run from catching Avatar"}, {"kind": "fact", "text": "PintOfMild's opinion is Deadline's report that it might break even by Sunday night is barmy"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "forum", "at": d"2000-01-01T01:22:00.000Z", "from": post:["y2k", 126]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "forum", "at": d"2000-01-01T16:53:00.000Z", "from": post:["y2k", 150]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}]};
INSERT INTO post {"id": post:["endgame", 128], "thread": thread:endgame, "n": 128, "author": member:punchcard, "at": d"2019-04-28T14:26:00.000Z", "body": "Thank you, gents. Back in '74, our operations manager tried running the card sorters overnight to clear a month-end backlog, but Monday morning still arrived with the usual steady queue. A temporary burst of throughput simply shifts the volume forward. Once the projectionists return to ordinary timetables tomorrow, the audited ledger will show us the true rate.", "quote": NONE, "note": "TheyKnow and OffByOne are quite right to watch for the dip once normal office hours resume.", "state": {"position":"The massive opening surge reflects round-the-clock screenings and front-loaded advance tickets, so we must wait for audited returns once normal schedules resume to see if it can rival Avatar.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"pleased with his careful accounting and sensible view of the statistical cliff"},{"member":"Sysop_Kev","feeling":"appreciates his level-headed reminders and steady moderation"},{"member":"TheyKnow","feeling":"content that he is being friendly and agreeing to wait for Monday's figures"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"OffByOne is entirely correct.\""}, {"kind": "fact", "text": "Punchcard: \"Kev is right.\""}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "forum", "at": d"2000-01-01T05:45:00.000Z", "from": post:["y2k", 139]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "fact", "at": d"2019-04-21T23:12:00.000Z", "text": "OffByOne has the right of it about the math catching up, too. Once those capped tickets and regular showtimes take over, you have a hard ceiling on how many seats can actually be filled in a day wi..."}, {"kind": "fact", "at": d"2019-04-22T19:56:00.000Z", "text": "Like quasistatic pointed out, you hit that practical ceiling pretty fast once the rush settles down. Even if theatres want to run around the clock for a few days, employees need sleep, auditoriums ..."}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}]};
INSERT INTO post {"id": post:["endgame", 129], "thread": thread:endgame, "n": 129, "author": member:offbyone, "at": d"2019-04-28T14:27:00.000Z", "body": "Small correction: PostTrak recorded 62 percent of opening-weekend patrons purchasing advance tickets online, not simply 60 percent. That distinction matters. With over three-fifths of footfall front-loaded into pre-sales, Monday's audited returns must necessarily drop off sharply. A temporary surge in throughput never compensates for the lack of casual walk-up trade.", "quote": {"post": post:["endgame", 128], "text": "A temporary burst of throughput simply shifts the volume forward."}, "note": "I remain confident that the steep drop after the weekend will show Endgame cannot match Avatar's final total.", "state": {"position":"Endgame will not beat Avatar because clearing the pre-sale backlog over an unsustainable opening weekend guarantees a steep statistical drop once standard schedules resume.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"admires his consistent operational logic and emphasis on waiting for audited receipts"},{"member":"Sysop_Kev","feeling":"appreciates his acknowledgment of the accounting distinction between Thursday previews and Friday trade"},{"member":"TheyKnow","feeling":"pleased that he recognised the correct arithmetic"}],"commitments":["see the film in Rotterdam once the initial rush subsides"],"shift":"His conviction is reinforced by forum agreement that the opening numbers merely reflect front-loaded demand rather than lasting momentum."}, "recalled": [{"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "OffByOne: \"The issue is that the proposed resolution creates a very messy precedent.\""}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "fact", "at": d"2000-01-03T18:30:00.000Z", "text": "[quoting: \"Even when an odd glitch turns up - like those police breath-test units in Hong Kong this morning - the officers simply write the birth dates down in a notebook while the readings carry o..."}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T00:40:00.000Z", "from": post:["endgame", 4]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "forum", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "private", "at": d"2019-04-26T09:52:00.000Z", "from": post:["endgame", 99]}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}]};
INSERT INTO post {"id": post:["endgame", 130], "thread": thread:endgame, "n": 130, "author": member:sysop_kev, "at": d"2019-04-28T16:26:00.000Z", "body": "Two percent hardly rewrites the ledger, yer man. \n\nDisney are already calling 350 million domestic for the full weekend, which is staggering by any measure. Still, catching Avatar takes months of grind, not just one huge blowout. We will see what happens when the working week begins tomorrow.", "quote": {"post": post:["endgame", 129], "text": "Small correction: PostTrak recorded 62 percent of opening-weekend patrons purchasing advance tickets online, not simply 60 percent. That distinction matters."}, "note": "OffByOne is splitting hairs over two percent when the weekend total is hitting 350 million.", "state": {"position":"The opening figures are staggering, but whether it can actually challenge Avatar comes down to how ticket sales hold up once standard weekday business resumes tomorrow.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"acknowledges his accounting corrections but thinks he can be overly pedantic"},{"member":"Punchcard","feeling":"appreciates his grounded experience and sensible talk about ledgers and queues"},{"member":"TheyKnow","feeling":"views him as predictably chiming in to agree with the prevailing caution"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "kookaburra99's expectation is burning through pre-sales quickly guarantees a massive drop next week once ANZAC crowds clear out and casual moviegoers stay home"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "forum", "at": d"2019-04-27T15:02:00.000Z", "from": post:["endgame", 116]}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 131], "thread": thread:endgame, "n": 131, "author": member:offbyone, "at": d"2019-04-28T20:39:00.000Z", "body": "A margin of two percent across millions of admissions represents a substantial quantity of front-loaded receipts. The weekend estimate of 350 million dollars simply confirms how thoroughly the existing fan base was processed at once. Tomorrow, when standard office routines resume, that absent pool of remaining viewers will demonstrate why Avatar's final total remains unreachable.", "quote": NONE, "note": "Sysop_Kev continues to dismiss critical statistical margins while underestimating how sharply Monday's drop will undermine any real challenge to Avatar.", "state": {"position":"Endgame will fail to beat Avatar because exhausting over sixty percent of demand through front-loaded pre-sales guarantees a sharp statistical collapse once standard weekday schedules resume.","score":1,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"annoyed by his dismissal of precise statistical margins"},{"member":"Punchcard","feeling":"values his sound operational comparisons regarding throughput and backlogs"},{"member":"TheyKnow","feeling":"satisfied that he accepted the arithmetic correction"}],"commitments":["see the film in Rotterdam once the initial rush subsides"],"shift":"He is irritated by Sysop_Kev's disregard for accurate percentage data, while remaining completely confident that the statistical drop on Monday will derail any challenge to Avatar."}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is Monday's audited returns must necessarily drop off sharply due to over three-fifths front-loaded pre-sales, and temporary throughput surges do not compensate for lack of walk-..."}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "forum", "at": d"2000-01-01T16:34:00.000Z", "from": post:["y2k", 149]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "private", "at": d"2019-04-26T09:52:00.000Z", "from": post:["endgame", 99]}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 132], "thread": thread:endgame, "n": 132, "author": member:pintofmild, "at": d"2019-04-28T20:45:00.000Z", "body": "OffByOne has it spot on, a 1.2 billion opening is mad but that cliff edge is coming tomorrow.", "quote": NONE, "note": "I still reckon the steep drop starting tomorrow will leave Avatar's total well out of reach.", "state": {"position":"Endgame has pulled off a monster weekend by front-loading demand, but the drop-off starting Monday will keep it well short of catching Avatar.","score":1,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"pleased he enjoyed taking his grandson to the cinema"},{"member":"OffByOne","feeling":"finds his precise corrections and arithmetic convincing"},{"member":"Sysop_Kev","feeling":"respects his steady moderating and no-spoilers stance"}],"commitments":["waiting for Monday's verified figures","meeting anyone around for a pint","keeping strictly quiet about plot spoilers"]}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "private", "at": d"2019-04-27T17:06:00.000Z", "from": post:["endgame", 117]}, {"kind": "private", "at": d"2019-04-27T21:39:00.000Z", "from": post:["endgame", 119]}, {"kind": "private", "at": d"2019-04-27T22:32:00.000Z", "from": post:["endgame", 121]}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 133], "thread": thread:endgame, "n": 133, "author": member:sysop_kev, "at": d"2019-04-28T23:13:00.000Z", "body": "Over 1.2 billion globally in five days is ridiculous money, no matter which way you slice the percentages. Still, Punchcard has the right of it about the daily grind. Avatar was built on casual punters turning up week after week, so tomorrow's normal trade will show if it has legs or just burned through the lot.", "quote": NONE, "note": "We will see tomorrow whether the casual walk-up trade actually holds up or if it drops off a cliff.", "state": {"position":"The weekend figures are undeniably massive, but whether it can actually reach Avatar depends on whether casual ticket sales hold up once regular weekday routines kick in tomorrow.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"thinks he is nitpicking over tiny percentages that do not change the bigger picture"},{"member":"Punchcard","feeling":"respects his practical, steady perspective on throughput and daily business"},{"member":"TheyKnow","feeling":"sees him just echoing whatever caution the others put forward"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev's intention is waiting to see the actuator logs with his own eyes before calling the hardware sound"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "forum", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "fact", "at": d"2019-04-23T18:26:00.000Z", "text": "Mind you, OffByOne is completely spot on about borrowing patrons from the future. Once every eager fan like me gets shuffled through the turnstiles before breakfast this weekend, the tank is going ..."}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}]};
INSERT INTO post {"id": post:["endgame", 134], "thread": thread:endgame, "n": 134, "author": member:kookaburra99, "at": d"2019-04-29T09:00:00.000Z", "body": "sorry if this is dumb lol, but reckon the rush is over now everyone's back at work today!!", "quote": NONE, "note": "OffByOne and Punchcard explained the front-loading so well, there's no way Avatar's record gets beaten.", "state": {"position":"Endgame has merely processed its fanbase in a massive opening burst, so once ordinary weekday routines resume, attendance will drop sharply and Avatar's record will remain safe.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"thoroughly persuaded by his precise statistical breakdown of front-loaded sales"},{"member":"Punchcard","feeling":"appreciates his practical insight on throughput shifting volume forward"},{"member":"Sysop_Kev","feeling":"agrees with his point that overtaking Avatar requires months of steady grind"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "kookaburra99's status is newbie"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T05:22:00.000Z", "from": post:["y2k", 136]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}]};
INSERT INTO post {"id": post:["endgame", 135], "thread": thread:endgame, "n": 135, "author": member:offbyone, "at": d"2019-04-29T12:04:00.000Z", "body": "Strictly speaking, Russian cinemas only opened today, but general weekday returns will contract predictably without the pre-sale cushion.", "quote": NONE, "note": "I remain convinced that the standard weekday drop will prove Avatar's global record is safe.", "state": {"position":"Endgame will not beat Avatar because clearing the pre-sale backlog over the weekend guarantees a severe drop once standard weekday schedules resume.","score":1,"certainty":"high","towards":[{"member":"Sysop_Kev","feeling":"frustrated by his casual attitude toward statistical margins"},{"member":"Punchcard","feeling":"appreciates his focus on operational throughput and audited figures"},{"member":"PintOfMild","feeling":"pleased that he acknowledges the arithmetic"}],"commitments":["see the film in Rotterdam once the initial rush subsides"],"shift":"He feels further vindicated as other members acknowledge his arithmetic on front-loaded ticket sales."}, "recalled": [{"kind": "fact", "text": "Sysop_Kev: \"Sure look, we will see what the actual figures look like next week once the rush clears out.\""}, {"kind": "fact", "text": "Sysop_Kev's attitude is wait and see what the actual figures look like next week once the rush clears out"}, {"kind": "fact", "text": "TheyKnow's understanding is physical capacity constraints outweigh opening hype"}, {"kind": "fact", "text": "OffByOne's opinion is front-loaded receipts and an absent remaining viewer pool demonstrate that Avatar's final total remains unreachable"}, {"kind": "private", "text": "OffByOne: \"OffByOne's private note to self, Wed Dec 29, 1999 3:08 pm GMT: The card terminal glitch in Britain provides concrete proof that retail software errors do not cascade into industrial para..."}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-04-19T02:23:00.000Z", "text": "sorry if this is a dumb question, but do pre-sales actually mean normal people are going to see it multiple times, or is it just all of us superfans buying our seats at once?? lol! i completely agr..."}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "private", "at": d"2019-04-26T09:52:00.000Z", "from": post:["endgame", 99]}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}]};
INSERT INTO post {"id": post:["endgame", 136], "thread": thread:endgame, "n": 136, "author": member:punchcard, "at": d"2019-04-29T15:04:00.000Z", "body": "Quite so. Those Russian openings will provide a modest bump, but the real question is ordinary Monday trade everywhere else. Once the advance bookings are spent, we shall see if casual viewers are willing to sit through three hours on a school night. Let us wait for the audited weekday returns.", "quote": {"post": post:["endgame", 135], "text": "Strictly speaking, Russian cinemas only opened today, but general weekday returns will contract predictably without the pre-sale cushion."}, "note": "We will know soon enough whether the general public has any appetite for three hours on a weeknight.", "state": {"position":"The staggering opening figures clearly pulled massive demand forward through advance sales, but we must wait to see the audited weekday returns under normal schedules before judging if it has the stamina to reach Avatar.","score":2,"certainty":"medium","towards":[{"member":"Sysop_Kev","feeling":"pleased by his level-headed reminders and steady moderation"},{"member":"OffByOne","feeling":"tolerates his pedantic corrections while agreeing on the mechanics of the drop"},{"member":"TheyKnow","feeling":"reassured that he is sticking to common sense and waiting for ordinary weekday figures"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "kookaburra99's expectation is burning through pre-sales quickly guarantees a massive drop next week once ANZAC crowds clear out and casual moviegoers stay home"}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "fact", "at": d"1999-12-31T12:38:00.000Z", "text": "Attempting to dismiss these verified results by imagining hypothetical failures in rural substations is simply untenable. Primary electrical grids operate under continuous regional monitoring. A tr..."}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2001-12-29T18:20:00.000Z", "from": post:["euro", 32]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-22T22:49:00.000Z", "from": post:["endgame", 43]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 137], "thread": thread:endgame, "n": 137, "author": member:theyknow, "at": d"2019-04-29T17:22:00.000Z", "body": "Right you are, Punchcard... we will see if folks actually fancy three hours on a Monday evening.", "quote": NONE, "note": "I will wait for Monday's audited hold percentages to prove the cliff drop leaves Avatar safe.", "state": {"position":"The massive opening weekend was just a front-loaded surge that will drop off sharply as regular workdays resume, leaving Avatar safe.","score":1,"certainty":"high","towards":[{"member":"OffByOne","feeling":"values his precise breakdown of front-loaded presale percentages"},{"member":"Punchcard","feeling":"appreciates his practical operational wisdom on throughput vs steady demand"},{"member":"kookaburra99","feeling":"agrees with her sensible observation about people returning to work"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","wait for Monday's audited returns before judging box office legs"]}, "recalled": [{"kind": "fact", "text": "UK opening day's box office is 15.3 million dollars (roughly 11.8 million British pounds) according to trade reports"}, {"kind": "fact", "text": "TheyKnow's intention is wait for Monday's hold percentages to prove the cliff drop leaves Avatar completely safe"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 138], "thread": thread:endgame, "n": 138, "author": member:offbyone, "at": d"2019-04-29T20:58:00.000Z", "body": "The actual figures released earlier this evening confirmed a worldwide total of 1.222 billion dollars, which is certainly an immense volume of capital, but it does not alter the underlying mechanics of consumer behaviour. When a theatrical presentation requires three hours and one minute - excluding trailers and the clearing of aisles - an ordinary working person cannot casually integrate such an excursion into a Monday evening schedule. Avatar accumulated its total precisely because uncommitted patrons continued attending across many successive weeks. Once the passionate segment of the public has attended, the absence of casual walk-in traffic becomes immediately evident in the daily ledger. It is simply a matter of arithmetic. I expect the audited Monday returns will demonstrate a sharp downward correction as regular evening habits reassert themselves. I shall certainly wait for the auditoriums to empty before I book my own seat here in Rotterdam.", "quote": {"post": post:["endgame", 136], "text": "Once the advance bookings are spent, we shall see if casual viewers are willing to sit through three hours on a school night. Let us wait for the audited weekday returns."}, "note": "I remain convinced that Monday's audited returns will expose the lack of casual walk-up traffic needed to threaten Avatar.", "state": {"position":"Endgame will fail to catch Avatar as the standard weekday drop inevitably exposes the lack of sustained casual footfall.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"values his shared appreciation for audited metrics and operational realities"},{"member":"Sysop_Kev","feeling":"irritated by his dismissal of precise statistical margins"},{"member":"PintOfMild","feeling":"pleased that he grasps the impending steep decline in sales"}],"commitments":["see the film in Rotterdam once the initial rush subsides"]}, "recalled": [{"kind": "fact", "text": "Sysop_Kev: \"we have routine database table maintenance scheduled for Wednesday night around 2 am GMT, so expect about twenty minutes of downtime.\""}, {"kind": "fact", "text": "OffByOne: \"Nevertheless, kookaburra99 is correct that the sheer duration dictates the pacing of admissions.\""}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "OffByOne: \"The issue is that the proposed resolution creates a very messy precedent.\""}, {"kind": "forum", "at": d"1999-12-26T20:04:00.000Z", "from": post:["y2k", 12]}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2006-08-19T08:52:00.000Z", "from": post:["pluto", 55]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}, {"kind": "private", "at": d"2019-04-29T12:04:00.000Z", "from": post:["endgame", 135]}]};
INSERT INTO post {"id": post:["endgame", 139], "thread": thread:endgame, "n": 139, "author": member:sysop_kev, "at": d"2019-04-30T01:26:00.000Z", "body": "Audited Monday receipts will land tomorrow evening, so we'll see the hard facts soon enough without parsing every ticket stub.\n\nServer backup runs at 03:00 GMT tonight, site might hitch for five minutes.\n\nAnd mind the spoiler rule when you do finally go, lads.\n\n-- Kev (mod)", "quote": {"post": post:["endgame", 138], "text": "I expect the audited Monday returns will demonstrate a sharp downward correction as regular evening habits reassert themselves."}, "note": "We will have to see the actual Monday box office receipts before deciding if the weekday drop-off kills any shot at Avatar.", "state": {"position":"The massive opening proves nothing yet about passing Avatar, as we still need to see audited weekday numbers to know if ordinary viewers will keep turning up.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his steady focus on ordinary weekday trade"},{"member":"OffByOne","feeling":"finds his pedantic arithmetic tiresome even if he makes valid points"},{"member":"TheyKnow","feeling":"sees him just parroting others"}],"commitments":["enforce a strict no-spoilers rule on the thread"]}, "recalled": [{"kind": "fact", "text": "Punchcard's opinion is Russian openings will provide a modest bump, but the key question is ordinary Monday trade everywhere else and whether casual viewers will sit through three hours on a school..."}, {"kind": "fact", "text": "OffByOne's opinion is general weekday returns will contract predictably without the pre-sale cushion"}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "fact", "at": d"2019-04-19T00:40:00.000Z", "text": "Two point seven billion dollars is a formidable mountain to climb. Sustaining that over May and June is another matter entirely, particularly with a running time exceeding three hours. That will na..."}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-24T21:36:00.000Z", "from": post:["endgame", 76]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "fact", "at": d"2019-04-29T20:58:00.000Z", "text": "The actual figures released earlier this evening confirmed a worldwide total of 1.222 billion dollars, which is certainly an immense volume of capital, but it does not alter the underlying mechanic..."}]};
INSERT INTO post {"id": post:["endgame", 140], "thread": thread:endgame, "n": 140, "author": member:kookaburra99, "at": d"2019-04-30T02:50:00.000Z", "body": "totally agree, nobody has time for a three-hour marathon on school nights lol, avatar's record is totally safe!!", "quote": NONE, "note": "I'm sure OffByOne is right that casual moviegoers won't do three hours on a school night.", "state": {"position":"Avatar's record is completely safe because ordinary people won't sit through a three-hour film on school nights now that the initial fan rush is over.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"finds his arithmetic and logic on viewer habits totally convincing"},{"member":"Punchcard","feeling":"values his sensible perspective on weekday trade"},{"member":"Sysop_Kev","feeling":"appreciates his steady reminder to wait for the actual audited returns"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "kookaburra99's status is newbie"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "fact", "at": d"2000-01-03T09:20:00.000Z", "text": "We have already seen examples over the weekend, such as the temporary glitch with Amtrak's tracking software, where automated fallbacks and manual procedures ensured normal operations continued wit..."}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "fact", "at": d"2019-04-19T06:03:00.000Z", "text": "My nephew has booked tickets for us in Edinburgh for the following week, so I shall be doing my best to avoid the leaks in the meantime. I am curious to see the actual Comscore returns once the wee..."}, {"kind": "forum", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "fact", "at": d"2019-04-22T20:35:00.000Z", "text": "We must wait for the audited receipts and see how admissions hold up through May and June once this initial burst of demand clears out. Until those verified figures are tallied by the accountants, ..."}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}, {"kind": "fact", "at": d"2019-04-29T20:58:00.000Z", "text": "The actual figures released earlier this evening confirmed a worldwide total of 1.222 billion dollars, which is certainly an immense volume of capital, but it does not alter the underlying mechanic..."}]};
INSERT INTO post {"id": post:["endgame", 141], "thread": thread:endgame, "n": 141, "author": member:theyknow, "at": d"2019-04-30T03:41:00.000Z", "body": "That is the whole trick of it, folks... When you see the trade papers already spinning estimates of thirty-five million for a plain old Monday, ask yourself who benefits from keeping that balloon inflated! They want you to think the momentum is bottomless, but regular folks have shifts to work and bills to pay. A three-hour haul just does not fit into a working week, no matter how much HOLLYWOOD hypes the machine... Once those hard audited receipts get logged tomorrow, the real drop will show its face plain as day. Avatar is not losing any sleep yet! :)", "quote": NONE, "note": "They are floating thirty-five million Monday estimates just to keep the hype train rolling before the audited books drop.", "state": {"position":"Endgame's manufactured opening frenzy will inevitably collapse on regular weekdays, leaving Avatar's genuine record safe.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his steady patience in waiting for the audited weekday ledger"},{"member":"OffByOne","feeling":"admires his solid arithmetic on runtime and weekday consumer behaviour"},{"member":"kookaburra99","feeling":"appreciates her straightforward common sense regarding school night crowds"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","wait for Monday's audited returns before judging box office legs"]}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is safe from Avengers: Endgame box office record once initial queuing ends"}, {"kind": "fact", "text": "Punchcard's opinion is Russian openings will provide a modest bump, but the key question is ordinary Monday trade everywhere else and whether casual viewers will sit through three hours on a school..."}, {"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "forum", "at": d"2019-04-20T11:42:00.000Z", "from": post:["endgame", 20]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "fact", "at": d"2019-04-23T00:17:00.000Z", "text": "No business can keep running on three shifts indefinitely like that... staff get exhausted, projection bulbs run hot, and once Sunday night wraps up, those overnight crowds simply vanish into thin ..."}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "fact", "at": d"2019-04-25T12:51:00.000Z", "text": "around here in melbourne people are already chatting about how exhausted they felt yesterday just coordinating dinner, babysitters, and getting home after midnight on a school night! my kids loved ..."}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}]};
INSERT INTO post {"id": post:["endgame", 142], "thread": thread:endgame, "n": 142, "author": member:offbyone, "at": d"2019-04-30T05:04:00.000Z", "body": "Estimates issued by trade publications are merely standard industry projections, not a coordinated conspiracy to deceive the public. The domestic weekend total was officially finalised at 357.1 million dollars overnight, which is a matter of recorded ledger, not marketing spin. The physical duration of the feature remains the real operational ceiling for weekday admissions.", "quote": {"post": post:["endgame", 141], "text": "When you see the trade papers already spinning estimates of thirty-five million for a plain old Monday, ask yourself who benefits from keeping that balloon inflated!"}, "note": "TheyKnow continues to see deliberate manipulation where standard exhibition math explains everything.", "state": {"position":"Endgame will inevitably fall short of Avatar once audited Monday returns reflect the physical barrier of a three-hour runtime on casual weekday attendance.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his sound focus on audited receipts and scheduling constraints"},{"member":"Sysop_Kev","feeling":"mildly annoyed by his impatience with detailed statistical analysis"},{"member":"TheyKnow","feeling":"dismissive of his conspiratorial framing of standard box-office reporting"}],"commitments":["see the film in Rotterdam once the auditoriums empty out"]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is general weekday returns will contract predictably without the pre-sale cushion"}, {"kind": "fact", "text": "OffByOne's opinion is Monday's audited returns will expose the lack of casual walk-up traffic needed to threaten Avatar"}, {"kind": "fact", "text": "Punchcard's opinion is Russian openings will provide a modest bump, but the key question is ordinary Monday trade everywhere else and whether casual viewers will sit through three hours on a school..."}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "fact", "text": "OffByOne: \"The issue is that the proposed resolution creates a very messy precedent.\""}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}, {"kind": "private", "at": d"2019-04-29T12:04:00.000Z", "from": post:["endgame", 135]}]};
INSERT INTO post {"id": post:["endgame", 143], "thread": thread:endgame, "n": 143, "author": member:kookaburra99, "at": d"2019-04-30T05:15:00.000Z", "body": "sorry if this is a silly question, but how do they even track all those cinemas so fast?? 357 million is bonkers lol! but offbyone makes so much sense, once you factor in ads and trailers it is practically four hours out of your evening. no way casual folks do that mid-week!", "quote": {"post": post:["endgame", 142], "text": "The domestic weekend total was officially finalised at 357.1 million dollars overnight, which is a matter of recorded ledger, not marketing spin."}, "note": "OffByOne explains the theatre schedules and operational limits so clearly.", "state": {"position":"Avatar's record is completely safe because ordinary people simply do not have the time to sit through a three-hour film on a school night.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"finds his operational explanations and logic completely persuasive"},{"member":"TheyKnow","feeling":"notices he agrees on weekday fatigue but keeps spinning conspiracy nonsense"},{"member":"Sysop_Kev","feeling":"values his steady moderation and focus on the audited numbers"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is general weekday returns will contract predictably without the pre-sale cushion"}, {"kind": "fact", "text": "Disney's expectation is 350 million domestic for the full weekend"}, {"kind": "fact", "text": "Punchcard's opinion is Russian openings will provide a modest bump, but the key question is ordinary Monday trade everywhere else and whether casual viewers will sit through three hours on a school..."}, {"kind": "fact", "text": "kookaburra99's status is newbie"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07:21:00.000Z", "from": post:["y2k", 144]}, {"kind": "private", "at": d"2001-12-31T23:43:00.000Z", "from": post:["euro", 77]}, {"kind": "private", "at": d"2002-01-02T01:24:00.000Z", "from": post:["euro", 113]}, {"kind": "private", "at": d"2006-08-24T03:31:00.000Z", "from": post:["pluto", 85]}, {"kind": "private", "at": d"2012-08-02T06:52:00.000Z", "from": post:["curiosity", 13]}, {"kind": "private", "at": d"2012-08-07T06:24:00.000Z", "from": post:["curiosity", 115]}, {"kind": "forum", "at": d"2019-04-19T02:23:00.000Z", "from": post:["endgame", 6]}, {"kind": "private", "at": d"2019-04-19T05:51:00.000Z", "from": post:["endgame", 8]}, {"kind": "private", "at": d"2019-04-22T05:19:00.000Z", "from": post:["endgame", 34]}, {"kind": "forum", "at": d"2019-04-23T12:34:00.000Z", "from": post:["endgame", 57]}, {"kind": "forum", "at": d"2019-04-24T03:13:00.000Z", "from": post:["endgame", 66]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "fact", "at": d"2019-04-29T20:58:00.000Z", "text": "The actual figures released earlier this evening confirmed a worldwide total of 1.222 billion dollars, which is certainly an immense volume of capital, but it does not alter the underlying mechanic..."}]};
INSERT INTO post {"id": post:["endgame", 144], "thread": thread:endgame, "n": 144, "author": member:offbyone, "at": d"2019-04-30T06:05:00.000Z", "body": "Modern point-of-sale systems transmit box-office data directly to central clearinghouses like Rentrak each night, making reconciliation relatively swift. The four-hour commitment you mention is precisely why casual viewers will abstain during the working week. That logistical barrier ensures the total will plateau well before challenging Avatar.", "quote": NONE, "note": "I remain confident that normal weekday constraints will keep Avatar's record intact.", "state": {"position":"Endgame will fall short of Avatar once normal weekday drops reflect the severe constraint of a three-hour runtime on casual attendance.","score":1,"certainty":"high","towards":[{"member":"Punchcard","feeling":"respects his sound reliance on operational arithmetic and audited numbers"},{"member":"TheyKnow","feeling":"annoyed by his reflex to treat routine box-office estimates as Hollywood conspiracies"},{"member":"Sysop_Kev","feeling":"mildly dismissive of his impatience with precise analysis"}],"commitments":["see the film in Rotterdam once the auditoriums empty out"]}, "recalled": [{"kind": "fact", "text": "UK opening day's box office is 15.3 million dollars (roughly 11.8 million British pounds) according to trade reports"}, {"kind": "fact", "text": "IMAX's box office is $26.5 million from screens"}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"1999-12-27T13:43:00.000Z", "from": post:["y2k", 22]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-04-20T04:36:00.000Z", "text": "OffByOne and Punchcard put their fingers right on the real situation there... It is so easy to get dazzled by big shiny dollar amounts in the headlines, but high ticket prices and currency swings d..."}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "fact", "at": d"2019-04-25T16:11:00.000Z", "text": "The trade reports this afternoon indicate BookMyShow has now shifted some two and a half million advance tickets in India, with operators there also resorting to round-the-clock screenings to manag..."}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}, {"kind": "private", "at": d"2019-04-29T12:04:00.000Z", "from": post:["endgame", 135]}]};
INSERT INTO post {"id": post:["endgame", 145], "thread": thread:endgame, "n": 145, "author": member:pintofmild, "at": d"2019-04-30T10:19:00.000Z", "body": "Blimey, finalised at 357 million across the pond is astonishing, but OffByOne hits the nail on the head there. Once you add twenty minutes of ads and trailers to a three-hour film, you are looking at coming out well past eleven o'clock! When you have an early shift at the call centre next morning, that is simply a non-starter for anyone who isn't a massive comic book nut. All the superfans rushed out over the weekend, but ordinary walk-ins just won't bother on a Tuesday or Wednesday. Can't see it keeping the momentum up long enough to trouble Avatar at all. :)", "quote": NONE, "note": "I still reckon the sheer runtime on school nights means Endgame won't catch Avatar.", "state": {"position":"Endgame has had a massive opening weekend, but weekday reality and the three-hour runtime will cause a steep drop that leaves Avatar's record untouched.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"finds his straightforward arithmetic and common sense on weekday routines convincing"},{"member":"Punchcard","feeling":"values his steady advice to wait for the weekday receipts"},{"member":"TheyKnow","feeling":"amused by his usual conspiratorial spin on ordinary trade"}],"commitments":["waiting for Monday's verified figures","meeting anyone around for a pint","keeping strictly quiet about plot spoilers"]}, "recalled": [{"kind": "fact", "text": "Avatar's box office status is safe from Avengers: Endgame box office record once initial queuing ends"}, {"kind": "fact", "text": "PintOfMild's opinion is the steep drop starting tomorrow will leave Avatar's total well out of reach"}, {"kind": "fact", "text": "Punchcard's opinion is Russian openings will provide a modest bump, but the key question is ordinary Monday trade everywhere else and whether casual viewers will sit through three hours on a school..."}, {"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's expectation is that cliff edge is coming tomorrow"}, {"kind": "fact", "text": "PintOfMild's attitude is waiting for actuator and resolver logs before the software changeover"}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "private", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "forum", "at": d"2019-04-24T11:15:00.000Z", "from": post:["endgame", 71]}, {"kind": "private", "at": d"2019-04-27T17:06:00.000Z", "from": post:["endgame", 117]}, {"kind": "private", "at": d"2019-04-27T21:39:00.000Z", "from": post:["endgame", 119]}, {"kind": "private", "at": d"2019-04-27T22:32:00.000Z", "from": post:["endgame", 121]}]};
INSERT INTO post {"id": post:["endgame", 146], "thread": thread:endgame, "n": 146, "author": member:punchcard, "at": d"2019-04-30T14:07:00.000Z", "body": "It does not require any grand deception to explain why trade forecasts run high, nor does it mean the ledger is being manipulated. The bookkeepers down south simply produce estimates based on past patterns, and then the actual cleared receipts tell the real tale.\n\nThose early projections of thirty-odd million for Monday are interesting to read, but they remain projections until the actual settlement arrives. Setting aside four full hours after an honest day of work is a heavy ask for any working family. We shall have the audited figures soon enough, and that will give us the proper measure of casual trade.", "quote": NONE, "note": "TheyKnow continues to see dark plots in ordinary trade estimates that OffByOne rightly explains as basic data handling.", "state": {"position":"We must wait for the hard audited Monday and weekday receipts to arrive before drawing conclusions about whether casual attendance will hold up over a three-hour run time.","score":2,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"appreciates his rational, operational focus on runtime friction and data clearinghouses"},{"member":"TheyKnow","feeling":"mildly exasperated by his persistent habit of seeing conspiracies in ordinary trade estimates"},{"member":"Sysop_Kev","feeling":"pleased by his steady reminders to wait for the actual audited facts"}],"commitments":[]}, "recalled": [{"kind": "fact", "text": "OffByOne's opinion is three hours of film will deter the casual weeknight crowd"}, {"kind": "fact", "text": "Avengers: Endgame's opinion is physical duration remains the real operational ceiling for weekday admissions"}, {"kind": "fact", "text": "Punchcard's opinion is Russian openings will provide a modest bump, but the key question is ordinary Monday trade everywhere else and whether casual viewers will sit through three hours on a school..."}, {"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-04T17:55:00.000Z", "from": post:["curiosity", 35]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "forum", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}]};
INSERT INTO post {"id": post:["endgame", 147], "thread": thread:endgame, "n": 147, "author": member:sysop_kev, "at": d"2019-04-30T14:25:00.000Z", "body": "Punchcard has it right. Forecasts are just napkin math until the banks clear the ledgers. We will see if ordinary punters actually bothered queuing up on a Monday night once the hard receipts land. If they did, grand. If not, the ceiling will show itself fairly fast.", "quote": NONE, "note": "Waiting to see the audited Monday returns before making up my mind about the long run.", "state": {"position":"We still need to see the actual audited weekday receipts before deciding whether ordinary audiences will keep turning up to challenge Avatar.","score":2,"certainty":"medium","towards":[{"member":"Punchcard","feeling":"respects his steady, grounded view on waiting for cleared receipts"},{"member":"TheyKnow","feeling":"thinks he is seeing conspiracies where there is just standard business"},{"member":"OffByOne","feeling":"appreciates his factual corrections to conspiracy talk, even if he over-analyzes"}],"commitments":["enforce a strict no-spoilers rule on the thread","run server backup at 03:00 GMT"]}, "recalled": [{"kind": "fact", "text": "kookaburra99: \"monday's numbers will definitely show the real story.\""}, {"kind": "fact", "text": "Sysop_Kev: \"we have routine database table maintenance scheduled for Wednesday night around 2 am GMT, so expect about twenty minutes of downtime.\""}, {"kind": "private", "at": d"1999-12-26T16:09:00.000Z", "from": post:["y2k", 10]}, {"kind": "forum", "at": d"1999-12-28T10:56:00.000Z", "from": post:["y2k", 33]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T01:26:00.000Z", "from": post:["y2k", 128]}, {"kind": "fact", "at": d"2000-01-02T07:16:00.000Z", "text": "What remains for tomorrow is not a structural emergency, but ordinary clerical reconciliation. When administrative staff arrive at their offices, they may well encounter isolated formatting quirks,..."}, {"kind": "private", "at": d"2002-01-01T16:25:00.000Z", "from": post:["euro", 107]}, {"kind": "fact", "at": d"2002-01-02T10:10:00.000Z", "text": "Industrial action and localized coin pinches will create isolated queues, certainly. However, the automated networks have already demonstrated their capacity to move high volumes of currency withou..."}, {"kind": "private", "at": d"2002-01-03T00:20:00.000Z", "from": post:["euro", 129]}, {"kind": "private", "at": d"2006-08-15T19:12:00.000Z", "from": post:["pluto", 11]}, {"kind": "private", "at": d"2006-08-27T13:55:00.000Z", "from": post:["pluto", 162]}, {"kind": "forum", "at": d"2019-04-19T00:29:00.000Z", "from": post:["endgame", 3]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-20T11:42:00.000Z", "text": "Audited receipts are the only honest measure we have, my friend... You can already see how the numbers get pumped up early on when you look at the news from overseas this morning. Over in China, pr..."}, {"kind": "private", "at": d"2019-04-21T19:14:00.000Z", "from": post:["endgame", 30]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-23T12:34:00.000Z", "from": post:["endgame", 57]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "private", "at": d"2019-04-25T01:13:00.000Z", "from": post:["endgame", 80]}]};
INSERT INTO post {"id": post:["endgame", 148], "thread": thread:endgame, "n": 148, "author": member:quasistatic, "at": d"2019-04-30T19:00:00.000Z", "body": "The reported figures for Monday have now begun to filter through, and they warrant careful examination. According to trade reporting this afternoon, the domestic take reached $36.7 million on Monday. That places the global cumulative total at roughly $1.34 billion across its first six days.\n\nWhile that is undeniably a formidable sum for a non-holiday weekday, we ought to maintain our focus on the fundamental arithmetic rather than immediate hyperbole. Two observations are worth keeping in mind:\n\n1. A portion of that Monday gross inevitably represents deferred spillover from patrons who found weekend sessions entirely sold out, rather than newly converted casual viewers.\n\n2. The structural barrier discussed above remains fully intact. A three-hour running time - expanding to nearly four hours once adverts, previews, and seating are accounted for - remains an enormous hurdle for ordinary working households on a Tuesday or Wednesday evening.\n\nAvatar achieved its unprecedented endurance because uncommitted patrons trickled in steadily for months on end. Clearing early demand at extraordinary speed is quite distinct from sustaining broad public appeal into early summer. Let us see how the numbers settle once the initial rush is truly exhausted.", "quote": NONE, "note": "A $36.7 million Monday is remarkably resilient, but the sheer length of the film will still cap casual attendance once spillover demand clears.", "state": {"position":"Endgame is unlikely to beat Avatar because the heavy four-hour time commitment will keep casual audiences away on standard work nights once opening rush demand is cleared.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"respects his precise, empirical focus on operational logistics over conspiratorial thinking"},{"member":"TheyKnow","feeling":"weary of his reflex to turn routine industry estimates into dark conspiracies"},{"member":"Punchcard","feeling":"values his grounded common sense regarding the difference between forecasts and settled ledgers"}],"commitments":["seeing the film in Edinburgh with her nephew next week","waiting for the audited weekday receipts"]}, "recalled": [{"kind": "fact", "text": "quasistatic: \"We should inspect the actual wording of the redraft before making dramatic claims.\""}, {"kind": "private", "at": d"1999-12-27T15:33:00.000Z", "from": post:["y2k", 24]}, {"kind": "private", "at": d"1999-12-30T09:43:00.000Z", "from": post:["y2k", 50]}, {"kind": "private", "at": d"2000-01-01T18:14:00.000Z", "from": post:["y2k", 151]}, {"kind": "private", "at": d"2000-01-01T20:12:00.000Z", "from": post:["y2k", 157]}, {"kind": "private", "at": d"2000-01-02T07:16:00.000Z", "from": post:["y2k", 164]}, {"kind": "private", "at": d"2001-12-30T09:54:00.000Z", "from": post:["euro", 40]}, {"kind": "private", "at": d"2002-01-01T12:05:00.000Z", "from": post:["euro", 99]}, {"kind": "private", "at": d"2012-08-06T05:54:00.000Z", "from": post:["curiosity", 82]}, {"kind": "private", "at": d"2012-08-06T15:28:00.000Z", "from": post:["curiosity", 107]}, {"kind": "forum", "at": d"2019-04-19T06:03:00.000Z", "from": post:["endgame", 9]}, {"kind": "forum", "at": d"2019-04-22T06:20:00.000Z", "from": post:["endgame", 36]}, {"kind": "forum", "at": d"2019-04-22T17:29:00.000Z", "from": post:["endgame", 39]}, {"kind": "forum", "at": d"2019-04-22T20:35:00.000Z", "from": post:["endgame", 42]}, {"kind": "forum", "at": d"2019-04-25T07:51:00.000Z", "from": post:["endgame", 84]}, {"kind": "fact", "at": d"2019-04-26T04:57:00.000Z", "text": "Once people go back to their regular routines on Monday, nobody has four spare hours on a work night to go sit through a three-hour marathon. You simply cannot maintain that kind of traffic without..."}, {"kind": "forum", "at": d"2019-04-26T17:25:00.000Z", "from": post:["endgame", 103]}, {"kind": "fact", "at": d"2019-04-26T22:57:00.000Z", "text": "The true test begins once the regular punters have to decide if they fancy sitting in a dark room for over three hours on a Tuesday night after work. I loved it to bits, but asking folk to surrende..."}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}]};
INSERT INTO post {"id": post:["endgame", 149], "thread": thread:endgame, "n": 149, "author": member:pintofmild, "at": d"2019-04-30T21:44:00.000Z", "body": "That spillover idea from quasistatic makes total sense to me! If you could not bag a seat on Saturday, Monday was your first crack at it. Still reckon once that backlog clears out, the drop will be huge. Avatar is miles away yet.", "quote": NONE, "note": "I still reckon the post-weekend spillover is just die-hards who missed out on opening weekend tickets.", "state": {"position":"Endgame's weekend and early figures are huge, but the three-hour runtime makes weekday evening trips a non-starter for ordinary punters, so it won't keep up the legs needed to beat Avatar.","score":1,"certainty":"medium","towards":[{"member":"OffByOne","feeling":"thinks he hits the nail on the head regarding the four-hour cinema commitment on work nights"},{"member":"Punchcard","feeling":"respects his steady patience to wait for cleared ledgers over estimates"},{"member":"TheyKnow","feeling":"amused by his constant talk of Hollywood conspiracies and hype"}],"commitments":["waiting for verified figures","meeting anyone around for a pint","keeping strictly quiet about plot spoilers"],"shift":"He has reinforced his belief that the long runtime will shut out casual weekday cinema-goers after chiming in on the thread."}, "recalled": [{"kind": "fact", "text": "PintOfMild's opinion is TheyKnow is still making mountains out of tiny till errors when the rollout is basically done"}, {"kind": "fact", "text": "PintOfMild's expectation is that cliff edge is coming tomorrow"}, {"kind": "private", "at": d"2000-01-05T11:32:00.000Z", "from": post:["y2k", 178]}, {"kind": "private", "at": d"2001-12-31T11:07:00.000Z", "from": post:["euro", 56]}, {"kind": "private", "at": d"2001-12-31T23:17:00.000Z", "from": post:["euro", 72]}, {"kind": "private", "at": d"2002-01-01T12:48:00.000Z", "from": post:["euro", 100]}, {"kind": "private", "at": d"2012-08-04T21:09:00.000Z", "from": post:["curiosity", 38]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "private", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-18T19:25:00.000Z", "from": post:["endgame", 1]}, {"kind": "forum", "at": d"2019-04-19T11:18:00.000Z", "from": post:["endgame", 11]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "private", "at": d"2019-04-27T17:06:00.000Z", "from": post:["endgame", 117]}, {"kind": "private", "at": d"2019-04-27T21:39:00.000Z", "from": post:["endgame", 119]}, {"kind": "private", "at": d"2019-04-27T22:32:00.000Z", "from": post:["endgame", 121]}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}, {"kind": "fact", "at": d"2019-04-29T20:58:00.000Z", "text": "The actual figures released earlier this evening confirmed a worldwide total of 1.222 billion dollars, which is certainly an immense volume of capital, but it does not alter the underlying mechanic..."}, {"kind": "fact", "at": d"2019-04-30T19:00:00.000Z", "text": "1. A portion of that Monday gross inevitably represents deferred spillover from patrons who found weekend sessions entirely sold out, rather than newly converted casual viewers. 2. The structural b..."}]};
INSERT INTO post {"id": post:["endgame", 150], "thread": thread:endgame, "n": 150, "author": member:punchcard, "at": d"2019-05-01T01:49:00.000Z", "body": "The actual settlement of thirty-six million for Monday is certainly a healthy return, but quasistatic puts his finger right on the crux of the matter.\n\nWhen a release sells out an entire weekend, a great many eager patrons simply take the next available chair on Monday evening. That is deferred business, not necessarily fresh footfall from the wider public.\n\nA working week is five days long, not one. We will get a much clearer picture of whether ordinary folks are genuinely turning out once Tuesday and Wednesday pass through the books. There is no need to jump to conclusions until the dust settles.", "quote": NONE, "note": "Quasistatic has correctly identified the Monday number as weekend overflow rather than spontaneous interest.", "state": {"position":"While Monday's numbers are large, they likely reflect spillover demand rather than casual walk-ins, so we must wait to see how attendance holds up across normal working days.","score":2,"certainty":"medium","towards":[{"member":"quasistatic","feeling":"respects his calm, reasoned assessment of weekday spillover versus genuine longevity"},{"member":"Sysop_Kev","feeling":"appreciates his steady focus on cleared ledgers rather than speculation"},{"member":"TheyKnow","feeling":"weary of his constant inclination to suspect trade conspiracies"}],"commitments":[],"shift":"He notes Monday's substantial figures but views them through quasistatic's explanation of weekend spillover rather than a sign of lasting casual appeal."}, "recalled": [{"kind": "private", "at": d"1999-12-26T15:23:00.000Z", "from": post:["y2k", 7]}, {"kind": "forum", "at": d"1999-12-30T21:24:00.000Z", "from": post:["y2k", 63]}, {"kind": "private", "at": d"2000-01-01T02:11:00.000Z", "from": post:["y2k", 130]}, {"kind": "private", "at": d"2000-01-01T07:29:00.000Z", "from": post:["y2k", 145]}, {"kind": "private", "at": d"2001-12-31T23:50:00.000Z", "from": post:["euro", 79]}, {"kind": "private", "at": d"2006-08-24T21:18:00.000Z", "from": post:["pluto", 123]}, {"kind": "private", "at": d"2012-08-04T17:55:00.000Z", "from": post:["curiosity", 35]}, {"kind": "private", "at": d"2012-08-05T14:39:00.000Z", "from": post:["curiosity", 48]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "private", "at": d"2019-04-18T23:29:00.000Z", "from": post:["endgame", 2]}, {"kind": "forum", "at": d"2019-04-21T16:33:00.000Z", "from": post:["endgame", 29]}, {"kind": "forum", "at": d"2019-04-23T23:26:00.000Z", "from": post:["endgame", 64]}, {"kind": "fact", "at": d"2019-04-24T21:36:00.000Z", "text": "Avatar could sustain modest theatre occupancies over months because it slotted easily into standard evening slots and drew people who were completely unbothered by continuity. Endgame is consuming ..."}, {"kind": "private", "at": d"2019-04-24T23:29:00.000Z", "from": post:["endgame", 77]}, {"kind": "fact", "at": d"2019-04-25T06:11:00.000Z", "text": "What we are seeing across the early markets is simply extreme compression. When a release schedules screenings across twenty-four hours to satisfy months of pre-orders, it rapidly depletes the fini..."}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}]};
INSERT INTO post {"id": post:["endgame", 151], "thread": thread:endgame, "n": 151, "author": member:theyknow, "at": d"2019-05-01T02:04:00.000Z", "body": "That deferred spillover is a very sharp point, folks... When every screen is booked solid from Friday to Sunday, people who could not squeeze in have no choice but to push their plans into Monday night. That is just clearing out the weekend line, plain and simple, rather than new walk-ups deciding on a whim to catch a flick. With a three-hour run, regular folks are not going to keep hauling themselves to the cinema late on a school night once that initial backlog empties out... The numbers will tell the true tale by Thursday.", "quote": NONE, "note": "quasistatic nailed it on the deferred spillover, and the weekday numbers will show the collapse soon enough.", "state": {"position":"Monday's high gross is merely deferred spillover from sold-out weekend screenings, and the runtime barrier means weekday demand will collapse well short of Avatar.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"appreciates his sharp analysis of deferred spillover demand"},{"member":"Punchcard","feeling":"values his steady patience in waiting for the full weekday ledger"},{"member":"OffByOne","feeling":"agrees with his calculations on the practical runtime ceiling"}],"commitments":["taking nephew to see Endgame in Edinburgh next week","wait until auditoriums return to sensible capacity in Rotterdam before going"],"shift":"Interprets Monday's massive box-office gross as mere deferred spillover from initial weekend sellouts rather than genuine casual interest."}, "recalled": [{"kind": "fact", "text": "TheyKnow's attitude is quite content to sit back, let telemetry trickle in, and wait for raw current draws rather than getting ahead of data"}, {"kind": "fact", "text": "TheyKnow's attitude is holding breath until motor logs are verified"}, {"kind": "private", "at": d"1999-12-26T12:19:00.000Z", "from": post:["y2k", 2]}, {"kind": "private", "at": d"1999-12-26T15:21:00.000Z", "from": post:["y2k", 6]}, {"kind": "private", "at": d"1999-12-27T01:08:00.000Z", "from": post:["y2k", 16]}, {"kind": "private", "at": d"2000-01-01T04:18:00.000Z", "from": post:["y2k", 133]}, {"kind": "private", "at": d"2000-01-03T12:54:00.000Z", "from": post:["y2k", 174]}, {"kind": "private", "at": d"2001-12-27T19:47:00.000Z", "from": post:["euro", 7]}, {"kind": "private", "at": d"2006-08-21T22:01:00.000Z", "from": post:["pluto", 67]}, {"kind": "private", "at": d"2012-08-07T11:36:00.000Z", "from": post:["curiosity", 119]}, {"kind": "fact", "at": d"2019-01-01T00:00:00.000Z", "text": "United States's box office growth is 17% behind last year"}, {"kind": "forum", "at": d"2019-04-19T01:32:00.000Z", "from": post:["endgame", 5]}, {"kind": "forum", "at": d"2019-04-20T04:36:00.000Z", "from": post:["endgame", 16]}, {"kind": "private", "at": d"2019-04-22T03:26:00.000Z", "from": post:["endgame", 33]}, {"kind": "forum", "at": d"2019-04-25T18:00:00.000Z", "from": post:["endgame", 90]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "fact", "at": d"2019-04-27T23:41:00.000Z", "text": "As quasistatic noted, satisfying sixty percent of your audience through advance sales means an enormous amount of early demand is being cleared off the books immediately. When theatres return to st..."}, {"kind": "fact", "at": d"2019-04-29T20:58:00.000Z", "text": "The actual figures released earlier this evening confirmed a worldwide total of 1.222 billion dollars, which is certainly an immense volume of capital, but it does not alter the underlying mechanic..."}, {"kind": "fact", "at": d"2019-04-30T19:00:00.000Z", "text": "1. A portion of that Monday gross inevitably represents deferred spillover from patrons who found weekend sessions entirely sold out, rather than newly converted casual viewers. 2. The structural b..."}]};
INSERT INTO post {"id": post:["endgame", 152], "thread": thread:endgame, "n": 152, "author": member:offbyone, "at": d"2019-05-01T05:26:00.000Z", "body": "The analysis regarding deferred spillover is entirely sound. Monday absorbed the remaining backlog of pre-existing demand from sold-out weekend screenings. Now that those committed patrons have been accommodated, the steep drop across Tuesday and Wednesday will reveal the true extent of casual indifference.", "quote": NONE, "note": "quasistatic's deferred spillover analysis accurately explains Monday's volume before the inevitable weekday decline.", "state": {"position":"Endgame will still fall well short of Avatar once deferred weekend spillover clears and the runtime barrier deters casual weekday cinemagoers.","score":1,"certainty":"high","towards":[{"member":"quasistatic","feeling":"respects his sound arithmetic and sharp identification of deferred spillover"},{"member":"Punchcard","feeling":"appreciates his disciplined focus on audited clearinghouse receipts"},{"member":"TheyKnow","feeling":"patiently corrects his conspiracy mindset with operational facts"}],"commitments":["see the film in Rotterdam once the auditoriums empty out"]}, "recalled": [{"kind": "fact", "text": "TheyKnow's opinion is Avengers: Endgame momentum will show a drop once audited figures are logged because regular working folks cannot easily fit a three-hour film into a work week, and Avatar's bo..."}, {"kind": "fact", "text": "Avengers: Endgame's opinion is physical duration remains the real operational ceiling for weekday admissions"}, {"kind": "fact", "text": "OffByOne's opinion is confident that normal weekday constraints will keep Avatar's record intact"}, {"kind": "fact", "text": "OffByOne's attitude is cautious perspective remains the sensible approach until subsystem reports and instrument readouts are released in full"}, {"kind": "private", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "forum", "at": d"1999-12-27T06:50:00.000Z", "from": post:["y2k", 18]}, {"kind": "private", "at": d"2000-01-02T10:11:00.000Z", "from": post:["y2k", 166]}, {"kind": "private", "at": d"2001-12-31T22:22:00.000Z", "from": post:["euro", 67]}, {"kind": "private", "at": d"2002-01-03T20:11:00.000Z", "from": post:["euro", 141]}, {"kind": "private", "at": d"2002-01-04T09:09:00.000Z", "from": post:["euro", 150]}, {"kind": "private", "at": d"2012-08-07T14:14:00.000Z", "from": post:["curiosity", 121]}, {"kind": "fact", "at": d"2019-04-24T02:09:00.000Z", "text": "Those first reviews hitting ninety-eight percent today might help grease the wheels for this weekend, sure, but glowing press never paid for a seat on week three. Out in the real world, folks have ..."}, {"kind": "private", "at": d"2019-04-25T06:11:00.000Z", "from": post:["endgame", 83]}, {"kind": "private", "at": d"2019-04-25T20:50:00.000Z", "from": post:["endgame", 91]}, {"kind": "fact", "at": d"2019-04-26T08:24:00.000Z", "text": "That said, the international returns of $169 million on day one simply reflect the same front-loading we saw in the domestic presales. Meeting unprecedented demand across Korea, Australia, and Chin..."}, {"kind": "fact", "at": d"2019-04-26T09:52:00.000Z", "text": "When a film relies almost entirely on advance bookings, exhibitors clear the vast majority of their customer base during the opening seventy-two hours. Once that committed audience has attended, th..."}, {"kind": "private", "at": d"2019-04-27T05:30:00.000Z", "from": post:["endgame", 112]}, {"kind": "fact", "at": d"2019-04-27T06:47:00.000Z", "text": "When those artificial time-slots disappear and the pre-booked enthusiasts return home, daily capacity will decline sharply. A film requires broad, sustained general interest across months to approa..."}, {"kind": "private", "at": d"2019-04-27T06:47:00.000Z", "from": post:["endgame", 114]}, {"kind": "private", "at": d"2019-04-29T12:04:00.000Z", "from": post:["endgame", 135]}]};
INSERT INTO post {"id": post:["endgame", 153], "thread": thread:endgame, "n": 153, "author": member:kookaburra99, "at": d"2019-05-01T14:21:00.000Z", "body": "that explanation of spillover cleared it up completely for me. everyone who missed out on the weekend just grabbed tickets for monday instead! now that backlog is gone, no way busy families keep turning up late mid-week. avatar is definitely safe.", "quote": {"post": post:["endgame", 152], "text": "Monday absorbed the remaining backlog of pre-existing demand from sold-out weekend screenings."}, "note": "quasistatic and OffByOne made it completely obvious that Monday was just leftover weekend tickets, so Avatar has nothing to worry about.", "state": {"position":"Avatar's record remains completely safe because Monday's high numbers were just weekend spillover, and ordinary families cannot commit to four hours on a weeknight.","score":0,"certainty":"high","towards":[{"member":"OffByOne","feeling":"deeply convinced by his clear explanations of tracking systems and audience drop-offs"},{"member":"quasistatic","feeling":"finds his explanation of deferred Monday spillover brilliant and clarifying"},{"member":"TheyKnow","feeling":"pleased he sees the common sense of the weekday runtime problem"}],"commitments":[],"shift":"Her confidence that Avatar is safe has solidified further after quasistatic and OffByOne clearly explained Monday's big gross as deferred weekend spillover."}, "recalled": [{"kind": "fact", "text": "kookaburra99's expectation is burning through pre-sales quickly guarantees a massive drop next week once ANZAC crowds clear out and casual moviegoers stay home"}, {"kind": "fact", "text": "kookaburra99's status is newbie"}, {"kind": "private", "at": d"1999-12-27T08:07:00.000Z", "from": post:["y2k", 19]}, {"kind": "forum", "at": d"1999-12-31T03:16:00.000Z", "from": post:["y2k", 73]}, {"kind": "private", "at": d"2000-01-01T00:01:00.000Z", "from": post:["y2k", 120]}, {"kind": "private", "at": d"2000-01-01T07: