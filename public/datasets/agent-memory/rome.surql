-- Rome, 753 BC to AD 1453: SurrealDB Agent Memory showcase
-- What the SurrealDB Agent Memory API returned for this demo, as entities, attributes
-- and relations: GET /entities, GET /entities/{type}/{name}, and the value histories
-- from GET /entities/{type}/{name}/history/{key}, so a ruler or controller a later fact
-- replaced carries `validUntil`. It is the API's response shape, not the data Agent
-- Memory holds internally. Relations are written as graph edges.
--
-- Dates use the demo's own clock: AD year = year - 753, so year 1 is 753 BC and
-- year 754 is AD 1. Each fact also carries a label such as `year=753 BC`.
--
-- The facts were extracted from Wikipedia's year pages, which are available under
-- CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/).

OPTION IMPORT;

DEFINE TABLE entity SCHEMALESS;
DEFINE TABLE attribute SCHEMALESS;
DEFINE TABLE relation TYPE RELATION FROM entity TO entity SCHEMALESS;
DEFINE INDEX attribute_entity ON attribute FIELDS entity;
DEFINE INDEX attribute_key ON attribute FIELDS key;

