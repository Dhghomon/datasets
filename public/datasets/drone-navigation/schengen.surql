-- Drone navigation without GPS: SurrealDB vector and geospatial demo
-- A 6 x 6 km square around the point where France, Germany and Luxembourg meet, near
-- Schengen. Used by the tutorial "Navigate a drone without GPS" in the SurrealDB docs.
--
-- tile     One record per 200 x 200 m square of aerial imagery, a centre every 100 m,
--          for two seasons ('current' and 'old'). embedding holds 384 numbers: the
--          averaged patch features of DINOv2 (small), normalised, to 3 decimals.
-- country  The border of France, Germany and Luxembourg inside the area. The Moselle
--          north of the meeting point is held jointly by Germany and Luxembourg and is
--          in neither polygon.
-- zone     zone:no_fly, Luxembourg's border moved outwards by 150 m.
-- place    The launch point, the waypoint and the destination of the simulated flight.
-- photo    The photos the simulated drone took, one every 10 seconds, embedded the same
--          way as the tiles. prior is where dead reckoning put the drone when the photo
--          was taken, and truth is where it was.
--
-- Imagery: IGN (France), LVGL Saarland (Germany) and ACT geoportail.lu (Luxembourg), from
-- their open web map services. Borders: municipal boundaries from OpenStreetMap,
-- (c) OpenStreetMap contributors, available under the Open Database License
-- (https://www.openstreetmap.org/copyright).

OPTION IMPORT;

DEFINE TABLE tile SCHEMAFULL;
DEFINE FIELD centre ON tile TYPE geometry<point>;
DEFINE FIELD country ON tile TYPE string;
DEFINE FIELD season ON tile TYPE string;
DEFINE FIELD embedding ON tile TYPE array<float>;
DEFINE INDEX tile_embedding ON tile FIELDS embedding HNSW DIMENSION 384 DIST COSINE;

DEFINE TABLE country SCHEMAFULL;
DEFINE FIELD area ON country TYPE geometry<polygon | multipolygon>;

DEFINE TABLE zone SCHEMAFULL;
DEFINE FIELD area ON zone TYPE geometry<polygon | multipolygon>;
DEFINE FIELD reason ON zone TYPE string;

DEFINE TABLE place SCHEMAFULL;
DEFINE FIELD at ON place TYPE geometry<point>;

DEFINE TABLE photo SCHEMAFULL;
DEFINE FIELD embedding ON photo TYPE array<float>;
DEFINE FIELD prior ON photo TYPE geometry<point>;
DEFINE FIELD truth ON photo TYPE geometry<point>;

